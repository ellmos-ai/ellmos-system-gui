{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenOcean",
  "version": "0.2.40",
  "identifier": "ai.ellmos.system-gui.desktop",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": [
        "local-connection"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ellmos-ai/ellmos-system-gui/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "ellmos-ai",
    "category": "Productivity",
    "license": "MIT",
    "homepage": "https://github.com/ellmos-ai/ellmos-system-gui",
    "shortDescription": "Desktop connection to OpenOcean (BACH)",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
