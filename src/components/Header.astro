---
// Header.astro - Shared shell and route navigation for BACH & OCEAN
import navConfig from "../config/nav_config.json";

interface Props {
  currentPath?: string;
  currentSearch?: string;
}

const { currentPath = "/", currentSearch = "" } = Astro.props;
const defaultPreset = navConfig.default_preset || "standard";
const presetEntries = Object.entries(navConfig.presets || {});

function matchesNavigationHref(href: string, pathname: string, search: string) {
  if (!href || href === "#") return false;
  const origin = "https://gui.invalid";
  const target = new URL(href, origin);
  const current = new URL(pathname || "/", origin);
  if (search && !current.search) current.search = search;
  const normalizePath = (value: string) => value.replace(/\/+$/, "") || "/";
  const querySignature = (value: string) => [...new URLSearchParams(value).entries()]
    .sort(([leftKey, leftValue], [rightKey, rightValue]) => leftKey.localeCompare(rightKey) || leftValue.localeCompare(rightValue))
    .map(([key, entry]) => `${encodeURIComponent(key)}=${encodeURIComponent(entry)}`)
    .join("&");
  return target.origin === origin
    && normalizePath(target.pathname) === normalizePath(current.pathname)
    && querySignature(target.search) === querySignature(current.search);
}

function isActive(href: string) {
  return matchesNavigationHref(href, currentPath, currentSearch);
}

function hasActiveItem(item: any): boolean {
  return Boolean(item.href && isActive(item.href))
    || Boolean(item.children?.some((child: any) => hasActiveItem(child)));
}

function hasActiveSection(section: any): boolean {
  return Boolean(section.items?.some((item: any) => hasActiveItem(item)));
}

const LINE_ICON_SVGS: Record<string, string> = {
  start: '<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5.5v-6h-5v6H4a1 1 0 0 1-1-1z"/>',
  dashboard: '<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5.5v-6h-5v6H4a1 1 0 0 1-1-1z"/>',
  chat: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  tasks: '<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V2h6v2M9 10h6M9 14h6M9 18h4"/>',
  messages: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  "living-running": '<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>',
  routines: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  library: '<path d="M2 4h7a3 3 0 0 1 3 3v13a2 2 0 0 0-2-2H2zM22 4h-7a3 3 0 0 0-3 3v13a2 2 0 0 1 2-2h8z"/>',
  "agent-library": '<rect x="4" y="7" width="16" height="12" rx="2"/><path d="M12 3v4M9 12h.01M15 12h.01M9 16h6"/>',
  agents: '<rect x="4" y="7" width="16" height="12" rx="2"/><path d="M12 3v4M9 12h.01M15 12h.01M9 16h6"/>',
  "prompt-agents": '<path d="M12 3a5 5 0 0 1 5 5v2a5 5 0 0 1-10 0V8a5 5 0 0 1 5-5zM5 10a7 7 0 0 0 14 0M12 17v4M8 21h8"/>',
  chains: '<path d="M10 13a5 5 0 0 0 7.07 0l2.83-2.83a5 5 0 0 0-7.07-7.07L11 4.93M14 11a5 5 0 0 0-7.07 0L4.1 13.83a5 5 0 0 0 7.07 7.07L13 19.07"/>',
  "skill-keeper": '<circle cx="12" cy="12" r="9"/><polygon points="15.5 8.5 13.5 13.5 8.5 15.5 10.5 10.5 15.5 8.5"/>',
  "skills-software": '<path d="M9 2v5M15 2v5M6 7h12v4a6 6 0 0 1-12 0zM12 17v5"/>',
  "ocean-modules": '<path d="M2 9c2-2 4-2 6 0s4 2 6 0 4-2 6 0M2 15c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/>',
  plugins: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>',
  "other-domains": '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>',
  mcp: '<path d="M9 2v5M15 2v5M6 7h12v4a6 6 0 0 1-12 0zM12 17v5"/>',
  software: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>',
  systems: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>',
  "find-tools": '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  "profile-prompts": '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/>',
  artifacts: '<path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21v-8H7v8M7 3v5h8"/>',
  services: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.93 4.93l2.12 2.12M16.95 16.95l2.12 2.12M2 12h3M19 12h3M4.93 19.07l2.12-2.12M16.95 7.05l2.12-2.12"/>',
  settings: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.93 4.93l2.12 2.12M16.95 16.95l2.12 2.12M2 12h3M19 12h3M4.93 19.07l2.12-2.12M16.95 7.05l2.12-2.12"/>',
  system: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.93 4.93l2.12 2.12M16.95 16.95l2.12 2.12M2 12h3M19 12h3M4.93 19.07l2.12-2.12M16.95 7.05l2.12-2.12"/>',
  maintenance: '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L4 17v3h3l5.3-5.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2-2z"/>',
  quality: '<circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.5 2.5 4.5-5"/>',
  "models-resources": '<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 12 12 17 22 12"/><polyline points="2 17 12 22 22 17"/>',
  memory: '<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 12 12 17 22 12"/><polyline points="2 17 12 22 22 17"/>',
  "governance-control": '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  governance: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  authority: '<circle cx="8" cy="15" r="4"/><path d="m10.85 12.15 9.15-9.15M17 6l3 3M14 9l2 2"/>',
  "rules-decisions": '<path d="M6 3h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M8 8h8M8 12h8M8 16h5"/>',
  locks: '<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
  "hooks-guards": '<circle cx="12" cy="5" r="2"/><path d="M12 7v9a4 4 0 0 0 8 0v-2m-2 2 2-2 2 2"/>',
  audit: '<path d="M18 20V10M12 20V4M6 20v-6"/>',
  life: '<path d="M12 21V11M12 14c-4 0-7-3-7-7 4 0 7 3 7 7zM12 11c0-4 3-7 7-7 0 4-3 7-7 7z"/>',
  assistant: '<circle cx="12" cy="8" r="4"/><path d="M5 20a7 7 0 0 1 14 0"/>',
  domains: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
  connections: '<circle cx="6" cy="12" r="3"/><circle cx="18" cy="6" r="3"/><circle cx="18" cy="18" r="3"/><path d="m8.7 10.7 6.6-3.4M8.7 13.3l6.6 3.4"/>',
  help: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 0 1 5 0c0 1.5-2.5 2-2.5 3.5M12 16.5h.01"/>',
};

function lineIconSvg(id: string): string {
  const inner = LINE_ICON_SVGS[id] || '<circle cx="12" cy="12" r="8"/>';
  return `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${inner}</svg>`;
}
---

<a class="skip-link" href="#main-content">Zum Inhalt springen</a>

<header class="main-header" id="main-header">
  <div class="header-left">
    <button
      class="nav-toggle"
      id="nav-toggle"
      type="button"
      aria-controls="app-sidebar"
      aria-expanded="false"
      aria-label="Navigation öffnen"
    >
      <span class="nav-toggle-icon" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
    <a href="/" class="logo">
      <span class="logo-icon" id="gui-brand-icon" aria-hidden="true">◆</span>
      <img id="gui-brand-image" alt="" hidden width="28" height="28" />
      <span class="logo-text" id="gui-brand-label">System GUI</span>
    </a>
    <span id="backend-origin-badge" class="backend-origin-badge" role="status" aria-live="polite">Backend unbekannt</span>
  </div>

  <div class="header-right">
    <!-- Feste Schnellzugriffe (Kalender, Kontakte & Hilfe immer erreichbar) -->
    <div class="quick-nav-actions">
      <a href="/life?tab=kalender" class="quick-action-btn" title="Kalender (Termine, Routinen & Aufgaben)" aria-label="Kalender">
        <span class="icon-glyph icon-glyph-line" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" focusable="false"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4M3 9h18"/></svg></span>
        <span class="icon-glyph icon-glyph-emoji" aria-hidden="true">📅</span>
      </a>
      <a href="/kontakte" class="quick-action-btn" title="Kontakte & Netzwerk" aria-label="Kontakte">
        <span class="icon-glyph icon-glyph-line" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" focusable="false"><circle cx="9" cy="8" r="3.5"/><path d="M3 19a6 6 0 0 1 12 0"/><circle cx="17" cy="9" r="2.5"/><path d="M16 19a4.5 4.5 0 0 1 5 0"/></svg></span>
        <span class="icon-glyph icon-glyph-emoji" aria-hidden="true">👥</span>
      </a>
      <a href="/help" class="quick-action-btn" title="Hilfe & Dokumentation" aria-label="Hilfe">
        <span class="icon-glyph icon-glyph-line" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 0 1 5 0c0 1.5-2.5 2-2.5 3.5M12 16.5h.01"/></svg></span>
        <span class="icon-glyph icon-glyph-emoji" aria-hidden="true">❓</span>
      </a>
    </div>

    <!-- Theme Switcher -->
    <div class="theme-switcher" id="theme-switcher" role="group" aria-label="Farbschema">
      <button class="theme-btn" data-theme="dark" aria-label="Dunkler Modus" title="Dunkler Modus (Dark)" type="button"><span class="icon-glyph icon-glyph-line" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></span><span class="icon-glyph icon-glyph-emoji" aria-hidden="true">🌙</span></button>
      <button class="theme-btn" data-theme="light" aria-label="Heller Modus" title="Heller Modus (Light)" type="button"><span class="icon-glyph icon-glyph-line" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" focusable="false"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg></span><span class="icon-glyph icon-glyph-emoji" aria-hidden="true">☀️</span></button>
      <button class="theme-btn" data-theme="ocean" aria-label="Ozean Modus" title="Ozean Modus (Ocean)" type="button"><span class="icon-glyph icon-glyph-line" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M2 9c2-2 4-2 6 0s4 2 6 0 4-2 6 0M2 15c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/></svg></span><span class="icon-glyph icon-glyph-emoji" aria-hidden="true">🌊</span></button>
      <button class="theme-btn" data-theme="warm" aria-label="Warmer Modus" title="Warmer Modus (Sepia/Warm)" type="button"><span class="icon-glyph icon-glyph-line" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M12 3c1.5 2 2.5 3.5 2.5 5.2a2.5 2.5 0 1 1-5 0C9.5 6.5 10.5 5 12 3zM9 12h6v9H9zM6 21h12"/></svg></span><span class="icon-glyph icon-glyph-emoji" aria-hidden="true">🕯️</span></button>
    </div>
  </div>
</header>

<div class="sidebar-backdrop" id="sidebar-backdrop" aria-hidden="true" hidden></div>

<aside class="app-sidebar" id="app-sidebar" aria-label="Seitennavigation">
  <button class="sidebar-close" id="sidebar-close" type="button" aria-label="Navigation schließen">
    <span aria-hidden="true">×</span>
    <span>Schließen</span>
  </button>
  <div class="nav-preset-summary" id="nav-preset-summary" role="status" aria-live="polite">
    <span class="nav-preset-summary-label">Navigationsstil</span>
    <strong data-nav-preset-label>{navConfig.presets[defaultPreset]?.label || "Standard bewährt"}</strong>
  </div>
  {presetEntries.map(([presetId, preset]: [string, any]) => (
    <div
      class="nav-preset"
      data-ui-preset={presetId}
      data-nav-preset-label-value={preset.label}
      aria-hidden={presetId !== defaultPreset ? "true" : "false"}
      hidden={presetId !== defaultPreset}
    >
      <a
        href={preset.home.href}
        class={`nav-item sidebar-link sidebar-home${isActive(preset.home.href) ? " active" : ""}`}
        data-nav-link
        data-nav-id={preset.home.id}
        aria-current={isActive(preset.home.href) ? "page" : undefined}
        title={preset.home.description || undefined}
      >
        <span class="nav-icon" aria-hidden="true"><span class="icon-glyph icon-glyph-line" set:html={lineIconSvg(preset.home.id)} /><span class="icon-glyph icon-glyph-emoji">{preset.home.icon}</span></span>
        <span class="nav-label">{preset.home.label}</span>
      </a>
      <nav class="main-nav" aria-label={`${preset.label} Hauptnavigation`}>
        {preset.sections.map((section: any) => (
          <section class="nav-section" data-nav-section={section.id} aria-labelledby={`nav-section-${presetId}-${section.id}`}>
            <h2 class="nav-section-title" id={`nav-section-${presetId}-${section.id}`}>{section.label}</h2>
            <div class="nav-section-links">
              {section.items.map((item: any) => (
                item.children ? (
                  <details class="sidebar-group sidebar-nested" data-nav-group={item.id} open={hasActiveItem(item) ? true : undefined}>
                    <summary class="sidebar-group-title">
                      <span class="sidebar-group-icon" aria-hidden="true"><span class="icon-glyph icon-glyph-line" set:html={lineIconSvg(item.id)} /><span class="icon-glyph icon-glyph-emoji">{item.icon}</span></span>
                      <span>{item.label}</span>
                      <span class="sidebar-group-chevron" aria-hidden="true">⌄</span>
                    </summary>
                    <div class="sidebar-group-links">
                      {item.children.map((child: any) => (
                        <a
                          href={child.href}
                          target={child.target || undefined}
                          rel={child.target === "_blank" ? "noopener noreferrer" : undefined}
                          class={`nav-item sidebar-link${isActive(child.href) ? " active" : ""}`}
                          data-nav-link
                          data-nav-id={child.id}
                          aria-current={isActive(child.href) ? "page" : undefined}
                          title={child.description || undefined}
                        >
                          <span class="nav-icon" aria-hidden="true"><span class="icon-glyph icon-glyph-line" set:html={lineIconSvg(child.id)} /><span class="icon-glyph icon-glyph-emoji">{child.icon}</span></span>
                          <span class="nav-label">{child.label}</span>
                        </a>
                      ))}
                    </div>
                  </details>
                ) : (
                  <a
                    href={item.href}
                    target={item.target || undefined}
                    rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
                    class={`nav-item sidebar-link${isActive(item.href) ? " active" : ""}`}
                    data-nav-link
                    data-nav-id={item.id}
                    aria-current={isActive(item.href) ? "page" : undefined}
                    title={item.description || undefined}
                  >
                    <span class="nav-icon" aria-hidden="true"><span class="icon-glyph icon-glyph-line" set:html={lineIconSvg(item.id)} /><span class="icon-glyph icon-glyph-emoji">{item.icon}</span></span>
                    <span class="nav-label">{item.label}</span>
                  </a>
                )
              ))}
            </div>
          </section>
        ))}
      </nav>
    </div>
  ))}
  <div class="sidebar-domain-pins">
    <div class="sidebar-domain-pins-label">Angepinnte Domänen</div>
    <div id="domain-pins-menu" aria-live="polite"><span class="dropdown-item">Pins werden geprüft…</span></div>
  </div>
</aside>



<script is:inline>
  async function refreshGuiBrand() {
    try {
      const response = await fetch('/api/gui/brand', { cache: 'no-store' });
      if (!response.ok) return;
      const state = await response.json();
      if (state.schema !== 'ellmos-system-gui.brand.v1') return;
      if (typeof state.label !== 'string' || typeof state.product !== 'string'
          || typeof state.logo_text !== 'string') return;
      const label = state.label.trim();
      const product = state.product.trim();
      if (!label || !product || label.length > 48 || product.length > 48) return;
      document.getElementById('gui-brand-label').textContent = label;
      document.querySelectorAll('[data-gui-brand-label]').forEach(el => { el.textContent = label; });
      document.querySelectorAll('[data-gui-brand-product]').forEach(el => { el.textContent = product; });
      document.title = document.title.replace(/ \| System GUI$/, '') + ' | ' + product;
      const icon = document.getElementById('gui-brand-icon');
      icon.textContent = state.logo_text;
      const img = document.getElementById('gui-brand-image');
      if (typeof state.logo_path === 'string' && /^\/static\/branding\/[A-Za-z0-9._/-]+\.(png|webp)$/.test(state.logo_path)
          && !state.logo_path.includes('..')) {
        img.onerror = () => { img.hidden = true; icon.hidden = false; };
        img.src = state.logo_path;
        img.hidden = false;
        icon.hidden = true;
      }
      if (!localStorage.getItem('bach-theme') && ['dark', 'light', 'ocean', 'warm'].includes(state.theme)) {
        applyTheme(state.theme, false);
      }
    } catch (_) {
      // The neutral shell remains usable when consumer metadata is unavailable.
    }
  }
  refreshGuiBrand();

  async function refreshBackendOriginBadge() {
    const badge = document.getElementById('backend-origin-badge');
    if (!badge) return;
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 5000);
    try {
      const response = await fetch('/api/gui/backend-origin', { cache: 'no-store', signal: controller.signal });
      if (!response.ok) throw new Error('Backend-Metadaten nicht erreichbar');
      const state = await response.json();
      const verified = state.connection_verified === true && state.schema_verified === true
        && state.instance_verified === true && state.adapter_binding_verified === true;
      if (verified && state.mode === 'server') {
        badge.textContent = 'Backend: Server';
      } else if (verified && state.mode === 'local') {
        badge.textContent = 'Backend: Lokal';
      } else {
        badge.textContent = 'Backend unbekannt';
      }
      badge.dataset.verified = String(verified && (state.mode === 'server' || state.mode === 'local'));
      badge.title = badge.dataset.verified === 'true' && state.instance_label
        ? `${state.instance_label} · geprüft ${state.observed_at || ''}` : 'Backendquelle nicht verifiziert';
    } catch (_) {
      badge.textContent = 'Offline · Backend unbekannt';
      badge.dataset.verified = 'false';
      badge.title = 'Backend-Metadaten nicht erreichbar; kein Cache belegt';
    } finally {
      clearTimeout(timeout);
    }
  }
  refreshBackendOriginBadge();
  setInterval(refreshBackendOriginBadge, 30000);

  // Theme Manager
  function applyTheme(theme, persist = true) {
    const root = document.documentElement;
    if (theme === 'dark') {
      root.removeAttribute('data-theme');
    } else {
      root.setAttribute('data-theme', theme);
    }
    if (persist) {
      localStorage.setItem('bach-theme', theme);
    }

    // Update button states
    document.querySelectorAll('.theme-btn').forEach(btn => {
      const selected = btn.getAttribute('data-theme') === theme;
      btn.classList.toggle('active', selected);
      btn.setAttribute('aria-pressed', String(selected));
    });
    const themeSelect = document.getElementById('theme-select');
    if (themeSelect && ['dark', 'light', 'ocean', 'warm', 'custom'].includes(theme)) {
      themeSelect.value = theme;
    }
  }
  window.applyTheme = applyTheme;

  // Initialize Theme
  const savedTheme = localStorage.getItem('bach-theme') || 'dark';
  applyTheme(savedTheme, false);

  // Wire Theme Buttons
  document.querySelectorAll('.theme-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const theme = btn.getAttribute('data-theme');
      if (theme) applyTheme(theme);
    });
  });

  // Navigation preset: Standard is the safe default; the choice is local to
  // this browser until a consumer-side preference contract exists.
  const validUiPresets = new Set(['standard', 'classic']);
  const uiPresetKey = 'bach-ui-preset';
  function normalizeUiPreset(value) {
    return validUiPresets.has(value) ? value : 'standard';
  }
  function applyUiPreset(value, persist = true) {
    const preset = normalizeUiPreset(value);
    document.documentElement.dataset.uiPreset = preset;
    document.querySelectorAll('[data-ui-preset]').forEach(panel => {
      const active = panel.dataset.uiPreset === preset;
      panel.hidden = !active;
      panel.setAttribute('aria-hidden', String(!active));
    });
    const label = document.querySelector('[data-nav-preset-label]');
    const activePanel = document.querySelector(`[data-ui-preset="${preset}"]`);
    if (label && activePanel?.dataset.navPresetLabelValue) {
      label.textContent = activePanel.dataset.navPresetLabelValue;
    }
    if (persist) localStorage.setItem(uiPresetKey, preset);
    window.dispatchEvent(new CustomEvent('bach-ui-preset-change', { detail: { preset } }));
    return preset;
  }
  window.bachUiPreset = {
    get: () => normalizeUiPreset(localStorage.getItem(uiPresetKey) || document.documentElement.dataset.uiPreset),
    set: (value) => applyUiPreset(value),
  };
  applyUiPreset(window.bachUiPreset.get(), false);

  const validUiIconStyles = new Set(['line', 'emoji']);
  const uiIconStyleKey = 'bach-ui-icon-style';
  function normalizeUiIconStyle(value) {
    return validUiIconStyles.has(value) ? value : 'line';
  }
  function applyUiIconStyle(value, persist = true) {
    const iconStyle = normalizeUiIconStyle(value);
    document.documentElement.dataset.uiIconStyle = iconStyle;
    if (persist) localStorage.setItem(uiIconStyleKey, iconStyle);
    window.dispatchEvent(new CustomEvent('bach-ui-icon-style-change', { detail: { iconStyle } }));
    return iconStyle;
  }
  window.bachUiIconStyle = {
    get: () => normalizeUiIconStyle(localStorage.getItem(uiIconStyleKey) || document.documentElement.dataset.uiIconStyle),
    set: (value) => applyUiIconStyle(value),
  };
  applyUiIconStyle(window.bachUiIconStyle.get(), false);

  // Keep the mobile navigation reachable without changing desktop navigation state.
  const navToggle = document.getElementById('nav-toggle');
  const sidebar = document.getElementById('app-sidebar');
  const sidebarClose = document.getElementById('sidebar-close');
  const backdrop = document.getElementById('sidebar-backdrop');
  const mobileNavigation = window.matchMedia('(max-width: 860px)');
  let mobileNavigationOpen = false;

  function syncSidebarMode() {
    if (!navToggle || !sidebar || !sidebarClose || !backdrop) return;
    // Main and footer may not have been parsed when this inline script ran.
    const backgroundShell = [
      document.querySelector('.skip-link'),
      document.getElementById('main-header'),
      document.getElementById('main-content'),
      document.querySelector('body > footer'),
    ].filter(Boolean);
    const mobile = mobileNavigation.matches;
    if (!mobile) {
      mobileNavigationOpen = false;
      sidebar.classList.remove('is-open');
      sidebar.inert = false;
      sidebar.removeAttribute('aria-hidden');
      sidebar.removeAttribute('aria-modal');
      sidebar.removeAttribute('role');
      backgroundShell.forEach((element) => { element.inert = false; });
      backdrop.hidden = true;
      navToggle.setAttribute('aria-expanded', 'false');
      navToggle.setAttribute('aria-label', 'Navigation öffnen');
      document.body.classList.remove('nav-open');
      return;
    }
    sidebar.classList.toggle('is-open', mobileNavigationOpen);
    sidebar.inert = !mobileNavigationOpen;
    sidebar.setAttribute('aria-hidden', String(!mobileNavigationOpen));
    backgroundShell.forEach((element) => { element.inert = mobileNavigationOpen; });
    if (mobileNavigationOpen) {
      sidebar.setAttribute('role', 'dialog');
      sidebar.setAttribute('aria-modal', 'true');
    } else {
      sidebar.removeAttribute('aria-modal');
      sidebar.removeAttribute('role');
    }
    backdrop.hidden = !mobileNavigationOpen;
    navToggle.setAttribute('aria-expanded', String(mobileNavigationOpen));
    navToggle.setAttribute('aria-label', mobileNavigationOpen ? 'Navigation schließen' : 'Navigation öffnen');
    document.body.classList.toggle('nav-open', mobileNavigationOpen);
  }

  function setMobileNavigationOpen(open, returnFocus = false) {
    if (!mobileNavigation.matches) return;
    mobileNavigationOpen = open;
    syncSidebarMode();
    if (open) {
      // Let the visibility transition start before moving focus into the drawer.
      requestAnimationFrame(() => requestAnimationFrame(() => {
        if (mobileNavigationOpen && mobileNavigation.matches)
          sidebarClose?.focus({ preventScroll: true });
      }));
    }
    else if (returnFocus) navToggle?.focus({ preventScroll: true });
  }

  navToggle?.addEventListener('click', () => setMobileNavigationOpen(!mobileNavigationOpen));
  backdrop?.addEventListener('click', () => setMobileNavigationOpen(false, true));
  sidebar?.addEventListener('click', (event) => {
    if (!mobileNavigation.matches) return;
    if (event.target.closest('#sidebar-close')) setMobileNavigationOpen(false, true);
    else if (event.target.closest('a[href]')) setMobileNavigationOpen(false, true);
  });

  function trapMobileNavigationTab(event) {
    if (event.key !== 'Tab' || !mobileNavigationOpen || !sidebar) return;
    const focusableElements = [...sidebar.querySelectorAll('button:not([disabled]), a[href], summary, [tabindex]:not([tabindex="-1"])')]
      .filter((element) => {
        if (element.closest('[inert], [hidden]')) return false;
        const closedDetails = element.closest('details:not([open])');
        return !closedDetails || element.matches('summary');
      });
    if (focusableElements.length === 0) {
      event.preventDefault();
      sidebarClose?.focus({ preventScroll: true });
      return;
    }
    const first = focusableElements[0];
    const last = focusableElements[focusableElements.length - 1];
    if (event.shiftKey && (document.activeElement === first || !sidebar.contains(document.activeElement))) {
      event.preventDefault();
      last.focus({ preventScroll: true });
    } else if (!event.shiftKey && (document.activeElement === last || !sidebar.contains(document.activeElement))) {
      event.preventDefault();
      first.focus({ preventScroll: true });
    }
  }

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileNavigationOpen) {
      setMobileNavigationOpen(false, true);
      return;
    }
    trapMobileNavigationTab(event);
  });
  mobileNavigation.addEventListener('change', syncSidebarMode);
  syncSidebarMode();

  function matchesCurrentNavigationRoute(href) {
    if (!href || href === '#') return false;
    const origin = window.location.origin;
    const target = new URL(href, origin);
    const current = new URL(window.location.href);
    const normalizePath = (value) => value.replace(/\/+$/, '') || '/';
    const querySignature = (value) => [...new URLSearchParams(value).entries()]
      .sort(([leftKey, leftValue], [rightKey, rightValue]) => leftKey.localeCompare(rightKey) || leftValue.localeCompare(rightValue))
      .map(([key, entry]) => `${encodeURIComponent(key)}=${encodeURIComponent(entry)}`)
      .join('&');
    return target.origin === origin
      && normalizePath(target.pathname) === normalizePath(current.pathname)
      && querySignature(target.search) === querySignature(current.search);
  }

  function refreshActiveNavigation() {
    document.querySelectorAll('.app-sidebar a[href]').forEach((link) => {
      const active = matchesCurrentNavigationRoute(link.getAttribute('href'));
      link.classList.toggle('active', active);
      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
    document.querySelectorAll('[data-nav-group]').forEach((group) => {
      const active = Boolean(group.querySelector('a.active'));
      group.classList.toggle('active', active);
      if (active) group.open = true;
    });
  }

  refreshActiveNavigation();
  window.addEventListener('popstate', refreshActiveNavigation);
  const domainPinsMenu = document.getElementById('domain-pins-menu');
  if (domainPinsMenu) new MutationObserver(refreshActiveNavigation).observe(domainPinsMenu, { childList: true, subtree: true });
</script>

<script>import {initializeDomainMenu} from "../lib/domain-pins.mjs";initializeDomainMenu();</script>
