          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ start_listening: Boolean(startListening) }),
        });
        if (!res.ok) return null;
        const data = await res.json();
        if (data && data.visual_state) {
          data.visual_state.pending_summon = null;
          applyTalkStateToHeader(data.visual_state);
        }
        return data;
      } catch (_) {
        return null;
      }
    }

