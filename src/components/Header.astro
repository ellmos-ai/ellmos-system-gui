  chat: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  tasks: '<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V2h6v2M9 10h6M9 14h6M9 18h4"/>',
  messages: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  "living-running": '<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>',
  routines: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  library: '<path d="M2 4h7a3 3 0 0 1 3 3v13a2 2 0 0 0-2-2H2zM22 4h-7a3 3 0 0 0-3 3v13a2 2 0 0 1 2-2h8z"/>',
  "agent-library": '<rect x="4" y="7" width="16" height="12" rx="2"/><path d="M12 3v4M9 12h.01M15 12h.01M9 16h6"/>',
  agents: '<rect x="4" y="7" width="16" height="12" rx="2"/><path d="M12 3v4M9 12h.01M15 12h.01M9 16h6"/>',
  "prompt-agents": '<path d="M12 3a5 5 0 0 1 5 5v2a5 5 0 0 1-10 0V8a5 5 0 0 1 5-5zM5 10a7 7 0 0 0 14 0M12 17v4M8 21h8"/>',
  chains: '<path d="M10 13a5 5 0 0 0 7.07 0l2.83-2.83a5 5 0 0 0-7.07-7.07L11 4.93M14 11a5 5 0 0 0-7.07 0L4.1 13.83a5 5 0 0 0 7.07 7.07L13 19.07"/>',
  "skill-keeper": '<circle cx="12" cy="12" r="9"/><polygon points="15.5 8.5 13.5 13.5 8.5 15.5 10.5 10.5 15.5 8.5"/>',
  "skills-software": '<path d="M9 2v5M15 2v5M6 7h12v4a6 6 0 0 1-12 0zM12 17v5"/>',
  "ocean-modules": '<path d="M2 9c2-2 4-2 6 0s4 2 6 0 4-2 6 0M2 15c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/>',
  plugins: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>',
  "other-domains": '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>',
  mcp: '<path d="M9 2v5M15 2v5M6 7h12v4a6 6 0 0 1-12 0zM12 17v5"/>',
  software: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>',
  systems: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>',
  "find-tools": '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  "profile-prompts": '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/>',
  artifacts: '<path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21v-8H7v8M7 3v5h8"/>',
  services: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.93 4.93l2.12 2.12M16.95 16.95l2.12 2.12M2 12h3M19 12h3M4.93 19.07l2.12-2.12M16.95 7.05l2.12-2.12"/>',
  settings: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.93 4.93l2.12 2.12M16.95 16.95l2.12 2.12M2 12h3M19 12h3M4.93 19.07l2.12-2.12M16.95 7.05l2.12-2.12"/>',
  system: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.93 4.93l2.12 2.12M16.95 16.95l2.12 2.12M2 12h3M19 12h3M4.93 19.07l2.12-2.12M16.95 7.05l2.12-2.12"/>',
  maintenance: '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L4 17v3h3l5.3-5.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2-2z"/>',
  quality: '<circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.5 2.5 4.5-5"/>',
  "models-resources": '<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 12 12 17 22 12"/><polyline points="2 17 12 22 22 17"/>',
  memory: '<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 12 12 17 22 12"/><polyline points="2 17 12 22 22 17"/>',
  "governance-control": '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  governance: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  authority: '<circle cx="8" cy="15" r="4"/><path d="m10.85 12.15 9.15-9.15M17 6l3 3M14 9l2 2"/>',
  "rules-decisions": '<path d="M6 3h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M8 8h8M8 12h8M8 16h5"/>',
  locks: '<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
  "hooks-guards": '<circle cx="12" cy="5" r="2"/><path d="M12 7v9a4 4 0 0 0 8 0v-2m-2 2 2-2 2 2"/>',
  audit: '<path d="M18 20V10M12 20V4M6 20v-6"/>',
  life: '<path d="M12 21V11M12 14c-4 0-7-3-7-7 4 0 7 3 7 7zM12 11c0-4 3-7 7-7 0 4-3 7-7 7z"/>',
  assistant: '<circle cx="12" cy="8" r="4"/><path d="M5 20a7 7 0 0 1 14 0"/>',
  domains: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
  connections: '<circle cx="6" cy="12" r="3"/><circle cx="18" cy="6" r="3"/><circle cx="18" cy="18" r="3"/><path d="m8.7 10.7 6.6-3.4M8.7 13.3l6.6 3.4"/>',
  help: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 0 1 5 0c0 1.5-2.5 2-2.5 3.5M12 16.5h.01"/>',
};

function lineIconSvg(id: string): string {
  const inner = LINE_ICON_SVGS[id] || '<circle cx="12" cy="12" r="8"/>';
  return `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${inner}</svg>`;
}
---

<a class="skip-link" href="#main-content">Zum Inhalt springen</a>

<header class="main-header" id="main-header">
  <div class="header-left">
    <button
      class="nav-toggle"
      id="nav-toggle"
      type="button"
      aria-controls="app-sidebar"
      aria-expanded="false"
      aria-label="Navigation öffnen"
    >
      <span class="nav-toggle-icon" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
    <a href="/" class="logo">
      <span class="logo-icon" id="gui-brand-icon" aria-hidden="true">◆</span>
      <img id="gui-brand-image" alt="" hidden width="28" height="28" />
      <span class="logo-text" id="gui-brand-label">System GUI</span>
    </a>
    <span id="backend-origin-badge" class="backend-origin-badge" role="status" aria-live="polite">Backend unbekannt</span>
    <button
      type="button"
      id="header-ram-claim-btn"
      class="backend-origin-badge header-ram-claim-pill"
      title="RAM-Distributor & Modell-Claiming — Klicken, um geladene Modelle & RAM für andere Prozesse freizugeben"
      aria-label="Modell- und RAM-Belegung prüfen oder freigeben"
    >
      <span id="header-ram-claim-dot" class="ram-claim-dot"></span>
      <span id="header-ram-claim-label">🧠 RAM: Prüfe…</span>
    </button>
  </div>

  <!-- Animiertes Origami-Papierboot im freien Bereich auf der Trennlinie zum Body (Meeresoberfläche) -->
  <div class="header-ocean-waterline" aria-hidden="true" title="OCEAN · Vom Rinnsal über den BACH bis ins Meer">
    <div class="header-waterline-surface"></div>
    <div class="header-paper-boat-track">
      <div class="header-paper-boat-hull">
        <span class="header-boat-wake"></span>
        <svg class="header-paper-boat-svg" viewBox="0 0 84 44" width="54" height="29" focusable="false" aria-hidden="true">
          <defs>
            <linearGradient id="paper-boat-hull-grad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#ffffff" />
              <stop offset="65%" stop-color="#e0f2fe" />
              <stop offset="100%" stop-color="#bae6fd" />
            </linearGradient>
            <linearGradient id="paper-boat-sail-left" x1="20%" y1="0%" x2="90%" y2="100%">
              <stop offset="0%" stop-color="#f8fafc" />
              <stop offset="100%" stop-color="#cbd5e1" />
            </linearGradient>
            <linearGradient id="paper-boat-sail-right" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#ffffff" />
              <stop offset="100%" stop-color="#93c5fd" />
            </linearGradient>
            <linearGradient id="paper-boat-shadow" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#64748b" stop-opacity="0.45" />
              <stop offset="100%" stop-color="#1e293b" stop-opacity="0.7" />
            </linearGradient>
          </defs>
          <!-- Origami Mittelspitze (Hauptsegel) -->
          <polygon points="42,3 27,25 42,23" fill="url(#paper-boat-sail-left)" stroke="#475569" stroke-width="1.15" stroke-linejoin="round" />
          <polygon points="42,3 57,25 42,23" fill="url(#paper-boat-sail-right)" stroke="#475569" stroke-width="1.15" stroke-linejoin="round" />
          <!-- Innere Papierfalz-Schattierung -->
          <polygon points="27,25 42,16 57,25 42,27" fill="url(#paper-boat-shadow)" />
          <!-- Bug- und Heck-Papierflügel -->
          <polygon points="4,20 42,25 18,35" fill="#e2e8f0" stroke="#475569" stroke-width="1.15" stroke-linejoin="round" />
          <polygon points="80,20 42,25 66,35" fill="#f1f5f9" stroke="#475569" stroke-width="1.15" stroke-linejoin="round" />
          <!-- Vorderer Origami-Rumpf direkt auf der Wasserlinie -->
          <polygon points="4,20 80,20 66,35 18,35" fill="url(#paper-boat-hull-grad)" stroke="#334155" stroke-width="1.25" stroke-linejoin="round" />
          <!-- Mittlere Faltkante & Wasserlinien-Glanz -->
          <line x1="42" y1="3" x2="42" y2="35" stroke="#64748b" stroke-width="0.95" stroke-opacity="0.65" />
          <line x1="16" y1="35.5" x2="68" y2="35.5" stroke="#38bdf8" stroke-width="1.8" stroke-linecap="round" />
        </svg>
        <span class="header-boat-reflection"></span>
      </div>
    </div>
  </div>

  <div class="header-right">
    <!-- Feste Schnellzugriffe (Kalender, Kontakte & Hilfe immer erreichbar) -->
    <div class="quick-nav-actions">
      <a href="/life?tab=kalender" class="quick-action-btn" title="Kalender (Termine, Routinen & Aufgaben)" aria-label="Kalender">
        <span class="icon-glyph icon-glyph-line" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" focusable="false"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4M3 9h18"/></svg></span>
        <span class="icon-glyph icon-glyph-emoji" aria-hidden="true">📅</span>
      </a>
      <a href="/kontakte" class="quick-action-btn" title="Kontakte & Netzwerk" aria-label="Kontakte">
        <span class="icon-glyph icon-glyph-line" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" focusable="false"><circle cx="9" cy="8" r="3.5"/><path d="M3 19a6 6 0 0 1 12 0"/><circle cx="17" cy="9" r="2.5"/><path d="M16 19a4.5 4.5 0 0 1 5 0"/></svg></span>
        <span class="icon-glyph icon-glyph-emoji" aria-hidden="true">👥</span>
      </a>
      <a href="/help" class="quick-action-btn" title="Hilfe & Dokumentation" aria-label="Hilfe">
        <span class="icon-glyph icon-glyph-line" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 0 1 5 0c0 1.5-2.5 2-2.5 3.5M12 16.5h.01"/></svg></span>
        <span class="icon-glyph icon-glyph-emoji" aria-hidden="true">❓</span>
      </a>
    </div>

    <!-- ELLMOS Talk / Funkgerät-Sprechhandgerät Bildlink + Pop-over (Instrument / Transceiver Console) -->
    <div class="header-talk-radio-wrap" id="header-talk-radio-wrap">
      <button
        id="header-talk-radio-btn"
        type="button"
        class="quick-action-btn talk-trigger-btn talk-handmic-img-btn"
        aria-expanded="false"
        aria-controls="header-talk-popover"
        aria-label="ELLMOS Talk / Funkgerät-Sprechhandgerät öffnen"
        title="ELLMOS Talk / Funkgerät-Sprechhandgerät — Klicken für Konsole, Alt+Leertaste für Push-to-Talk"
      >
        <img
          src={talkHandmicImg.src} onerror="this.onerror=null;this.src='/assets/icons/talk-handmic-comic.jpg';"
          alt="ELLMOS Talk Funkgerät-Sprechhandgerät"
          class="talk-handmic-thumb"
          width="36"
          height="36"
        />
        <span id="header-talk-dot" class="talk-trigger-dot" title="Funkkanal-Status"></span>
        <span id="header-talk-btn-label" class="talk-sr-label">Funk / Talk</span>
      </button>

      <div
        id="header-talk-popover"
        class="talk-console-popover"
        role="dialog"
        aria-label="ELLMOS Talk & Funkgerät Steuerung"
        hidden
      >
        <!-- 1. Instrument Console Top Bar -->
        <div class="talk-console-header">
          <div class="talk-console-identity">
            <div id="header-talk-mini-orb" class="talk-console-orb">
              <img src={talkHandmicImg.src} onerror="this.onerror=null;this.src='/assets/icons/talk-handmic-comic.jpg';" alt="" class="talk-console-orb-img" width="36" height="36" />
              <span id="header-talk-mini-emoji" class="talk-console-orb-emoji">🧘</span>
            </div>
            <div class="talk-console-titles">
              <div class="talk-console-title-row">
                <strong>ELLMOS Talk</strong>
                <span class="talk-console-freq">CH-01 · KLASSE 1</span>
                <span id="header-talk-runtime-badge" class="talk-console-badge">🌐 Browser</span>
              </div>
              <small id="header-talk-state-text" class="talk-console-subtitle">BUDDHA · Bereit für Funkspruch</small>
            </div>
          </div>
          <button
            type="button"
            id="header-talk-close-btn"
            class="talk-console-close"
            aria-label="Funkgerät-Pop-over schließen"
            title="Schließen (Esc)"
          >✕</button>
        </div>

        <!-- 2. Incoming Model Summon Banner (strictly hidden unless active & unacknowledged) -->
        <div id="header-talk-summon-banner" class="talk-summon-alert" hidden>
          <div class="talk-summon-header">
            <span class="talk-summon-pulse"></span>
            <strong id="header-talk-summon-title">📻 Modell-Funkspruch eingehend</strong>
          </div>
          <p id="header-talk-summon-msg" class="talk-summon-body">Ein Modell möchte mit dir sprechen.</p>
          <div class="talk-summon-actions">
            <button type="button" id="header-talk-summon-accept" class="talk-btn talk-btn-accept">🎙️ Annehmen</button>
            <button type="button" id="header-talk-summon-dismiss" class="talk-btn talk-btn-later">Später</button>
          </div>
        </div>

        <!-- 3. Segmented Persona / Agent Binding Bar -->
        <div class="talk-section-block">
          <div class="talk-section-label">
            <span>Angebundener Agent (Modell-Bindung)</span>
            <span id="header-talk-active-model-pill" class="talk-mono-pill">buddha-default</span>
          </div>
          <div class="talk-persona-grid" role="radiogroup" aria-label="Angebundenes Modell wählen">
            <button type="button" class="talk-persona-pill is-active" data-talk-persona="buddha">🧘 Buddha</button>
            <button type="button" class="talk-persona-pill" data-talk-persona="claude">🟣 Claude</button>
            <button type="button" class="talk-persona-pill" data-talk-persona="gemini">🔵 Gemini</button>
            <button type="button" class="talk-persona-pill" data-talk-persona="codex">🟢 Codex</button>
          </div>
          <select id="header-talk-persona" class="talk-sr-select" aria-hidden="true" tabindex="-1">
            <option value="buddha">🧘 Buddha (Lokal)</option>
            <option value="claude">🟣 Claude</option>
            <option value="gemini">🔵 Gemini</option>
            <option value="codex">🟢 Codex / GPT</option>
          </select>
        </div>

        <!-- 4. Primary Transceiver Controls (PTT + Duplex + Quick Text Funk) -->
        <div class="talk-transceiver-deck">
          <button
            type="button"
            id="header-talk-ptt-btn"
            class="talk-ptt-hero"
            title="Klicken oder gedrückt halten zum Einsprechen"
          >
            <span class="talk-ptt-led"></span>
            <span id="header-talk-ptt-label">📻 Funkspruch senden (PTT)</span>
          </button>
          <button
            type="button"
            id="header-talk-live-btn"
            class="talk-duplex-btn"
            title="Dauerhaftes Freisprechen (Live-Duplex) umschalten"
          >
            🎙️ Duplex
          </button>
        </div>

        <form id="header-talk-quick-form" class="talk-quick-form">
          <input
            id="header-talk-quick-input"
            type="text"
            class="talk-quick-input"
            placeholder="Kurzen Funkspruch tippen + Enter…"
            autocomplete="off"
          />
          <button type="submit" class="talk-quick-send" title="Funkspruch senden">📡</button>
        </form>

        <div id="header-talk-reply-box" class="talk-reply-card" hidden></div>

        <!-- 5. Operating Mode Segmented Switcher -->
        <div class="talk-section-block">
          <div class="talk-section-label">
            <span>Betriebsmodus</span>
            <span class="talk-mono-pill">Fast-Relay aktiv</span>
          </div>
          <div class="talk-mode-strip" role="radiogroup" aria-label="Betriebsmodus">
            <button type="button" class="talk-mode-pill is-active" data-talk-opmode="ptt">📻 PTT</button>
            <button type="button" class="talk-mode-pill" data-talk-opmode="duplex">🎙️ Duplex</button>
            <button type="button" class="talk-mode-pill" data-talk-opmode="wake_word">👂 Wake</button>
            <button type="button" class="talk-mode-pill" data-talk-opmode="off">⏸️ Aus</button>
          </div>
          <select id="header-talk-opmode" class="talk-sr-select" aria-hidden="true" tabindex="-1">
            <option value="ptt">📻 Funkgerät (PTT)</option>
            <option value="duplex">🎙️ Live-Duplex</option>
            <option value="wake_word">👂 Wake-Word</option>
            <option value="off">⏸️ Aus</option>
          </select>
        </div>

        <!-- 6. Collapsible Audio Devices & Summon Policy Drawer -->
        <details class="talk-console-drawer">
          <summary class="talk-drawer-summary">
            <span>⚙️ Kanal- &amp; Audio-Geräte</span>
            <span class="talk-drawer-chevron">▾</span>
          </summary>
          <div class="talk-drawer-body">
            <label class="talk-field-label">
              <span>Modell-Eigenstart (Agent Summon):</span>
              <select id="header-talk-summon-policy" class="lang-switcher talk-full-select">
                <option value="knock">🔔 Funkgerät-Anklopfen im Header</option>
                <option value="auto_popup">⚡ Auto-Popup (bei Präsenz via Sensation)</option>
                <option value="muted">🔕 Stumm (Kein Modell-Eigenstart)</option>
              </select>
            </label>
            <div class="talk-device-row">
              <label class="talk-field-label">
                <span>🎤 Mikrofon:</span>
                <select id="header-talk-mic-select" class="lang-switcher talk-full-select">
                  <option value="default">Standard-Mikrofon</option>
                </select>
              </label>
              <label class="talk-field-label">
                <span>🔊 Lautsprecher:</span>
