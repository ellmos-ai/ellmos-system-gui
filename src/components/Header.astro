        pill.classList.toggle('is-active', active);
        pill.setAttribute('aria-checked', String(active));
      });
      modePills.forEach((pill) => {
        const active = pill.getAttribute('data-talk-opmode') === opmode;
        pill.classList.toggle('is-active', active);
        pill.setAttribute('aria-checked', String(active));
      });
    }

    function applyTalkStateToHeader(cfg) {
      if (!cfg || typeof cfg !== 'object') return;
      window.__bachTalkConfig = cfg;
      const color = cfg.color_primary || '#00d4aa';
      if (miniOrb) {
        miniOrb.style.background = `radial-gradient(circle at 35% 35%, ${color}, #0f172a 78%)`;
        miniOrb.style.boxShadow = `0 0 18px ${color}66`;
      }
      if (miniEmoji && cfg.emoji_overlay) miniEmoji.textContent = cfg.emoji_overlay;
      const persona = cfg.persona || 'buddha';
      const opmode = cfg.operating_mode || 'ptt';
      if (personaSelect) personaSelect.value = persona;
      if (opmodeSelect) opmodeSelect.value = opmode;
      if (summonSelect && cfg.summon_policy) summonSelect.value = cfg.summon_policy;
      if (activeModelPill) activeModelPill.textContent = cfg.primary_model || 'buddha-default';
      syncSegmentedControls(persona, opmode);

      const modeLabels = {
        ptt: 'Funkgerät · PTT bereit',
        duplex: 'Live-Duplex aktiv',
        wake_word: `Wake-Word („${cfg.wake_word || 'Hey Buddha'}“)`,
        off: 'Funkkanal stumm',
      };
      if (stateText) {
        stateText.textContent = `${persona.toUpperCase()} · ${modeLabels[opmode] || 'Funkgerät'}`;
      }

      const s = cfg.pending_summon;
      const sig = getSummonSignature(s);
      const dismissedSig = sessionStorage.getItem(DISMISSED_SUMMON_KEY) || '';
      const hasActiveSummon = Boolean(s && s.message && sig !== dismissedSig);

      if (hasActiveSummon) {
        if (summonBanner) summonBanner.hidden = false;
        if (summonTitle) summonTitle.textContent = `📻 ${(s.caller || 'Modell').toUpperCase()} ruft über Funk`;
        if (summonMsg) summonMsg.textContent = s.message;
        if (dot) {
          dot.style.background = '#38bdf8';
          dot.style.boxShadow = '0 0 12px #38bdf8';
