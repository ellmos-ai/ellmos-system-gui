    async function sendHeaderTalkTurn(utterance) {
      if (!utterance) return null;
      try {
        const persona = personaSelect?.value || 'buddha';
        const lang = document.documentElement.lang || 'de';
        let turnResolved = false;
        if (replyBox) {
          replyBox.hidden = false;
          replyBox.textContent = `⚡ Fast-Reflex (${persona.toUpperCase()}) prüft Kanal…`;
        }
        // Stage 1: Fast-Reflex (<200ms Vorlauf-Backchanneling vor der Hauptmodell-Antwort)
        fetch('/api/talk/reflex', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ user_utterance: utterance, persona, language: lang }),
        })
          .then((r) => (r.ok ? r.json() : null))
          .then((rData) => {
            if (turnResolved || !rData) return;
            if (rData.visual_state) applyTalkStateToHeader(rData.visual_state);
            const ack = rData.reflex?.ack_text || '';
            const fastModel = rData.reflex?.fast_model || 'fast-reflex';
            if (replyBox && ack) {
              replyBox.hidden = false;
              replyBox.textContent = `⚡ ${ack} (${fastModel} · ${persona.toUpperCase()} denkt nach…)`;
            }
          })
          .catch(() => {});

        // Stage 2: Deep-Cortex Hauptmodell-Antwort
        const res = await fetch('/api/talk/turn', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ user_utterance: utterance, persona, language: lang }),
        });
        turnResolved = true;
        if (!res.ok) return null;
        const data = await res.json();
        if (data && data.visual_state) applyTalkStateToHeader(data.visual_state);
        if (replyBox && data?.spoken_text) {
          replyBox.hidden = false;
          const reflexPrefix = data.reflex?.ack_text ? `⚡ ${data.reflex.ack_text} — ` : '';
          replyBox.textContent = `${reflexPrefix}${data.spoken_text}`;
        }
        if (data?.spoken_text) {
          let playedLocalTts = false;
          window.__ellmosTtsSpeaking = true;
          try {
            const ttsRes = await fetch('/api/voice/tts', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ text: data.spoken_text, language: lang }),
            });
            if (ttsRes.ok) {
              const ttsData = await ttsRes.json();
              if (ttsData?.audio_b64) {
                const audio = new Audio(`data:${ttsData.mime_type || 'audio/wav'};base64,${ttsData.audio_b64}`);
                await audio.play();
                playedLocalTts = true;
                await new Promise((resolve) => {
                  audio.onended = resolve;
                  audio.onerror = resolve;
                  setTimeout(resolve, 18000);
                });
              }
            }
          } catch (_) {}
          if (!playedLocalTts && 'speechSynthesis' in window) {
            try {
              window.speechSynthesis.cancel();
              const u = new SpeechSynthesisUtterance(data.spoken_text);
              u.lang = lang === 'en' ? 'en-US' : 'de-DE';
              await new Promise((resolve) => {
                u.onend = resolve;
                u.onerror = resolve;
                setTimeout(resolve, 12000);
                window.speechSynthesis.speak(u);
              });
            } catch (_) {}
          }
          window.__ellmosTtsSpeaking = false;
        }
        return data;
      } catch (_) {
        return null;
      }
    }

    async function ackHeaderTalkSummon(startListening) {
