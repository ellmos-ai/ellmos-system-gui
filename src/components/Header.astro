<script is:inline>
  async function refreshGuiBrand() {
    try {
      const response = await fetch('/api/gui/brand', { cache: 'no-store' });
      if (!response.ok) return;
      const state = await response.json();
      if (state.schema !== 'ellmos-system-gui.brand.v1') return;
      if (typeof state.label !== 'string' || typeof state.product !== 'string'
          || typeof state.logo_text !== 'string') return;
      const label = state.label.trim();
      const product = state.product.trim();
      if (!label || !product || label.length > 48 || product.length > 48) return;
      document.getElementById('gui-brand-label').textContent = label;
      document.querySelectorAll('[data-gui-brand-label]').forEach(el => { el.textContent = label; });
      document.querySelectorAll('[data-gui-brand-product]').forEach(el => { el.textContent = product; });
      document.title = document.title.replace(/ \| System GUI$/, '') + ' | ' + product;
      const icon = document.getElementById('gui-brand-icon');
      icon.textContent = state.logo_text;
      const img = document.getElementById('gui-brand-image');
      if (typeof state.logo_path === 'string' && /^\/static\/branding\/[A-Za-z0-9._/-]+\.(png|webp)$/.test(state.logo_path)
          && !state.logo_path.includes('..')) {
        img.onerror = () => { img.hidden = true; icon.hidden = false; };
        img.src = state.logo_path;
        img.hidden = false;
        icon.hidden = true;
      }
      if (!localStorage.getItem('bach-theme') && ['dark', 'light', 'ocean', 'warm'].includes(state.theme)) {
        applyTheme(state.theme, false);
      }
    } catch (_) {
      // The neutral shell remains usable when consumer metadata is unavailable.
    }
  }
  refreshGuiBrand();

  async function refreshBackendOriginBadge() {
    const badge = document.getElementById('backend-origin-badge');
    if (!badge) return;
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 5000);
    try {
      const response = await fetch('/api/gui/backend-origin', { cache: 'no-store', signal: controller.signal });
      if (!response.ok) throw new Error('Backend-Metadaten nicht erreichbar');
      const state = await response.json();
      const verified = state.connection_verified === true && state.schema_verified === true
        && state.instance_verified === true && state.adapter_binding_verified === true;
      if (verified && state.mode === 'server') {
        badge.textContent = 'Backend: Server';
      } else if (verified && state.mode === 'local') {
        badge.textContent = 'Backend: Lokal';
      } else {
        badge.textContent = 'Backend unbekannt';
      }
      badge.dataset.verified = String(verified && (state.mode === 'server' || state.mode === 'local'));
      badge.title = badge.dataset.verified === 'true' && state.instance_label
        ? `${state.instance_label} · geprüft ${state.observed_at || ''}` : 'Backendquelle nicht verifiziert';
    } catch (_) {
      badge.textContent = 'Offline · Backend unbekannt';
      badge.dataset.verified = 'false';
      badge.title = 'Backend-Metadaten nicht erreichbar; kein Cache belegt';
    } finally {
      clearTimeout(timeout);
    }
  }
  refreshBackendOriginBadge();
  setInterval(refreshBackendOriginBadge, 30000);

  // Theme Manager
  function applyTheme(theme, persist = true) {
    const root = document.documentElement;
    if (theme === 'dark') {
      root.removeAttribute('data-theme');
    } else {
      root.setAttribute('data-theme', theme);
    }
    if (persist) {
      localStorage.setItem('bach-theme', theme);
    }

    // Update button states
    document.querySelectorAll('.theme-btn').forEach(btn => {
      const selected = btn.getAttribute('data-theme') === theme;
      btn.classList.toggle('active', selected);
      btn.setAttribute('aria-pressed', String(selected));
    });
    const themeSelect = document.getElementById('theme-select');
    if (themeSelect && ['dark', 'light', 'ocean', 'warm', 'custom'].includes(theme)) {
      themeSelect.value = theme;
    }
  }
  window.applyTheme = applyTheme;

  // Initialize Theme
  const savedTheme = localStorage.getItem('bach-theme') || 'dark';
  applyTheme(savedTheme, false);

  // Wire Theme Buttons
  document.querySelectorAll('.theme-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const theme = btn.getAttribute('data-theme');
      if (theme) applyTheme(theme);
    });
  });

  // Navigation preset: Standard is the safe default; the choice is local to
  // this browser until a consumer-side preference contract exists.
  const validUiPresets = new Set(['standard', 'classic', 'ocean-bach-classic']);
  const uiPresetKey = 'bach-ui-preset';
  function normalizeUiPreset(value) {
    if (value === 'ocean-bach-classic') return 'classic';
    return validUiPresets.has(value) ? value : 'standard';
  }
  function applyUiPreset(value, persist = true) {
    const preset = normalizeUiPreset(value);
    document.documentElement.dataset.uiPreset = preset;
    document.querySelectorAll('[data-ui-preset]').forEach(panel => {
      const active = panel.dataset.uiPreset === preset;
      panel.hidden = !active;
      panel.setAttribute('aria-hidden', String(!active));
    });
    const label = document.querySelector('[data-nav-preset-label]');
    const activePanel = document.querySelector(`[data-ui-preset="${preset}"]`);
    if (label && activePanel?.dataset.navPresetLabelValue) {
      label.textContent = activePanel.dataset.navPresetLabelValue;
    }
    if (persist) localStorage.setItem(uiPresetKey, preset);
    window.dispatchEvent(new CustomEvent('bach-ui-preset-change', { detail: { preset } }));
    return preset;
  }
  window.bachUiPreset = {
    get: () => normalizeUiPreset(localStorage.getItem(uiPresetKey) || document.documentElement.dataset.uiPreset),
    set: (value, persist = true) => applyUiPreset(value, persist),
  };
  applyUiPreset(window.bachUiPreset.get(), false);

  const validUiIconStyles = new Set(['line', 'classic', 'emoji']);
  const uiIconStyleKey = 'bach-ui-icon-style';
  function normalizeUiIconStyle(value) {
    if (value === 'classic') return 'line';
    return validUiIconStyles.has(value) ? value : 'line';
  }
  function applyUiIconStyle(value, persist = true) {
    const iconStyle = normalizeUiIconStyle(value);
    document.documentElement.dataset.uiIconStyle = iconStyle;
    if (persist) localStorage.setItem(uiIconStyleKey, iconStyle);
    window.dispatchEvent(new CustomEvent('bach-ui-icon-style-change', { detail: { iconStyle } }));
    return iconStyle;
  }
  window.bachUiIconStyle = {
    get: () => normalizeUiIconStyle(localStorage.getItem(uiIconStyleKey) || document.documentElement.dataset.uiIconStyle),
    set: (value, persist = true) => applyUiIconStyle(value, persist),
  };
  applyUiIconStyle(window.bachUiIconStyle.get(), false);

  const validUiNavScopes = new Set(['compact', 'all', 'custom']);
  const uiNavScopeKey = 'bach-ui-nav-scope';
  function normalizeUiNavScope(value) {
    return validUiNavScopes.has(value) ? value : 'compact';
  }
  function applyUiNavScope(value, persist = true) {
    const navScope = normalizeUiNavScope(value);
    document.documentElement.dataset.uiNavScope = navScope;
    document.querySelectorAll('[data-nav-group]').forEach((group) => {
      if (navScope === 'all') {
        group.open = true;
      } else if (navScope === 'compact') {
        group.open = Boolean(group.querySelector('a.active'));
      }
    });
    if (persist) localStorage.setItem(uiNavScopeKey, navScope);
    window.dispatchEvent(new CustomEvent('bach-ui-nav-scope-change', { detail: { navScope } }));
    return navScope;
  }
  window.bachUiNavScope = {
    get: () => normalizeUiNavScope(localStorage.getItem(uiNavScopeKey) || document.documentElement.dataset.uiNavScope),
    set: (value, persist = true) => applyUiNavScope(value, persist),
  };
  applyUiNavScope(window.bachUiNavScope.get(), false);

  const validUiDensities = new Set(['compact', 'standard', 'spacious']);
  const uiDensityKey = 'bach-ui-density';
  function normalizeUiDensity(value) {
    return validUiDensities.has(value) ? value : 'standard';
  }
  function applyUiDensity(value, persist = true) {
    const density = normalizeUiDensity(value);
    document.documentElement.dataset.uiDensity = density;
    if (persist) localStorage.setItem(uiDensityKey, density);
    window.dispatchEvent(new CustomEvent('bach-ui-density-change', { detail: { density } }));
    return density;
  }
  window.bachUiDensity = {
    get: () => normalizeUiDensity(localStorage.getItem(uiDensityKey) || document.documentElement.dataset.uiDensity),
    set: (value, persist = true) => applyUiDensity(value, persist),
  };
  applyUiDensity(window.bachUiDensity.get(), false);

  // Keep the mobile navigation reachable without changing desktop navigation state.
  const navToggle = document.getElementById('nav-toggle');
  const sidebar = document.getElementById('app-sidebar');
  const sidebarClose = document.getElementById('sidebar-close');
  const backdrop = document.getElementById('sidebar-backdrop');
  const mobileNavigation = window.matchMedia('(max-width: 860px)');
  let mobileNavigationOpen = false;

  function syncSidebarMode() {
    if (!navToggle || !sidebar || !sidebarClose || !backdrop) return;
    // Main and footer may not have been parsed when this inline script ran.
    const backgroundShell = [
      document.querySelector('.skip-link'),
      document.getElementById('main-header'),
      document.getElementById('main-content'),
      document.querySelector('body > footer'),
    ].filter(Boolean);
    const mobile = mobileNavigation.matches;
    if (!mobile) {
      mobileNavigationOpen = false;
      sidebar.classList.remove('is-open');
      sidebar.inert = false;
      sidebar.removeAttribute('aria-hidden');
      sidebar.removeAttribute('aria-modal');
      sidebar.removeAttribute('role');
      backgroundShell.forEach((element) => { element.inert = false; });
      backdrop.hidden = true;
      navToggle.setAttribute('aria-expanded', 'false');
      navToggle.setAttribute('aria-label', 'Navigation öffnen');
      document.body.classList.remove('nav-open');
      return;
    }
    sidebar.classList.toggle('is-open', mobileNavigationOpen);
    sidebar.inert = !mobileNavigationOpen;
    sidebar.setAttribute('aria-hidden', String(!mobileNavigationOpen));
    backgroundShell.forEach((element) => { element.inert = mobileNavigationOpen; });
    if (mobileNavigationOpen) {
      sidebar.setAttribute('role', 'dialog');
      sidebar.setAttribute('aria-modal', 'true');
    } else {
      sidebar.removeAttribute('aria-modal');
      sidebar.removeAttribute('role');
    }
    backdrop.hidden = !mobileNavigationOpen;
    navToggle.setAttribute('aria-expanded', String(mobileNavigationOpen));
    navToggle.setAttribute('aria-label', mobileNavigationOpen ? 'Navigation schließen' : 'Navigation öffnen');
    document.body.classList.toggle('nav-open', mobileNavigationOpen);
  }

  function setMobileNavigationOpen(open, returnFocus = false) {
    if (!mobileNavigation.matches) return;
    mobileNavigationOpen = open;
    syncSidebarMode();
    if (open) {
      // Let the visibility transition start before moving focus into the drawer.
      requestAnimationFrame(() => requestAnimationFrame(() => {
        if (mobileNavigationOpen && mobileNavigation.matches)
          sidebarClose?.focus({ preventScroll: true });
      }));
    }
    else if (returnFocus) navToggle?.focus({ preventScroll: true });
  }

  navToggle?.addEventListener('click', () => setMobileNavigationOpen(!mobileNavigationOpen));
  backdrop?.addEventListener('click', () => setMobileNavigationOpen(false, true));
  sidebar?.addEventListener('click', (event) => {
    if (!mobileNavigation.matches) return;
    if (event.target.closest('#sidebar-close')) setMobileNavigationOpen(false, true);
    else if (event.target.closest('a[href]')) setMobileNavigationOpen(false, true);
  });

  function trapMobileNavigationTab(event) {
    if (event.key !== 'Tab' || !mobileNavigationOpen || !sidebar) return;
    const focusableElements = [...sidebar.querySelectorAll('button:not([disabled]), a[href], summary, [tabindex]:not([tabindex="-1"])')]
      .filter((element) => {
        if (element.closest('[inert], [hidden]')) return false;
        const closedDetails = element.closest('details:not([open])');
        return !closedDetails || element.matches('summary');
      });
    if (focusableElements.length === 0) {
      event.preventDefault();
      sidebarClose?.focus({ preventScroll: true });
      return;
    }
    const first = focusableElements[0];
    const last = focusableElements[focusableElements.length - 1];
    if (event.shiftKey && (document.activeElement === first || !sidebar.contains(document.activeElement))) {
      event.preventDefault();
      last.focus({ preventScroll: true });
    } else if (!event.shiftKey && (document.activeElement === last || !sidebar.contains(document.activeElement))) {
      event.preventDefault();
      first.focus({ preventScroll: true });
    }
  }

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileNavigationOpen) {
      setMobileNavigationOpen(false, true);
      return;
    }
    trapMobileNavigationTab(event);
  });
  mobileNavigation.addEventListener('change', syncSidebarMode);
  syncSidebarMode();

  function matchesCurrentNavigationRoute(href) {
    if (!href || href === '#') return false;
    const origin = window.location.origin;
    const target = new URL(href, origin);
    const current = new URL(window.location.href);
    const normalizePath = (value) => value.replace(/\/+$/, '') || '/';
    const querySignature = (value) => [...new URLSearchParams(value).entries()]
      .sort(([leftKey, leftValue], [rightKey, rightValue]) => leftKey.localeCompare(rightKey) || leftValue.localeCompare(rightValue))
      .map(([key, entry]) => `${encodeURIComponent(key)}=${encodeURIComponent(entry)}`)
      .join('&');
    if (normalizePath(target.pathname) === '/user-inbox'
        && normalizePath(current.pathname) === '/agenten/sessions'
        && current.searchParams.get('tab') === 'inbox') {
      return true;
    }
    return target.origin === origin
      && normalizePath(target.pathname) === normalizePath(current.pathname)
      && querySignature(target.search) === querySignature(current.search);
  }

  function refreshActiveNavigation() {
    document.querySelectorAll('.app-sidebar a[href]').forEach((link) => {
      const active = matchesCurrentNavigationRoute(link.getAttribute('href'));
      link.classList.toggle('active', active);
      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
    document.querySelectorAll('[data-nav-group]').forEach((group) => {
      const active = Boolean(group.querySelector('a.active'));
      group.classList.toggle('active', active);
      if (active) group.open = true;
    });
  }

  refreshActiveNavigation();
  window.addEventListener('popstate', refreshActiveNavigation);
  const domainPinsMenu = document.getElementById('domain-pins-menu');
  if (domainPinsMenu) new MutationObserver(refreshActiveNavigation).observe(domainPinsMenu, { childList: true, subtree: true });

  // ── ELLMOS Talk / Funkgerät Header Integration (Push-to-Talk, Pop-over, Pop-out & Modell-Summon) ──
  (function initHeaderTalkRadio() {
    const radioBtn = document.getElementById('header-talk-radio-btn');
    const popover = document.getElementById('header-talk-popover');
    const closeBtn = document.getElementById('header-talk-close-btn');
    const dot = document.getElementById('header-talk-dot');
    const btnLabel = document.getElementById('header-talk-btn-label');
    const miniOrb = document.getElementById('header-talk-mini-orb');
    const miniEmoji = document.getElementById('header-talk-mini-emoji');
    const stateText = document.getElementById('header-talk-state-text');
    const pttBtn = document.getElementById('header-talk-ptt-btn');
    const liveBtn = document.getElementById('header-talk-live-btn');
    const replyBox = document.getElementById('header-talk-reply-box');
    const personaSelect = document.getElementById('header-talk-persona');
    const opmodeSelect = document.getElementById('header-talk-opmode');
    const summonSelect = document.getElementById('header-talk-summon-policy');
    const popoutBtn = document.getElementById('header-talk-popout-btn');
    const summonBanner = document.getElementById('header-talk-summon-banner');
    const summonTitle = document.getElementById('header-talk-summon-title');
    const summonMsg = document.getElementById('header-talk-summon-msg');
    const summonAccept = document.getElementById('header-talk-summon-accept');
    const summonDismiss = document.getElementById('header-talk-summon-dismiss');

    let liveActive = false;

    function detectClientRuntime() {
      if (window.__TAURI__ || window.__TAURI_INTERNALS__) return 'tauri';
      if (new URLSearchParams(window.location.search).get('companion') === '1') return 'companion';
      if (window.matchMedia && window.matchMedia('(max-width: 768px), (pointer: coarse)').matches) return 'mobile';
      return 'browser';
    }

    function openCompanionPopout() {
      const tauriWv = window.__TAURI__?.webviewWindow?.WebviewWindow || window.__TAURI__?.window?.WebviewWindow;
      if (typeof tauriWv === 'function') {
        try {
          new tauriWv('ellmos-talk-companion', {
            url: '/talk?companion=1',
            title: 'ELLMOS Talk · Funkgerät & Begleiter',
            width: 430,
            height: 680,
            alwaysOnTop: true,
            resizable: true,
          });
          return;
        } catch (_) {}
      }
      window.open('/talk?companion=1', 'ellmos-talk-companion', 'width=430,height=680,menubar=no,toolbar=no,location=no,status=no,resizable=yes');
    }

    async function enumerateTalkDevices(requestPermission = false) {
      if (!navigator.mediaDevices || typeof navigator.mediaDevices.enumerateDevices !== 'function') return null;
      try {
        if (requestPermission && typeof navigator.mediaDevices.getUserMedia === 'function') {
          const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
          stream.getTracks().forEach((t) => t.stop());
        }
        const devices = await navigator.mediaDevices.enumerateDevices();
        const mics = devices.filter((d) => d.kind === 'audioinput');
        const speakers = devices.filter((d) => d.kind === 'audiooutput');
        const cameras = devices.filter((d) => d.kind === 'videoinput');
        const fillSelect = (ids, items, fallbackLabel) => {
          ids.forEach((id) => {
            const sel = document.getElementById(id);
            if (!sel) return;
            const prev = sel.value || 'default';
            sel.innerHTML = '';
            const defOpt = document.createElement('option');
            defOpt.value = 'default';
            defOpt.textContent = fallbackLabel;
            sel.appendChild(defOpt);
            items.forEach((d, idx) => {
              if (!d.deviceId || d.deviceId === 'default') return;
              const opt = document.createElement('option');
              opt.value = d.deviceId;
              opt.textContent = d.label || `${fallbackLabel} #${idx + 1}`;
              sel.appendChild(opt);
            });
            if ([...sel.options].some((o) => o.value === prev)) sel.value = prev;
          });
        };
        fillSelect(['header-talk-mic-select', 'running-talk-mic-device', 'talk-mic-device'], mics, 'Standard-Mikrofon');
        fillSelect(['header-talk-speaker-select', 'running-talk-speaker-device', 'talk-speaker-device'], speakers, 'Standard-Ausgabe');
        fillSelect(['running-talk-camera-device'], cameras, 'Standard-Kamera');
        return { mics, speakers, cameras };
      } catch (_) {
        return null;
      }
    }

    function applyTalkStateToHeader(cfg) {
      if (!cfg || typeof cfg !== 'object') return;
      window.__bachTalkConfig = cfg;
      const color = cfg.color_primary || '#00d4aa';
      if (miniOrb) {
        miniOrb.style.background = `radial-gradient(circle at 35% 35%, ${color}, #0f172a 75%)`;
        miniOrb.style.boxShadow = `0 0 16px ${color}88`;
      }
      if (miniEmoji && cfg.emoji_overlay) miniEmoji.textContent = cfg.emoji_overlay;
      if (personaSelect && cfg.persona) personaSelect.value = cfg.persona;
      if (opmodeSelect && cfg.operating_mode) opmodeSelect.value = cfg.operating_mode;
      if (summonSelect && cfg.summon_policy) summonSelect.value = cfg.summon_policy;

      const modeLabels = { ptt: 'Funkgerät · PTT', duplex: 'Live-Duplex aktiv', wake_word: `Wake-Word („${cfg.wake_word || 'Hey Buddha'}“)`, off: 'Ausgeschaltet' };
      if (stateText) {
        stateText.textContent = `${(cfg.persona || 'buddha').toUpperCase()} (${cfg.primary_model || 'buddha-default'}) · ${modeLabels[cfg.operating_mode] || 'Funkgerät'}`;
      }

      if (cfg.pending_summon && cfg.pending_summon.message) {
        const s = cfg.pending_summon;
        if (summonBanner) summonBanner.hidden = false;
        if (summonTitle) summonTitle.textContent = `📻 ${(s.caller || 'Modell').toUpperCase()} ruft über Funk`;
        if (summonMsg) summonMsg.textContent = s.message;
        if (dot) {
          dot.style.background = '#38bdf8';
          dot.style.boxShadow = '0 0 12px #38bdf8';
        }
        if (btnLabel) btnLabel.textContent = `Funk (${(s.caller || 'Anruf').toUpperCase()}!)`;
        if (s.auto_open && popover && popover.hidden) {
          popover.hidden = false;
          radioBtn?.setAttribute('aria-expanded', 'true');
        }
      } else {
        if (summonBanner) summonBanner.hidden = true;
        if (dot) {
          dot.style.background = cfg.operating_mode === 'off' ? '#64748b' : '#10b981';
          dot.style.boxShadow = cfg.operating_mode === 'off' ? 'none' : '0 0 8px rgba(16,185,129,0.6)';
        }
        if (btnLabel) btnLabel.textContent = 'Funk / Talk';
      }
      window.dispatchEvent(new CustomEvent('bach:talk-config-updated', { detail: cfg }));
    }

    async function loadHeaderTalkConfig() {
      try {
        const res = await fetch('/api/talk/config');
        if (!res.ok) return null;
        const data = await res.json();
        if (data && data.config) applyTalkStateToHeader(data.config);
        return data;
      } catch (_) {
        return null;
      }
    }

    async function updateHeaderTalkConfig(patch) {
      try {
        const res = await fetch('/api/talk/config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(patch),
        });
        if (!res.ok) return null;
        const data = await res.json();
        if (data && data.config) applyTalkStateToHeader(data.config);
        return data;
      } catch (_) {
        return null;
      }
    }

    async function sendHeaderTalkTurn(utterance) {
      if (!utterance) return null;
      try {
        const persona = personaSelect?.value || 'buddha';
        const lang = document.documentElement.lang || 'de';
        const res = await fetch('/api/talk/turn', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ user_utterance: utterance, persona, language: lang }),
        });
        if (!res.ok) return null;
        const data = await res.json();
        if (data && data.visual_state) applyTalkStateToHeader(data.visual_state);
        if (replyBox && data?.spoken_text) {
          replyBox.hidden = false;
          replyBox.textContent = data.spoken_text;
        }
        if (data?.spoken_text && 'speechSynthesis' in window) {
          try {
            window.speechSynthesis.cancel();
            const u = new SpeechSynthesisUtterance(data.spoken_text);
            u.lang = lang === 'en' ? 'en-US' : 'de-DE';
            window.speechSynthesis.speak(u);
          } catch (_) {}
        }
        return data;
      } catch (_) {
        return null;
      }
    }

    async function ackHeaderTalkSummon(startListening) {
      try {
        const res = await fetch('/api/talk/summon/ack', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ start_listening: Boolean(startListening) }),
        });
        if (!res.ok) return null;
        const data = await res.json();
        if (data && data.visual_state) applyTalkStateToHeader(data.visual_state);
        return data;
      } catch (_) {
        return null;
      }
    }

    window.bachLoadTalkConfig = loadHeaderTalkConfig;
    window.bachUpdateTalkConfig = updateHeaderTalkConfig;
    window.bachSendTalkTurn = sendHeaderTalkTurn;
    window.bachAckTalkSummon = ackHeaderTalkSummon;
    window.bachOpenTalkCompanion = openCompanionPopout;
    window.bachEnumerateTalkDevices = enumerateTalkDevices;
    window.bachDetectClientRuntime = detectClientRuntime;
    const runtimeBadge = document.getElementById('header-talk-runtime-badge');
    const rt = detectClientRuntime();
    if (runtimeBadge) {
      runtimeBadge.textContent = rt === 'tauri' ? '🖥️ Tauri' : (rt === 'mobile' ? '📱 Mobil' : '🌐 Browser');
    }
    const micSelect = document.getElementById('header-talk-mic-select');
    const speakerSelect = document.getElementById('header-talk-speaker-select');
    const refreshDevBtn = document.getElementById('header-talk-refresh-devices');
    micSelect?.addEventListener('change', () => updateHeaderTalkConfig({ input_device_id: micSelect.value }));
    speakerSelect?.addEventListener('change', () => updateHeaderTalkConfig({ output_device_id: speakerSelect.value }));
    refreshDevBtn?.addEventListener('click', () => enumerateTalkDevices(true));
    pttBtn?.addEventListener('touchstart', (e) => { e.preventDefault(); triggerSpeechCapture(); }, { passive: false });
    enumerateTalkDevices(false);

    radioBtn?.addEventListener('click', () => {
      if (!popover) return;
      const nextHidden = !popover.hidden;
      popover.hidden = nextHidden;
      radioBtn.setAttribute('aria-expanded', String(!nextHidden));
      if (!nextHidden) loadHeaderTalkConfig();
    });

    closeBtn?.addEventListener('click', () => {
      if (popover) popover.hidden = true;
      radioBtn?.setAttribute('aria-expanded', 'false');
    });

    popoutBtn?.addEventListener('click', () => {
      openCompanionPopout();
    });

    personaSelect?.addEventListener('change', () => {
      updateHeaderTalkConfig({ persona: personaSelect.value });
    });
    opmodeSelect?.addEventListener('change', () => {
      updateHeaderTalkConfig({ operating_mode: opmodeSelect.value });
    });
    summonSelect?.addEventListener('change', () => {
      updateHeaderTalkConfig({ summon_policy: summonSelect.value });
    });

    summonAccept?.addEventListener('click', async () => {
      const msg = summonMsg?.textContent || '';
      await ackHeaderTalkSummon(true);
      if (msg && 'speechSynthesis' in window) {
        try {
          const u = new SpeechSynthesisUtterance(msg);
          window.speechSynthesis.speak(u);
        } catch (_) {}
      }
    });
    summonDismiss?.addEventListener('click', () => {
      ackHeaderTalkSummon(false);
    });

    function triggerSpeechCapture() {
      const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (SR) {
        const rec = new SR();
        rec.lang = (document.documentElement.lang || 'de') === 'en' ? 'en-US' : 'de-DE';
        if (pttBtn) pttBtn.textContent = '🔴 Funkkanal offen — Sprich jetzt…';
        rec.onresult = (ev) => {
          const transcript = ev.results?.[0]?.[0]?.transcript || '';
          if (transcript) sendHeaderTalkTurn(transcript);
        };
        rec.onend = () => {
          if (pttBtn) pttBtn.textContent = '📻 Halten zum Sprechen (PTT)';
        };
        rec.start();
      } else {
        sendHeaderTalkTurn('Funkgerät-Statusabfrage: Bist du empfangsbereit?');
      }
    }

    pttBtn?.addEventListener('click', triggerSpeechCapture);
    liveBtn?.addEventListener('click', () => {
      liveActive = !liveActive;
      liveBtn.textContent = liveActive ? '⏹️ Duplex stoppen' : '🎙️ Freisprechen';
      updateHeaderTalkConfig({ operating_mode: liveActive ? 'duplex' : 'ptt', mode: liveActive ? 'listening' : 'idle' });
    });

    loadHeaderTalkConfig();
  })();
</script>

<script>
  import {initializeDomainMenu} from "../lib/domain-pins.mjs";
  import {initializeWorldI18n} from "../lib/i18n.mjs";
  initializeDomainMenu();
  initializeWorldI18n();
</script>
