    async function enumerateTalkDevices(requestPermission = false) {
      if (!navigator.mediaDevices || typeof navigator.mediaDevices.enumerateDevices !== 'function') return null;
      try {
        if (requestPermission && typeof navigator.mediaDevices.getUserMedia === 'function') {
          const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
          stream.getTracks().forEach((t) => t.stop());
        }
        const devices = await navigator.mediaDevices.enumerateDevices();
        const mics = devices.filter((d) => d.kind === 'audioinput');
        const speakers = devices.filter((d) => d.kind === 'audiooutput');
        const cameras = devices.filter((d) => d.kind === 'videoinput');
        const fillSelect = (ids, items, fallbackLabel) => {
          ids.forEach((id) => {
            const sel = document.getElementById(id);
            if (!sel) return;
            const prev = sel.value || 'default';
            sel.innerHTML = '';
            const defOpt = document.createElement('option');
            defOpt.value = 'default';
            defOpt.textContent = fallbackLabel;
            sel.appendChild(defOpt);
            items.forEach((d, idx) => {
              if (!d.deviceId || d.deviceId === 'default') return;
              const opt = document.createElement('option');
              opt.value = d.deviceId;
              opt.textContent = d.label || `${fallbackLabel} #${idx + 1}`;
              sel.appendChild(opt);
            });
            if ([...sel.options].some((o) => o.value === prev)) sel.value = prev;
          });
        };
        fillSelect(['header-talk-mic-select', 'running-talk-mic-device', 'talk-mic-device'], mics, 'Standard-Mikrofon');
        fillSelect(['header-talk-speaker-select', 'running-talk-speaker-device', 'talk-speaker-device'], speakers, 'Standard-Ausgabe');
        fillSelect(['running-talk-camera-device'], cameras, 'Standard-Kamera');
        return { mics, speakers, cameras };
      } catch (_) {
        return null;
      }
    }

    function syncSegmentedControls(persona, opmode) {
      personaPills.forEach((pill) => {
