function lineIconSvg(id: string): string {
  const inner = LINE_ICON_SVGS[id] || '<circle cx="12" cy="12" r="8"/>';
  return `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${inner}</svg>`;
}
---

<a class="skip-link" href="#main-content">Zum Inhalt springen</a>

<header class="main-header" id="main-header">
  <div class="header-left">
    <button
      class="nav-toggle"
      id="nav-toggle"
      type="button"
      aria-controls="app-sidebar"
      aria-expanded="false"
      aria-label="Navigation öffnen"
    >
      <span class="nav-toggle-icon" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
    <a href="/" class="logo">
      <span class="logo-icon" id="gui-brand-icon" aria-hidden="true">◆</span>
      <img id="gui-brand-image" alt="" hidden width="28" height="28" />
      <span class="logo-text" id="gui-brand-label">System GUI</span>
    </a>
    <span id="backend-origin-badge" class="backend-origin-badge" role="status" aria-live="polite">Backend unbekannt</span>
  </div>

  <div class="header-right">
    <!-- Feste Schnellzugriffe (Kalender, Kontakte & Hilfe immer erreichbar) -->
    <div class="quick-nav-actions">
      <a href="/life?tab=kalender" class="quick-action-btn" title="Kalender (Termine, Routinen & Aufgaben)" aria-label="Kalender">
        <span class="icon-glyph icon-glyph-line" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" focusable="false"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4M3 9h18"/></svg></span>
        <span class="icon-glyph icon-glyph-emoji" aria-hidden="true">📅</span>
      </a>
      <a href="/kontakte" class="quick-action-btn" title="Kontakte & Netzwerk" aria-label="Kontakte">
        <span class="icon-glyph icon-glyph-line" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" focusable="false"><circle cx="9" cy="8" r="3.5"/><path d="M3 19a6 6 0 0 1 12 0"/><circle cx="17" cy="9" r="2.5"/><path d="M16 19a4.5 4.5 0 0 1 5 0"/></svg></span>
        <span class="icon-glyph icon-glyph-emoji" aria-hidden="true">👥</span>
      </a>
      <a href="/help" class="quick-action-btn" title="Hilfe & Dokumentation" aria-label="Hilfe">
        <span class="icon-glyph icon-glyph-line" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 0 1 5 0c0 1.5-2.5 2-2.5 3.5M12 16.5h.01"/></svg></span>
        <span class="icon-glyph icon-glyph-emoji" aria-hidden="true">❓</span>
      </a>
    </div>

    <!-- ELLMOS Talk / Funkgerät Button + Pop-over (Push-to-Talk, Companion & Modell-Summon) -->
    <div class="header-talk-radio-wrap" id="header-talk-radio-wrap" style="position:relative;display:inline-flex;align-items:center;">
      <button
        id="header-talk-radio-btn"
        type="button"
        class="quick-action-btn"
        aria-expanded="false"
        aria-controls="header-talk-popover"
        title="ELLMOS Talk / Funkgerät — Klicken für Pop-over, Gedrückt halten für Push-to-Talk (Alt+Leertaste)"
        style="display:inline-flex;align-items:center;gap:0.35rem;padding:0.3rem 0.6rem;border-radius:var(--radius-sm);border:1px solid var(--border);background:var(--bg-card);color:var(--text);font-size:0.8rem;font-weight:600;cursor:pointer;position:relative;"
      >
        <span id="header-talk-dot" style="width:8px;height:8px;border-radius:50%;background:#10b981;display:inline-block;box-shadow:0 0 8px rgba(16,185,129,0.6);"></span>
        <span id="header-talk-icon" aria-hidden="true">📻</span>
        <span id="header-talk-btn-label">Funk / Talk</span>
      </button>

      <div
        id="header-talk-popover"
        role="dialog"
        aria-label="ELLMOS Talk & Funkgerät Steuerung"
        hidden
        style="position:absolute;top:calc(100% + 0.5rem);right:0;width:340px;z-index:1200;background:var(--bg-card, #111827);border:1px solid var(--border, #334155);border-radius:var(--radius-md, 12px);box-shadow:0 16px 40px rgba(0,0,0,0.45);padding:0.9rem;display:flex;flex-direction:column;gap:0.75rem;"
      >
        <div style="display:flex;justify-content:space-between;align-items:center;gap:0.5rem;">
          <div style="display:flex;align-items:center;gap:0.45rem;">
            <div id="header-talk-mini-orb" style="width:34px;height:34px;border-radius:50%;background:radial-gradient(circle at 35% 35%, #00d4aa, #0f172a 75%);box-shadow:0 0 16px rgba(0,212,170,0.45);display:flex;align-items:center;justify-content:center;font-size:1.1rem;">
              <span id="header-talk-mini-emoji">🧘</span>
            </div>
            <div>
              <strong style="font-size:0.88rem;display:flex;align-items:center;gap:0.4rem;">ELLMOS Talk · Funkgerät <span id="header-talk-runtime-badge" class="badge" style="font-size:0.65rem;padding:0.1rem 0.38rem;">🌐 Browser</span></strong>
              <small id="header-talk-state-text" style="font-size:0.74rem;color:var(--text-muted);">Bereit · Push-to-Talk aktiv</small>
            </div>
          </div>
          <button type="button" id="header-talk-close-btn" class="btn btn-sm" aria-label="Funkgerät-Pop-over schließen" style="padding:0.15rem 0.45rem;">×</button>
        </div>

        <!-- Incoming Model Summon Banner (shown when a model initiates a talk call) -->
        <div id="header-talk-summon-banner" hidden style="padding:0.6rem;border-radius:8px;background:rgba(56,189,248,0.14);border:1px solid #38bdf8;display:flex;flex-direction:column;gap:0.45rem;">
          <strong id="header-talk-summon-title" style="font-size:0.8rem;color:#38bdf8;">📻 Modell-Funkspruch eingehend</strong>
          <p id="header-talk-summon-msg" style="margin:0;font-size:0.78rem;color:var(--text);">Ein Modell möchte mit dir sprechen.</p>
          <div style="display:flex;gap:0.4rem;">
            <button type="button" id="header-talk-summon-accept" class="btn btn-sm btn-primary" style="flex:1;">🎙️ Annehmen</button>
            <button type="button" id="header-talk-summon-dismiss" class="btn btn-sm" style="flex:1;">Später</button>
          </div>
        </div>

        <!-- Push-to-Talk & Live Duplex Controls -->
        <div style="display:flex;gap:0.45rem;">
          <button
            type="button"
            id="header-talk-ptt-btn"
            class="btn btn-primary"
            style="flex:1.3;font-size:0.8rem;padding:0.5rem;"
            title="Gedrückt halten zum Einsprechen (oder Klicken für Kurzdiktat)"
          >
            📻 Halten zum Sprechen (PTT)
          </button>
          <button
            type="button"
            id="header-talk-live-btn"
            class="btn btn-secondary"
            style="flex:1;font-size:0.8rem;padding:0.5rem;"
          >
            🎙️ Freisprechen
          </button>
        </div>

        <div id="header-talk-reply-box" hidden style="padding:0.5rem 0.65rem;border-radius:8px;background:var(--bg-dark, #0f172a);border:1px solid var(--border);font-size:0.78rem;color:var(--text);"></div>

        <!-- Quick Switchers (synced with Living & Running & BACH Tray) -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem;font-size:0.76rem;">
          <label style="display:flex;flex-direction:column;gap:0.2rem;">
            <span style="color:var(--text-muted);">Angebundenes Modell:</span>
            <select id="header-talk-persona" class="lang-switcher" style="width:100%;">
              <option value="buddha">🧘 Buddha (Lokal)</option>
              <option value="claude">🟣 Claude</option>
              <option value="gemini">🔵 Gemini</option>
              <option value="codex">🟢 Codex / GPT</option>
            </select>
          </label>
          <label style="display:flex;flex-direction:column;gap:0.2rem;">
            <span style="color:var(--text-muted);">Betriebsmodus:</span>
            <select id="header-talk-opmode" class="lang-switcher" style="width:100%;">
              <option value="ptt">📻 Funkgerät (PTT)</option>
              <option value="duplex">🎙️ Live-Duplex</option>
              <option value="wake_word">👂 Wake-Word</option>
              <option value="off">⏸️ Aus</option>
            </select>
          </label>
        </div>

        <label style="display:flex;flex-direction:column;gap:0.2rem;font-size:0.76rem;">
          <span style="color:var(--text-muted);">Modell-Eigenstart (Agent Summon):</span>
          <select id="header-talk-summon-policy" class="lang-switcher" style="width:100%;">
            <option value="knock">🔔 Funkgerät-Anklopfen im Header</option>
            <option value="auto_popup">⚡ Auto-Popup (bei Präsenz via Sensation)</option>
            <option value="muted">🔕 Stumm (Kein Modell-Eigenstart)</option>
          </select>
        </label>

        <!-- Multi-Device Audio Input / Output Selection (Browser, Mobil & Tauri) -->
        <div style="display:grid;grid-template-columns:1fr 1fr auto;gap:0.4rem;align-items:end;font-size:0.74rem;">
          <label style="display:flex;flex-direction:column;gap:0.18rem;">
            <span style="color:var(--text-muted);">🎤 Mikrofon:</span>
            <select id="header-talk-mic-select" class="lang-switcher" style="width:100%;">
              <option value="default">Standard-Mikrofon</option>
            </select>
          </label>
          <label style="display:flex;flex-direction:column;gap:0.18rem;">
            <span style="color:var(--text-muted);">🔊 Lautsprecher:</span>
            <select id="header-talk-speaker-select" class="lang-switcher" style="width:100%;">
              <option value="default">Standard-Ausgabe</option>
            </select>
          </label>
          <button type="button" id="header-talk-refresh-devices" class="btn btn-sm" title="Audio- & Kamerageräte neu erkennen" style="padding:0.35rem 0.5rem;">🔄</button>
        </div>

        <!-- Actions: Detachable Companion Pop-out & Living & Running Slot Settings -->
        <div style="display:flex;justify-content:space-between;align-items:center;gap:0.4rem;padding-top:0.35rem;border-top:1px solid var(--border);">
          <button
            type="button"
            id="header-talk-popout-btn"
            class="btn btn-sm"
            style="font-size:0.75rem;"
            title="Öffnet ELLMOS Talk als eigenständiges, schwebendes Begleitfenster"
          >
            ↗ Eigenes Fenster
          </button>
          <a
            href="/agenten/running#talk-slot"
            class="btn btn-sm"
            style="font-size:0.75rem;text-decoration:none;"
            title="Modell-Slot, Fast-Relay-Modell & Betrieb in Living & Running umstellen"
          >
            ⚡ Living &amp; Running ↗
          </a>
        </div>
      </div>
    </div>

    <!-- World Language Pack Switcher -->
    <select id="lang-switcher" class="lang-switcher" aria-label="Sprache wählen / Select language" title="World Language Pack (10 Sprachen)">
      <option value="de">🇩🇪 DE</option>
      <option value="en">🇬🇧 EN</option>
      <option value="es">🇪🇸 ES</option>
      <option value="fr">🇫🇷 FR</option>
      <option value="zh">🇨🇳 ZH</option>
      <option value="ja">🇯🇵 JA</option>
      <option value="ru">🇷🇺 RU</option>
      <option value="ar">🇸🇦 AR</option>
      <option value="pt">🇵🇹 PT</option>
      <option value="hi">🇮🇳 HI</option>
    </select>

    <!-- Theme Switcher -->
    <div class="theme-switcher" id="theme-switcher" role="group" aria-label="Farbschema">
      <button class="theme-btn" data-theme="dark" aria-label="Dunkler Modus" title="Dunkler Modus (Dark)" type="button"><span class="icon-glyph icon-glyph-line" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></span><span class="icon-glyph icon-glyph-emoji" aria-hidden="true">🌙</span></button>
      <button class="theme-btn" data-theme="light" aria-label="Heller Modus" title="Heller Modus (Light)" type="button"><span class="icon-glyph icon-glyph-line" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" focusable="false"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg></span><span class="icon-glyph icon-glyph-emoji" aria-hidden="true">☀️</span></button>
      <button class="theme-btn" data-theme="ocean" aria-label="Ozean Modus" title="Ozean Modus (Ocean)" type="button"><span class="icon-glyph icon-glyph-line" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M2 9c2-2 4-2 6 0s4 2 6 0 4-2 6 0M2 15c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/></svg></span><span class="icon-glyph icon-glyph-emoji" aria-hidden="true">🌊</span></button>
