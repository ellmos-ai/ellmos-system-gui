---
// Header.astro - Shared shell and route navigation for BACH & OCEAN
import navConfig from "../config/nav_config.json";
import talkHandmicImg from "../assets/talk-handmic-comic.jpg";

interface Props {
  currentPath?: string;
  currentSearch?: string;
}

const { currentPath = "/", currentSearch = "" } = Astro.props;
const defaultPreset = navConfig.default_preset || "standard";
const presetEntries = Object.entries(navConfig.presets || {});

function matchesNavigationHref(href: string, pathname: string, search: string) {
  if (!href || href === "#") return false;
  const origin = "https://gui.invalid";
  const target = new URL(href, origin);
  const current = new URL(pathname || "/", origin);
  if (search && !current.search) current.search = search;
  const normalizePath = (value: string) => value.replace(/\/+$/, "") || "/";
  const querySignature = (value: string) => [...new URLSearchParams(value).entries()]
    .sort(([leftKey, leftValue], [rightKey, rightValue]) => leftKey.localeCompare(rightKey) || leftValue.localeCompare(rightValue))
    .map(([key, entry]) => `${encodeURIComponent(key)}=${encodeURIComponent(entry)}`)
    .join("&");
  return target.origin === origin
    && normalizePath(target.pathname) === normalizePath(current.pathname)
    && querySignature(target.search) === querySignature(current.search);
}

function isActive(href: string) {
  return matchesNavigationHref(href, currentPath, currentSearch);
}

function hasActiveItem(item: any): boolean {
  return Boolean(item.href && isActive(item.href))
    || Boolean(item.children?.some((child: any) => hasActiveItem(child)));
}

function hasActiveSection(section: any): boolean {
  return Boolean(section.items?.some((item: any) => hasActiveItem(item)));
}

const LINE_ICON_SVGS: Record<string, string> = {
  start: '<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5.5v-6h-5v6H4a1 1 0 0 1-1-1z"/>',
