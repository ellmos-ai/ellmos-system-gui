      await sendHeaderTalkTurn(val);
    });

    let activePttRecorder = null;
    let activeDuplexStream = null;
    let activeDuplexRecorder = null;

    function isMeaningfulTranscript(text) {
      const cleaned = String(text || '').trim();
      if (cleaned.length < 2) return false;
      const lower = cleaned.toLowerCase();
      const hallucinations = [
        'untertitel',
        'amara.org',
        'vielen dank für\'s zuschauen',
        'vielen dank fürs zuschauen',
        'thank you for watching',
        'subtitles by',
        'copyright',
      ];
      return !hallucinations.some((h) => lower.includes(h));
    }

    async function transcribeAudioBlob(blob) {
      const b64 = await new Promise((resolve) => {
        const reader = new FileReader();
        reader.onloadend = () => resolve(String(reader.result || '').split(',')[1] || '');
        reader.readAsDataURL(blob);
      });
      if (!b64) return '';
      const lang = document.documentElement.lang || 'de';
      const sttRes = await fetch('/api/voice/stt', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ audio_b64: b64, suffix: '.webm', language: lang }),
      });
      if (!sttRes.ok) return '';
      const sttData = await sttRes.json();
      return String(sttData?.text || '').trim();
    }

    function fallbackWebSpeechCapture() {
      const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SR) {
        if (replyBox) {
          replyBox.hidden = false;
          replyBox.textContent = '⚠️ Kein Mikrofon gefunden — bitte Mikrofon-Zugriff erlauben oder unten Text eingeben.';
        }
        quickInput?.focus();
        return;
      }
      try {
        const rec = new SR();
        rec.lang = (document.documentElement.lang || 'de') === 'en' ? 'en-US' : 'de-DE';
        pttBtn?.classList.add('is-recording');
        if (pttLabel) pttLabel.textContent = '🔴 Kanal offen — Sprich jetzt…';
        let gotResult = false;
        rec.onresult = (ev) => {
          const transcript = ev.results?.[0]?.[0]?.transcript || '';
          if (transcript.trim()) {
            gotResult = true;
            sendHeaderTalkTurn(transcript.trim());
          }
        };
        rec.onend = () => {
          pttBtn?.classList.remove('is-recording');
          if (pttLabel) pttLabel.textContent = '📻 Funkspruch senden (PTT)';
          if (!gotResult && replyBox) {
            replyBox.hidden = false;
            replyBox.textContent = 'ℹ️ Keine Sprache erkannt — bitte noch einmal sprechen oder Text unten eingeben.';
          }
        };
        rec.onerror = () => {
          pttBtn?.classList.remove('is-recording');
          if (pttLabel) pttLabel.textContent = '📻 Funkspruch senden (PTT)';
          if (replyBox) {
            replyBox.hidden = false;
            replyBox.textContent = '⚠️ Browser-Spracherkennung nicht verfügbar — bitte Mikrofon erlauben oder Textfeld nutzen.';
          }
        };
        rec.start();
      } catch (_) {
        pttBtn?.classList.remove('is-recording');
        if (pttLabel) pttLabel.textContent = '📻 Funkspruch senden (PTT)';
      }
    }

    async function triggerSpeechCapture() {
      if (activePttRecorder && activePttRecorder.state === 'recording') {
        activePttRecorder.stop();
        return;
      }
      if (!navigator.mediaDevices || typeof navigator.mediaDevices.getUserMedia !== 'function' || typeof window.MediaRecorder !== 'function') {
        return fallbackWebSpeechCapture();
      }
      try {
        const micId = micSelect?.value;
        const audioConstraint = micId ? { deviceId: { exact: micId } } : true;
        const stream = await navigator.mediaDevices.getUserMedia({ audio: audioConstraint });
        const chunks = [];
        const recorder = new MediaRecorder(stream);
        activePttRecorder = recorder;
        pttBtn?.classList.add('is-recording');
        if (pttLabel) pttLabel.textContent = '🔴 Sprich jetzt (Klick = Senden)…';
        if (replyBox) {
          replyBox.hidden = false;
          replyBox.textContent = '🎙️ Mikrofon offen — sprich jetzt deinen Funkspruch (Klick auf PTT sendet sofort)…';
        }
        recorder.ondataavailable = (e) => { if (e.data && e.data.size > 0) chunks.push(e.data); };
        recorder.onstop = async () => {
          activePttRecorder = null;
          stream.getTracks().forEach((t) => t.stop());
          pttBtn?.classList.remove('is-recording');
          if (pttLabel) pttLabel.textContent = '📻 Funkspruch senden (PTT)';
          if (replyBox) {
            replyBox.hidden = false;
            replyBox.textContent = '⏳ Transkribiere Funkspruch (Whisper)…';
          }
          try {
            const blob = new Blob(chunks, { type: recorder.mimeType || 'audio/webm' });
            const transcript = await transcribeAudioBlob(blob);
            if (isMeaningfulTranscript(transcript)) {
              await sendHeaderTalkTurn(transcript);
            } else if (replyBox) {
              replyBox.hidden = false;
              replyBox.textContent = 'ℹ️ Keine deutliche Sprache erkannt — bitte noch einmal sprechen oder Text unten eingeben.';
            }
          } catch (_) {
            if (replyBox) {
              replyBox.hidden = false;
              replyBox.textContent = '⚠️ STT-Übertragung fehlgeschlagen — bitte erneut versuchen.';
            }
          }
        };
        recorder.start();
        setTimeout(() => { if (recorder.state === 'recording') recorder.stop(); }, 5000);
      } catch (_) {
        activePttRecorder = null;
        pttBtn?.classList.remove('is-recording');
        if (pttLabel) pttLabel.textContent = '📻 Funkspruch senden (PTT)';
        fallbackWebSpeechCapture();
      }
    }

    function stopHeaderDuplexLoop() {
      liveActive = false;
      if (liveBtn) {
        liveBtn.classList.remove('is-active');
        liveBtn.textContent = '🎙️ Duplex';
      }
      try {
        if (activeDuplexRecorder && activeDuplexRecorder.state === 'recording') {
          activeDuplexRecorder.stop();
        }
      } catch (_) {}
      activeDuplexRecorder = null;
      if (activeDuplexStream) {
        try {
          activeDuplexStream.getTracks().forEach((t) => t.stop());
        } catch (_) {}
        activeDuplexStream = null;
      }
    }

    async function runHeaderDuplexLoop() {
      if (!navigator.mediaDevices || typeof navigator.mediaDevices.getUserMedia !== 'function' || typeof window.MediaRecorder !== 'function') {
        if (replyBox) {
          replyBox.hidden = false;
          replyBox.textContent = '⚠️ Live-Duplex benötigt Mikrofon-Freigabe im Browser.';
        }
        stopHeaderDuplexLoop();
        return;
      }
      try {
        const micId = micSelect?.value;
        const audioConstraint = micId ? { deviceId: { exact: micId } } : true;
        activeDuplexStream = await navigator.mediaDevices.getUserMedia({ audio: audioConstraint });
        if (replyBox) {
          replyBox.hidden = false;
          replyBox.textContent = '🎙️ Live-Duplex aktiv — ich höre kontinuierlich zu…';
        }
        while (liveActive && activeDuplexStream) {
          if (window.__ellmosTtsSpeaking) {
            await new Promise((r) => setTimeout(r, 350));
            continue;
          }
          const chunkBlob = await new Promise((resolve) => {
            if (!liveActive || !activeDuplexStream) return resolve(null);
            const chunks = [];
            let rec;
            try {
              rec = new MediaRecorder(activeDuplexStream);
            } catch (_) {
              return resolve(null);
            }
            activeDuplexRecorder = rec;
            rec.ondataavailable = (e) => { if (e.data && e.data.size > 0) chunks.push(e.data); };
            rec.onstop = () => resolve(new Blob(chunks, { type: rec.mimeType || 'audio/webm' }));
            rec.onerror = () => resolve(null);
            rec.start();
            setTimeout(() => {
              if (rec.state === 'recording') rec.stop();
            }, 4000);
          });
          if (!liveActive || !chunkBlob || chunkBlob.size < 800) continue;
          const text = await transcribeAudioBlob(chunkBlob);
          if (liveActive && isMeaningfulTranscript(text)) {
            await sendHeaderTalkTurn(text);
          }
        }
      } catch (_) {
        if (replyBox) {
          replyBox.hidden = false;
          replyBox.textContent = '⚠️ Mikrofon-Zugriff für Live-Duplex nicht möglich — bitte Berechtigung prüfen.';
        }
      } finally {
        stopHeaderDuplexLoop();
      }
    }

    pttBtn?.addEventListener('click', triggerSpeechCapture);
    pttBtn?.addEventListener('touchstart', (e) => { e.preventDefault(); triggerSpeechCapture(); }, { passive: false });
    liveBtn?.addEventListener('click', () => {
      if (liveActive) {
        stopHeaderDuplexLoop();
        updateHeaderTalkConfig({ operating_mode: 'ptt', mode: 'idle' });
      } else {
        liveActive = true;
        liveBtn.classList.add('is-active');
        liveBtn.textContent = '⏹️ Stopp';
        updateHeaderTalkConfig({ operating_mode: 'duplex', mode: 'listening' });
        runHeaderDuplexLoop();
      }
    });

    loadHeaderTalkConfig();
  })();

  // ── Universeller <VoiceMicButton /> (ellmos-voice-io Direkt-Diktat via /api/voice/stt) ──
  (function initUniversalVoiceMicButtons() {
    if (window.__ellmosVoiceMicInstalled) return;
    window.__ellmosVoiceMicInstalled = true;

    const TARGET_SELECTOR = [
      "textarea:not([data-no-voice-mic])",
      "input[data-chat-input]",
      "#chat-input",
      "#utteranceInput",
      "#header-talk-quick-input",
      "#tasks-search",
      ".task-create-dialog input[name='title']",
      "#notes-search-input",
      "#note-title-input",
      "#note-tag-input",
      "#prompt-library input[data-part='search']",
      "#prompt-library input[name='name']",
      ".chat-input",
      ".prompt-input",
    ].join(", ");

    function appendTranscriptToElement(el, transcript) {
      const clean = String(transcript || "").trim();
      if (!el || !clean) return;
      const cur = String(el.value || "");
      el.value = cur && !cur.endsWith(" ") ? `${cur} ${clean}` : `${cur}${clean}`;
      el.dispatchEvent(new Event("input", { bubbles: true }));
      el.dispatchEvent(new Event("change", { bubbles: true }));
      try { el.focus(); } catch (_) {}
    }

    async function dictateViaBackendStt(el, btn, statusEl) {
      const lang = (document.documentElement.lang || "de") === "en" ? "en" : "de";
      if (!navigator.mediaDevices || typeof navigator.mediaDevices.getUserMedia !== "function" || typeof window.MediaRecorder !== "function") {
        if (statusEl) statusEl.textContent = "Kein Audio-Eingabegerät verfügbar — öffne ELLMOS Talk (/talk)…";
        window.open("/talk?companion=1", "ellmos-talk-companion", "width=430,height=680");
        return;
      }
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        const chunks = [];
        const recorder = new MediaRecorder(stream);
        const origText = btn ? btn.textContent : "🎤";
        if (btn) {
          btn.dataset.recording = "1";
          btn.textContent = "🔴 3s…";
          btn.setAttribute("aria-pressed", "true");
        }
        if (statusEl) statusEl.textContent = "🎙️ Aufnahme läuft (lokales STT /api/voice/stt)…";
        recorder.ondataavailable = (ev) => {
          if (ev.data && ev.data.size > 0) chunks.push(ev.data);
        };
        recorder.onstop = async () => {
          stream.getTracks().forEach((t) => t.stop());
          if (btn) {
            delete btn.dataset.recording;
            btn.textContent = "⏳";
            btn.setAttribute("aria-pressed", "false");
          }
          try {
            const blob = new Blob(chunks, { type: recorder.mimeType || "audio/webm" });
            const b64 = await new Promise((resolve) => {
              const reader = new FileReader();
              reader.onloadend = () => resolve(String(reader.result || "").split(",")[1] || "");
              reader.readAsDataURL(blob);
            });
            if (b64) {
              const res = await fetch("/api/voice/stt", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ audio_b64: b64, suffix: ".webm", language: lang }),
              });
              if (res.ok) {
                const data = await res.json();
                if (data?.text?.trim()) {
                  appendTranscriptToElement(el, data.text.trim());
                  if (statusEl) statusEl.textContent = `✅ Diktat übernommen (${data.backend || "ellmos-voice-io"}).`;
                } else if (statusEl) {
                  statusEl.textContent = "ℹ️ Keine Sprache erkannt.";
                }
              }
            }
          } catch (_) {
            if (statusEl) statusEl.textContent = "⚠️ STT-Übertragung fehlgeschlagen.";
          } finally {
            if (btn) btn.textContent = origText;
          }
        };
        recorder.start();
        setTimeout(() => {
          if (recorder.state === "recording") recorder.stop();
        }, 3500);
      } catch (_) {
        if (btn) {
          delete btn.dataset.recording;
          btn.setAttribute("aria-pressed", "false");
        }
        if (statusEl) statusEl.textContent = "⚠️ Mikrofonzugriff verweigert oder nicht verfügbar.";
      }
    }

    function dictateIntoElement(el, btn, statusEl) {
      if (!el) return;
      const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (SR) {
        try {
          const rec = new SR();
          rec.lang = (document.documentElement.lang || "de") === "en" ? "en-US" : "de-DE";
          rec.continuous = false;
          rec.interimResults = false;
          const origText = btn ? btn.textContent : "🎤";
          if (btn) {
            btn.dataset.recording = "1";
            btn.textContent = "🔴";
            btn.setAttribute("aria-pressed", "true");
          }
          if (statusEl) statusEl.textContent = "🎙️ Höre zu (Diktat aktiv)…";
          rec.onresult = (ev) => {
            const t = ev.results?.[0]?.[0]?.transcript || "";
            if (t) {
              appendTranscriptToElement(el, t);
              if (statusEl) statusEl.textContent = "✅ Diktat übernommen.";
            }
          };
          rec.onend = () => {
            if (btn) {
              delete btn.dataset.recording;
              btn.textContent = origText;
              btn.setAttribute("aria-pressed", "false");
            }
          };
          rec.onerror = () => {
            if (btn) {
              delete btn.dataset.recording;
              btn.textContent = origText;
              btn.setAttribute("aria-pressed", "false");
            }
            dictateViaBackendStt(el, btn, statusEl);
          };
          rec.start();
          return;
        } catch (_) {}
      }
      dictateViaBackendStt(el, btn, statusEl);
    }

    function enhanceVoiceMicInputs(root = document) {
      if (!root || typeof root.querySelectorAll !== "function") return 0;
      let count = 0;
      const nodes = root.querySelectorAll(TARGET_SELECTOR);
      nodes.forEach((el) => {
        if (el.dataset.ellmosVoiceEnhanced === "1") return;
        el.dataset.ellmosVoiceEnhanced = "1";
        if (el.id === "chat-input" && document.getElementById("voice-dictate-btn")) {
          const existingChatBtn = document.getElementById("voice-dictate-btn");
          existingChatBtn.classList.add("ellmos-voice-mic-btn");
          existingChatBtn.dataset.voiceMicTarget = "chat-input";
          count++;
          return;
        }
        const parent = el.parentElement;
        if (!parent) return;
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "ellmos-voice-mic-btn";
        btn.dataset.voiceMicBtn = "true";
        btn.setAttribute("aria-label", "Spracheingabe / Direkt-Diktat (/api/voice/stt)");
        btn.setAttribute("aria-pressed", "false");
        btn.title = "Direkt-Diktat per Mikrofon (/api/voice/stt · ellmos-voice-io)";
        btn.textContent = "🎤";
        btn.style.cssText =
          "display:inline-flex;align-items:center;justify-content:center;min-height:30px;min-width:32px;padding:0.2rem 0.5rem;margin-left:0.35rem;border-radius:8px;cursor:pointer;border:1px solid rgba(56,189,248,0.35);background:rgba(15,23,42,0.78);color:#e2e8f0;font-size:0.82rem;line-height:1;vertical-align:middle;flex-shrink:0;";
        btn.addEventListener("click", (ev) => {
          ev.preventDefault();
          ev.stopPropagation();
          dictateIntoElement(el, btn, null);
        });
        if (el.nextSibling) {
          parent.insertBefore(btn, el.nextSibling);
        } else {
          parent.appendChild(btn);
        }
        count++;
      });
      return count;
    }

    window.bachDictateIntoElement = dictateIntoElement;
    window.bachDictateViaBackendStt = dictateViaBackendStt;
    window.bachEnhanceVoiceMicInputs = enhanceVoiceMicInputs;

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => enhanceVoiceMicInputs(document));
    } else {
      enhanceVoiceMicInputs(document);
    }

    if (typeof MutationObserver === "function" && document.body) {
      let scheduled = false;
      const obs = new MutationObserver(() => {
        if (scheduled) return;
        scheduled = true;
        requestAnimationFrame(() => {
          scheduled = false;
          enhanceVoiceMicInputs(document);
        });
      });
      obs.observe(document.body, { childList: true, subtree: true });
    }
  })();
</script>

