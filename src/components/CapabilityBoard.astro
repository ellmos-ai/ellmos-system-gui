---
import {TICKET_SYMBOL_URLS} from '../lib/ticket-symbol-assets.mjs';
import '../styles/ticket-symbols.css';
interface Props { board: 'skills' | 'plugins' | 'mcp' | 'software' | 'ocean' }
const {board} = Astro.props;
const titles = {skills:'Skill-Zentrale',plugins:'Plugins',mcp:'MCP-Connections',software:'Software',ocean:'Ocean'};
const descriptions = {
  skills:'Aktuelle Anleitungen lesen, anpassen und mit ihrer Historie vergleichen.',
  plugins:'Plugin-Bibliotheken und Installationen deiner Agenten-Clients.',
  mcp:'Serverkonfiguration deiner Agenten-Clients und passende Rezeptbücher.',
  software:'Eigenständige Anwendungen aus dem Software-Katalog.',
  ocean:'Module und Repository-Quellen dieses Hosts.',
};
const tabs = [
  {board:'plugins',label:'Plugins',href:'/skills/plugins'},
  {board:'mcp',label:'MCP-Connections',href:'/skills/mcp'},
  {board:'skills',label:'Skill-Zentrale',href:'/skills'},
  {board:'software',label:'Software',href:'/skills/software'},
  {board:'ocean',label:'Ocean',href:'/skills/ocean'},
];
---
<section id="capability-board" data-board={board} data-ticket-symbols={JSON.stringify(TICKET_SYMBOL_URLS)}>
  {board === 'ocean' && <p class="text-muted">Module und Quellen finden · <a href="/system?tab=ocean">Ocean-Modulschaltplan in System öffnen ↗</a></p>}
  <header class="board-heading">
    <div><p class="board-eyebrow">Skills & Software</p><h1>{titles[board]}</h1><p>{descriptions[board]}</p></div>
    <div class="board-actions" id="board-actions">
      {board === 'skills' && <button type="button" class="btn btn-primary" id="skill-create">+ Neuer Skill</button>}
      <button type="button" class="btn" id="board-refresh">Aktualisieren</button>
    </div>
  </header>
  <nav class="board-tabs" aria-label="Skills & Software">
    {tabs.map(tab=><a href={tab.href} class:list={['board-tab', {active:tab.board===board}]} aria-current={tab.board===board?'page':undefined}>{tab.label}</a>)}
  </nav>
  {board==='skills' && <div class="skills-tabs" role="tablist" aria-label="Skill-Zentrale">
    <button type="button" role="tab" id="tab-anleitungen" data-skills-tab="anleitungen" aria-controls="skills-panel" aria-selected="true">Anleitungen</button>
    <button type="button" role="tab" id="tab-zuordnung" data-skills-tab="zuordnung" aria-controls="assignment-panel" aria-selected="false" tabindex="-1">Zuordnung</button>
  </div>}
  <div id="skills-panel" role={board==='skills'?'tabpanel':undefined} aria-labelledby={board==='skills'?'tab-anleitungen':undefined}>
  {board==='software' && <p class="processing-guide">Deterministische Verarbeitung: Software · Leichte und mittlere Aufgaben: lokale Modelle · Schwere Aufgaben: externe Modelle</p>}
  <div class="board-toolbar">
    <label class="board-search">Suchen<input type="search" id="board-search" placeholder="Name oder Beschreibung" autocomplete="off" /></label>
    {board==='skills' && <label>Kategorie<select id="board-category"><option value="">Alle Kategorien</option></select></label>}
    <span id="board-count" class="badge">Quelle wird geladen …</span>
  </div>
  <p id="board-status" role="status" aria-live="polite">Einträge werden geladen …</p>
  <div id="board-items" class="board-grid"></div>
  {board==='mcp' && <section class="recipe-section" aria-labelledby="recipes-title">
    <header><div><h2 id="recipes-title">Rezeptbibliothek</h2><p>Anleitungen für den Einsatz der MCP-Werkzeuge.</p></div></header>
    <div id="recipe-books" class="recipe-shelf"></div>
    <p id="recipe-status" role="status"></p>
  </section>}
  {board!=='skills' && <details class="board-sources"><summary>Quellen dieses Hosts</summary><div id="board-sources"></div></details>}
  </div>
  {board==='skills' && <section id="assignment-panel" role="tabpanel" aria-labelledby="tab-zuordnung" hidden>
    <p class="as-muted">Welche Experten, Skills, Dienste und Workflows gehören zu welchem Agenten. Gespeichert wird in der Datenbank des verbundenen Systems; die Zuordnung in der Agenten-Werkstatt bleibt der Hauptweg, dieser Tab ist der zusätzliche.</p>
    <div data-part="view" role="status" hidden></div>
    <div data-part="workspace" hidden>
      <div class="as-toolbar">
        <label>Agent<select data-part="agent"></select></label>
        <label class="as-search">Suchen<input type="search" data-part="filter" placeholder="Name oder Kennung" autocomplete="off" /></label>
        <button type="button" class="btn" data-part="reload">Neu laden</button>
      </div>
      <div data-part="readonly" hidden></div>
      <div data-part="groups"></div>
      <div class="as-actions">
        <button type="button" class="btn btn-primary" data-part="review">Änderung prüfen</button>
        <button type="button" class="btn" data-part="reset">Änderungen verwerfen</button>
      </div>
      <div data-part="preview" class="as-preview" hidden></div>
    </div>
    <p data-part="status" role="status" aria-live="polite" class="as-muted"></p>
  </section>}
</section>
<dialog id="skill-editor" class="board-dialog" aria-labelledby="skill-editor-title">
  <div class="dialog-heading"><div><p class="board-eyebrow">SKILL.md</p><h2 id="skill-editor-title">Skill bearbeiten</h2></div><button class="btn" type="button" id="skill-close" aria-label="Schließen">✕</button></div>
  <label>Kennung<input id="skill-id" type="text" maxlength="80" pattern="[A-Za-z0-9][A-Za-z0-9._\-]{0,79}" required /></label>
  <p id="skill-source-info"></p>
  <label>Fassung als Vorlage<select id="skill-history"><option value="">Aktuelle Fassung</option></select></label>
  <label>Symbol aus Ticket-Master<div id="skill-symbols" class="symbol-picker"></div></label>
  <label>Anleitung<textarea id="skill-content" rows="18" spellcheck="false"></textarea></label>
  <p class="editor-note">Die Versionsnummer steht im Kopf der Anleitung. Frühere Fassungen bleiben erhalten. Agenten mit einer älteren Skill-Bindung müssen nach einer Änderung neu eingerichtet werden.</p>
  <p id="skill-editor-status" role="status" aria-live="polite"></p>
  <div class="dialog-actions"><button type="button" class="btn" id="skill-reload">Aktuelle Fassung laden</button><button type="button" class="btn btn-primary" id="skill-save" disabled>Speichern</button></div>
</dialog>
<dialog id="recipe-editor" class="board-dialog" aria-labelledby="recipe-title">
  <div class="dialog-heading"><h2 id="recipe-title">Rezeptbuch</h2><button type="button" class="btn" id="recipe-close" aria-label="Schließen">✕</button></div>
  <p id="recipe-description"></p><div id="recipe-content"></div>
</dialog>
<style>
  .board-heading,.dialog-heading,.board-actions,.board-toolbar,.dialog-actions {display:flex;align-items:center;gap:1rem;justify-content:space-between;flex-wrap:wrap}
  .board-heading {margin-bottom:1.6rem}.board-heading h1 {font-size:1.9rem;margin:.25rem 0;font-weight:800}
  .board-heading p,.recipe-section p,.editor-note,#skill-source-info {color:var(--text-muted);font-size:.88rem;line-height:1.5}
  .board-eyebrow {font-size:.7rem!important;letter-spacing:.14em;text-transform:uppercase;margin:0}
  .board-tabs {display:flex;gap:.3rem;padding:.35rem;background:var(--bg-panel);border:1px solid var(--border);border-radius:var(--radius-md);flex-wrap:wrap}
  .board-tab {padding:.7rem 1.1rem;color:var(--text-muted);text-decoration:none;border-radius:var(--radius-sm);font-size:.85rem;font-weight:600}
  .board-tab.active {background:var(--bg-card);color:var(--accent-text);box-shadow:var(--shadow-sm)}
  .board-toolbar {justify-content:flex-start;margin:1.4rem 0}.board-search {flex:1;min-width:200px}
  label {display:flex;flex-direction:column;gap:.4rem;font-size:.8rem;color:var(--text-muted)}
  input,select,textarea {background:var(--bg-card);color:var(--text);border:1px solid var(--border);border-radius:var(--radius-sm);padding:.65rem;font:inherit}
  .board-grid {display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,270px),1fr));gap:1rem}
  .board-grid :global(.capability-card) {padding:1.15rem;display:flex;flex-direction:column;gap:.6rem;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-md);min-width:0}
  .board-grid :global(h3) {margin:0;font-size:1rem;overflow-wrap:anywhere}.board-grid :global(p) {font-size:.84rem;line-height:1.5;color:var(--text-muted);margin:0}
  .board-grid :global(.card-meta) {display:flex;gap:.4rem;flex-wrap:wrap}.board-grid :global(.card-action) {margin-top:auto;align-self:flex-start}
  .board-grid :global(.card-caption) {font-size:.75rem;color:var(--text-muted);overflow-wrap:anywhere}
  .board-grid :global(details) {font-size:.76rem;color:var(--text-muted);overflow-wrap:anywhere}
  .board-dialog {padding:1.5rem;color:var(--text);background:var(--bg-panel);border:1px solid var(--border);border-radius:var(--radius-md);width:min(920px,94vw);max-height:88vh;box-sizing:border-box}
  .board-dialog::backdrop {background:rgba(0,0,0,.65);backdrop-filter:blur(5px)}
  .board-dialog h2 {font-size:1.25rem;margin:0}.board-dialog label {margin:1rem 0}.board-dialog textarea {width:100%;box-sizing:border-box;font-family:var(--font-mono,monospace);font-size:.85rem;line-height:1.55;resize:vertical}
  .dialog-actions {justify-content:flex-end}.editor-note {max-width:75ch}
  .board-sources {margin-top:1.5rem;color:var(--text-muted);font-size:.8rem}.board-sources :global(p) {overflow-wrap:anywhere}
  .recipe-section {margin-top:2.3rem}.recipe-section h2 {font-size:1.25rem;margin-bottom:.3rem}
  .recipe-shelf {display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,240px),1fr));gap:1rem;border-bottom:7px solid var(--border);padding:1rem 0}
  .recipe-shelf :global(.recipe-book) {padding:1.25rem 1rem;border:1px solid var(--border);border-left:9px solid var(--accent);border-radius:5px 12px 12px 5px;background:var(--bg-card);color:var(--text);text-align:left;cursor:pointer;min-height:160px;display:flex;flex-direction:column;gap:.8rem;box-shadow:var(--shadow-sm)}
  .recipe-shelf :global(.recipe-book:hover) {border-color:var(--accent);transform:translateY(-2px)}.recipe-shelf :global(strong) {font-size:.95rem}.recipe-shelf :global(small) {color:var(--text-muted)}
  #recipe-content :global(article) {padding:1rem;border:1px solid var(--border);border-radius:var(--radius-sm);margin:1rem 0}
  #recipe-content :global(pre) {white-space:pre-wrap;overflow-wrap:anywhere;font-size:.85rem;background:var(--bg-dark);padding:.8rem}
  #recipe-content :global(.copy-status) {font-size:.75rem;color:var(--text-muted)}
  .board-grid :global(.plug-state) {display:flex;flex-direction:column;gap:.35rem;padding:.55rem .65rem;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--bg-dark);--plug-color:color-mix(in srgb,var(--text-muted) 45%,var(--text))}
  .board-grid :global(.plug-state[data-state="plugged"]) {--plug-color:color-mix(in srgb,var(--success) 50%,var(--text))}
  .board-grid :global(.plug-state[data-state="unknown"]) {--plug-color:color-mix(in srgb,var(--warning) 50%,var(--text))}
  .board-grid :global(.plug-state[data-state="error"]) {--plug-color:color-mix(in srgb,var(--error) 55%,var(--text))}
  .board-grid :global(.plug-headline) {color:var(--text);font-size:.85rem;line-height:1.35}
  .board-grid :global(.plug-graphic) {width:100%;max-width:150px;height:auto}
  .board-grid :global(.plug-cable) {fill:none;stroke:var(--plug-color);stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
  .board-grid :global(.plug-body) {fill:var(--bg-card);stroke:var(--plug-color);stroke-width:2}
  .board-grid :global(.plug-socket) {fill:var(--bg-card);stroke:var(--plug-color);stroke-width:2}
  .board-grid :global(.plug-slot) {fill:var(--plug-color)}
  .board-grid :global(.plug-led) {fill:none;stroke:var(--plug-color);stroke-width:1.4}
  .board-grid :global(.plug-state[data-state="plugged"] .plug-led) {fill:var(--plug-color)}
  .board-grid :global(.plug-dashed) {stroke-dasharray:4 3}
  .board-grid :global(.plug-mark) {fill:var(--plug-color);font-size:12px;font-weight:700}
  .board-grid :global(.plug-evidence summary) {cursor:pointer;color:var(--text)}
  .board-grid :global(.plug-evidence summary:focus-visible) {outline:2px solid var(--accent);outline-offset:2px}
  .board-grid :global(.plug-evidence p) {margin:.3rem 0 0;color:var(--text-muted)}
</style>
<style is:global>
  .skills-tabs {display:flex;gap:.3rem;margin:1.2rem 0 0;flex-wrap:wrap}
  .skills-tabs button {background:transparent;color:var(--text-muted);border:0;border-bottom:3px solid transparent;padding:.6rem 1rem;font:inherit;font-weight:600;cursor:pointer}
  .skills-tabs button[aria-selected="true"] {color:var(--text);border-bottom-color:var(--accent)}
  .skills-tabs button:focus-visible {outline:2px solid var(--accent);outline-offset:2px}
  #assignment-panel {margin-top:1.2rem}
  #assignment-panel [hidden],#board-actions[hidden],#skills-panel[hidden] {display:none!important}
  .as-muted {color:var(--text-muted);font-size:.85rem;line-height:1.5}
  .as-problem {color:var(--error-text);font-size:.88rem;line-height:1.5;overflow-wrap:anywhere}
  .as-toolbar,.as-actions {display:flex;gap:1rem;align-items:flex-end;flex-wrap:wrap;margin:1rem 0}
  .as-toolbar label {min-width:0}.as-toolbar select {max-width:100%}.as-search {flex:1;min-width:180px}
  .as-group {margin:1.2rem 0;padding:1rem;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-md)}
  .as-group h3 {margin:0 0 .6rem;font-size:1rem}.as-group h4 {margin:.2rem 0 .4rem;font-size:.82rem;color:var(--text-muted)}
  .as-cols {display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:1rem}
  .as-list {list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.35rem;min-height:2rem}
  .as-item {display:flex;gap:.6rem;align-items:center;flex-wrap:wrap;padding:.4rem .5rem;background:var(--bg-dark);border:1px solid var(--border);border-radius:var(--radius-sm)}
  .as-item[draggable="true"] {cursor:grab}.as-name {flex:1;min-width:0;overflow-wrap:anywhere;color:var(--text)}.as-id {font-size:.72rem;overflow-wrap:anywhere}
  .as-preview {margin-top:1rem;padding:1rem;border:1px solid var(--border);border-radius:var(--radius-md);background:var(--bg-card)}
  .as-preview ul {padding-left:1.2rem}.as-added {color:var(--success-text)}.as-removed {color:var(--error-text)}
  .as-preview .btn {margin:.4rem .6rem .2rem 0}
  #assignment-panel button:focus-visible,#assignment-panel select:focus-visible,#assignment-panel input:focus-visible {outline:2px solid var(--accent);outline-offset:2px}
  #assignment-panel button:disabled {opacity:1;color:var(--text-muted);background:var(--bg-dark);background-image:none;border:1px solid var(--border);cursor:not-allowed}
</style>
<script>
  import '../lib/capability-board-ui.mjs';
  import '../lib/hierarchy-assignment-ui.mjs';
</script>
