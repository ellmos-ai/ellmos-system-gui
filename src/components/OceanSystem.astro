---
// System/Ocean: Architektur und Betrieb (#2017 Schaltplan/Gesamtschaltplan, #2019 Satelliten).
// Data: GET /api/capabilities/catalog (bach.catalog.v1) + the authored (declared) architecture in src/data.
---
<section id="ocean-system" aria-labelledby="os-title">
  <header class="os-head">
    <div>
      <p class="os-eyebrow">System</p>
      <h1 id="os-title">Ocean: Architektur und Betrieb</h1>
      <p class="os-muted">Dieselben Katalogdaten in drei Ansichten. Deklarierte Architektur und Messwerte sind getrennt gekennzeichnet.</p>
    </div>
    <button type="button" class="btn" data-part="refresh">Aktualisieren</button>
  </header>
  <nav class="os-tabs" data-part="tabs" aria-label="Ocean-Ansichten"></nav>
  <p data-part="status" role="status" aria-live="polite" class="os-muted">Katalog wird geladen …</p>
  <div data-part="content"></div>
</section>
<style>
  #ocean-system {--os-gap:1rem;--os-muted-c:var(--text-muted)}
  /* colorful/custom: --text-muted is only 3.9-4.4:1 on cards and elevated surfaces, so muted text uses --text there */
  :global([data-theme="colorful"]) #ocean-system, :global([data-theme="custom"]) #ocean-system {--os-muted-c:var(--text)}
  .os-head {display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.2rem}
  #ocean-system h1 {font-size:1.9rem;margin:.25rem 0;font-weight:800}
  .os-eyebrow {font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--os-muted-c);margin:0}
  .os-tabs {display:flex;gap:.3rem;padding:.35rem;background:var(--bg-panel);border:1px solid var(--border);border-radius:var(--radius-md);flex-wrap:wrap}
  :global(.os-tab) {padding:.7rem 1.1rem;color:var(--os-muted-c);text-decoration:none;border-radius:var(--radius-sm);font-size:.85rem;font-weight:600}
  :global(.os-tab.active) {background:var(--bg-card);color:var(--text);box-shadow:inset 0 -3px 0 var(--accent)}
  #ocean-system :global(.os-panel a) {color:var(--accent);text-decoration:underline}
  #ocean-system :global(.os-muted) {color:var(--os-muted-c);font-size:.84rem;margin:.25rem 0;line-height:1.5}
  #ocean-system :global(.os-problem) {color:var(--text);font-size:.9rem;border-left:4px solid var(--error);padding-left:.6rem}
  #ocean-system :global(.os-toolbar) {display:flex;gap:1rem;align-items:flex-end;flex-wrap:wrap;margin:1.1rem 0 .7rem}
  #ocean-system :global(label) {display:flex;flex-direction:column;gap:.35rem;font-size:.8rem;color:var(--os-muted-c);min-width:min(100%,200px)}
  #ocean-system :global(.os-check) {flex-direction:row;align-items:center;min-width:0}
  #ocean-system :global(input), #ocean-system :global(select) {background:var(--bg-card);color:var(--text);border:1px solid var(--border);border-radius:var(--radius-sm);padding:.55rem;font:inherit}
  #ocean-system :global(input[type=checkbox]) {padding:0}
  #ocean-system :global(.os-kpi) {display:flex;gap:.5rem;flex-wrap:wrap;margin-left:auto}
  #ocean-system :global(.os-badge) {display:inline-block;padding:.12rem .55rem;border:1px solid var(--border-hover);border-radius:999px;font-size:.74rem;background:var(--bg-elevated);color:var(--text)}
  #ocean-system :global(.os-unknown) {border-style:dashed;color:var(--os-muted-c)}
  #ocean-system :global(.os-bad) {border-color:var(--error)}
  #ocean-system :global(.os-hit) {border-color:var(--accent);font-weight:700}
  #ocean-system :global(.os-pills) {display:flex;gap:.4rem;flex-wrap:wrap;margin:.4rem 0 .8rem}
  #ocean-system :global(.os-pill) {padding:.3rem .8rem;border:1px solid var(--border-hover);border-radius:999px;background:var(--bg-card);color:var(--text);font:inherit;font-size:.8rem;cursor:pointer}
  #ocean-system :global(.os-pill.on) {background:var(--accent);color:var(--on-accent);border-color:var(--accent)}
  /* Schaltplan */
  #ocean-system :global(.os-layout) {display:flex;gap:1rem;align-items:flex-start}
  #ocean-system :global(.os-boardwrap) {flex:1 1 auto;min-width:0;position:relative;padding:.5rem}
  #ocean-system :global(.os-board) {position:relative;display:grid;gap:1.6rem 1.8rem;grid-template-columns:1.1fr 1.1fr 1fr .95fr;
    grid-template-areas:"runtime runtime connectors connectors" "orchestration control tools tools" "memory knowledge sync sync" "domains domains quality meta" "unassigned unassigned unassigned unassigned"}
  #ocean-system :global(.os-zone) {position:relative;z-index:2;background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:.8rem .9rem 1rem;min-width:0}
  #ocean-system :global(.os-zone.hot) {border-color:var(--accent)}
  #ocean-system :global(.os-zone[data-area=runtime]) {grid-area:runtime}
  #ocean-system :global(.os-zone[data-area=connectors]) {grid-area:connectors}
  #ocean-system :global(.os-zone[data-area=orchestration]) {grid-area:orchestration}
  #ocean-system :global(.os-zone[data-area=control]) {grid-area:control}
  #ocean-system :global(.os-zone[data-area=tools]) {grid-area:tools}
  #ocean-system :global(.os-zone[data-area=memory]) {grid-area:memory}
  #ocean-system :global(.os-zone[data-area=knowledge]) {grid-area:knowledge}
  #ocean-system :global(.os-zone[data-area=sync]) {grid-area:sync}
  #ocean-system :global(.os-zone[data-area=domains]) {grid-area:domains}
  #ocean-system :global(.os-zone[data-area=quality]) {grid-area:quality}
  #ocean-system :global(.os-zone[data-area=meta]) {grid-area:meta}
  #ocean-system :global(.os-zone[data-area=_unassigned]) {grid-area:unassigned}
  #ocean-system :global(.os-zone h4) {margin:0;font-size:.95rem;display:flex;gap:.5rem;align-items:center;flex-wrap:wrap}
  #ocean-system :global(.os-ic) {display:inline-flex;width:2rem;height:2rem;align-items:center;justify-content:center;background:var(--bg-elevated);border-radius:8px}
  #ocean-system :global(.os-ttl) {color:var(--text);font-weight:700}
  #ocean-system :global(.os-q) {color:var(--os-muted-c);font-size:.78rem;margin:.3rem 0 0}
  #ocean-system :global(.os-mods) {display:flex;flex-wrap:wrap;gap:.4rem;margin-top:.7rem}
  #ocean-system :global(.os-mod) {display:inline-flex;align-items:center;gap:.4rem;background:var(--bg-elevated);color:var(--text);border:1px solid var(--border-hover);border-radius:7px;padding:.25rem .55rem;font:inherit;font-size:.78rem;cursor:pointer}
  #ocean-system :global(.os-mod.pinned) {border-color:var(--accent);box-shadow:0 0 0 2px var(--accent-glow)}
  #ocean-system :global(.os-mod.dim) {opacity:.4}
  #ocean-system :global(.os-led) {width:.55rem;height:.55rem;border-radius:50%;background:var(--os-muted-c);flex:0 0 auto}
  #ocean-system :global(.os-led-ok) {background:var(--success)}
  #ocean-system :global(.os-led-dev) {background:var(--warning)}
  #ocean-system :global(.os-led-plan), #ocean-system :global(.os-led-unknown) {background:transparent;border:2px solid var(--os-muted-c)}
  #ocean-system :global(.os-lock) {font-size:.66rem;color:var(--os-muted-c)}
  #ocean-system :global(.os-wires) {position:absolute;inset:0;pointer-events:none;overflow:visible;z-index:1}
  #ocean-system :global(.os-wire) {stroke:var(--os-muted-c);stroke-width:2;opacity:.7;stroke-dasharray:6 4}
  #ocean-system :global(.os-wire.hot) {stroke:var(--accent);stroke-width:2.6;opacity:1;stroke-dasharray:none}
  #ocean-system :global(.os-wlabel) {position:absolute;transform:translate(-50%,-50%);background:var(--bg-panel);border:1px solid var(--border-hover);color:var(--text);font-size:.7rem;padding:.1rem .5rem;border-radius:999px;pointer-events:none;white-space:nowrap;z-index:3}
  #ocean-system :global(.os-wlabel.hot) {border-color:var(--accent)}
  #ocean-system :global(.os-panel) {flex:0 0 320px;max-width:320px;background:var(--bg-panel);border:1px solid var(--border);border-radius:var(--radius-md);padding:1rem;position:sticky;top:5rem;max-height:80vh;overflow:auto}
  #ocean-system :global(.os-panel h4) {margin:0 0 .4rem;overflow-wrap:anywhere}
  #ocean-system :global(.os-panel h5) {margin:.8rem 0 .3rem;font-size:.75rem;letter-spacing:.06em;text-transform:uppercase;color:var(--os-muted-c)}
  #ocean-system :global(.os-panel ul) {padding-left:1.1rem;font-size:.84rem}
  #ocean-system :global(.os-panel code), #ocean-system :global(.os-wiring code) {font-size:.76rem;background:var(--bg-elevated);padding:.05rem .3rem;border-radius:4px;overflow-wrap:anywhere}
  #ocean-system :global(.os-meta) {display:flex;gap:.4rem;flex-wrap:wrap}
  #ocean-system :global(.os-desc) {font-size:.88rem;line-height:1.5}
  #ocean-system :global(.os-layers) {margin-top:2rem}
  #ocean-system :global(.os-stack) {display:flex;flex-wrap:wrap;gap:.6rem}
  #ocean-system :global(.os-layer) {flex:1 1 170px;background:var(--bg-card);border:1px solid var(--border);border-radius:9px;padding:.7rem .85rem}
  /* Gesamtschaltplan + Satelliten */
  #ocean-system :global(.os-columns) {display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));gap:1rem}
  #ocean-system :global(.os-col) {background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-md);padding:.9rem;min-width:0}
  #ocean-system :global(.os-col h4), #ocean-system :global(.os-wiring h4) {margin:0 0 .6rem;font-size:.95rem}
  #ocean-system :global(.os-entry) {padding:.45rem 0;border-top:1px dashed var(--border)}
  #ocean-system :global(.os-wiring) {margin-top:1.6rem}
  #ocean-system :global(.os-wiring ul) {font-size:.84rem;padding-left:1.1rem}
  #ocean-system :global(.os-scroll) {overflow-x:auto}
  #ocean-system :global(.os-table) {width:100%;border-collapse:collapse;font-size:.84rem}
  #ocean-system :global(.os-table th), #ocean-system :global(.os-table td) {text-align:left;vertical-align:top;padding:.55rem .6rem;border-bottom:1px solid var(--border)}
  #ocean-system :global(.os-table th) {color:var(--os-muted-c);font-size:.75rem;text-transform:uppercase;letter-spacing:.05em}
  @media (max-width:1100px) {#ocean-system :global(.os-layout) {flex-direction:column}#ocean-system :global(.os-panel) {position:static;max-width:none;flex:auto;width:100%;box-sizing:border-box;max-height:none}}
  @media (max-width:860px) {#ocean-system :global(.os-board) {grid-template-columns:1fr;grid-template-areas:none}
    #ocean-system :global(.os-zone) {grid-area:auto!important}#ocean-system :global(.os-wires), #ocean-system :global(.os-wlabel) {display:none}#ocean-system :global(.os-kpi) {margin-left:0}}
</style>
<script>
  import '../lib/ocean-system-ui.mjs';
</script>
