---
// src/pages/governance/index.astro - Governance Control Room: Kennzahlen und Verweise auf die Teilbereiche (B-12)
import BachLayout from "../../layouts/BachLayout.astro";
import "../../styles/governance.css";
---

<BachLayout title="Governance CONTROL" currentPath="/governance">
  <div data-source="governance-status">
    <header class="gov-head">
      <div>
        <h1>🛡️ Governance Control Room</h1>
        <p>Übersicht über Regeln, Sperren, Schutzmechanismen und Berechtigungen. Jeder Bereich hat eine eigene Seite; diese Übersicht zeigt nur den Stand und führt dorthin.</p>
      </div>
      <span class="badge" id="governance-status-badge" style="font-size:0.85rem;padding:0.4rem 0.8rem;">● Durchsetzung nicht geprüft</span>
    </header>
    <p id="gov-status-meta" role="status" aria-live="polite" class="gov-state" style="font-size:.78rem;color:var(--text-muted)"></p>

    <section class="gov-cards" aria-label="Governance-Bereiche">
      <a class="gov-card" href="/governance/regeln">
        <h2>📜 Regeln &amp; Entscheidungen</h2>
        <p>Entscheidungsregister, Policies, Policy-Registry und wirksame Policy je Scope.</p>
        <span class="badge" id="decisions-count-badge">Entscheidungen nicht geprüft</span>
      </a>
      <a class="gov-card" href="/governance/sperren">
        <h2>🔒 Sperren</h2>
        <p>Aktive Locks aus dem Lock-Scan. Ein fehlender oder veralteter Scan ist keine Schreibfreigabe.</p>
        <span class="badge" id="locks-count-badge">Lock-Feed nicht geprüft</span>
      </a>
      <a class="gov-card" href="/governance/hooks">
        <h2>🪝 Hooks &amp; Guards</h2>
        <p>Schutzskripte, die das Backend tatsächlich vorfindet.</p>
        <span class="badge" id="hooks-count-badge">Hooks nicht geprüft</span>
      </a>
      <a class="gov-card" href="/governance/rechte">
        <h2>🗝️ Autorität &amp; Erlaubnisse</h2>
        <p>Erlaubnis-Raster für Handlungen mit Außenwirkung, je Akteur.</p>
        <span class="badge" id="authority-count-badge">Raster nicht geprüft</span>
      </a>
      <a class="gov-card" href="/governance/funk">
        <h2>📻 Agentenfunk</h2>
        <p>Nachrichten und Signale zwischen Agenten. Zustellung wird nicht gemessen.</p>
        <span class="badge">Zustellung nicht geprüft</span>
      </a>
      <a class="gov-card" href="/governance/logs">
        <h2>📊 Logs &amp; Audit</h2>
        <p>Änderungen an Aufgaben aus der BACH-Datenbank, ohne Inhalte und ohne verifizierte Akteursidentität.</p>
        <span class="badge">Aufgaben-Audit</span>
      </a>
    </section>

    <section class="card" aria-labelledby="gov-cap-title" style="margin-bottom:1rem">
      <h2 id="gov-cap-title" class="card-title">Capabilities und Herkunft</h2>
      <p>Kit-Prüfung, registrierter Adapter und Laufzeitstatus werden getrennt ausgewiesen.
        Diese optionale Abfrage hat einen eigenen Zeitpunkt.</p>
      <button type="button" class="btn btn-sm" id="gov-cap-reload">Capabilities neu laden</button>
      <p id="gov-cap-state" role="status" aria-live="polite" class="gov-state"></p>
      <dl id="gov-cap-meta" class="gov-meta"></dl>
      <details id="gov-cap-response" hidden><summary>Vollständige Capabilities-Antwort</summary><pre id="gov-cap-json"></pre></details>
    </section>
  </div>

  <script is:inline>
    // Alte Adressen /governance?tab=… führen zu den Teilseiten (B-12); Lesezeichen bleiben gültig.
    (function () {
      var tab = new URLSearchParams(location.search).get("tab");
      var targets = {locks: "/governance/sperren", hooks: "/governance/hooks", authority: "/governance/rechte",
        decisions: "/governance/regeln", policies: "/governance/regeln", registry: "/governance/regeln", effective: "/governance/regeln"};
      if (!Object.prototype.hasOwnProperty.call(targets, tab)) return;
      var rest = new URLSearchParams(location.search);
      if (targets[tab] !== "/governance/regeln") rest.delete("tab");
      var query = rest.toString();
      location.replace(targets[tab] + (query ? "?" + query : ""));
    })();
  </script>

  <script>
    import {loadStatus, mountCapabilities} from "../../scripts/governance-reader.mjs";
    import {parseHooks, parsePermissionMatrix} from "../../lib/governance-readers.mjs";
    import {createGovernanceRequest} from "../../lib/governance-request.mjs";

    mountCapabilities();
    loadStatus();

    function figure(id, describe) {
      const target = document.getElementById(id);
      return result => {
        if (result.state === "loading") target.textContent = "wird gelesen …";
        else if (result.model) target.textContent = describe(result.model);
        else target.textContent = result.failure?.label || result.label || "unbekannt";
      };
    }
    createGovernanceRequest(figure("hooks-count-badge", model =>
      model.hooks.length + " Guard-Dateien gefunden" + (model.available ? "" : " (Backend meldet: nicht verfügbar)")))
      .load("/api/governance/hooks", parseHooks, (_url, {signal}) => fetch("/api/governance/hooks", {method: "GET", cache: "no-store", signal}), () => "ok");
    createGovernanceRequest(figure("authority-count-badge", model =>
      model.actions.length + " Handlungen × " + model.actors.length + " Akteure (Raster v" + (model.revision ?? "unbekannt") + ")"))
      .load("/api/governance/permission-matrix", parsePermissionMatrix, (_url, {signal}) => fetch("/api/governance/permission-matrix", {method: "GET", cache: "no-store", signal}), () => "ok");
  </script>
</BachLayout>
