---
// src/pages/governance/regeln.astro - Regeln & Entscheidungen: Register, Policies, Registry, wirksame Policy (B-12)
import BachLayout from "../../layouts/BachLayout.astro";
import "../../styles/governance.css";
---

<BachLayout title="Regeln & Entscheidungen | Governance" currentPath="/governance/regeln">
  <div data-source="policy-registry">
  <header class="gov-head">
    <div>
      <h1>📜 Regeln &amp; Entscheidungen</h1>
      <p>Entscheidungsregister, Policies und Policy-Registry aus der verbundenen Registry. Diese Ansicht schreibt nicht; eine Quellenprüfung belegt keine Durchsetzung.</p>
    </div>
    <span class="badge" id="governance-status-badge" style="font-size:0.85rem;padding:0.4rem 0.8rem;">● Durchsetzung nicht geprüft</span>
  </header>

  <div role="tablist" aria-label="Regeln und Entscheidungen" id="gov-tablist" class="gov-tabs">
    <a role="tab" id="tab-status" href="/governance/regeln?tab=status" data-tab="status" aria-controls="gov-panel-status">Überblick</a>
    <a role="tab" id="tab-decisions" href="/governance/regeln?tab=decisions" data-tab="decisions" aria-controls="gov-panel-reader">Entscheidungen</a>
    <a role="tab" id="tab-policies" href="/governance/regeln?tab=policies" data-tab="policies" aria-controls="gov-panel-reader">Policies</a>
    <a role="tab" id="tab-registry" href="/governance/regeln?tab=registry" data-tab="registry" aria-controls="gov-panel-reader">Registry</a>
    <a role="tab" id="tab-effective" href="/governance/regeln?tab=effective" data-tab="effective" aria-controls="gov-panel-reader">Wirksame Policy</a>
  </div>

  <div id="gov-panel-status" role="tabpanel" aria-labelledby="tab-status">
    <p id="gov-status-meta" role="status" aria-live="polite" class="gov-state" style="font-size:.78rem;color:var(--text-muted)"></p>

  <!-- Oberer Bereich: Decision-Clicker (Human-in-the-Loop) -->
  <div class="card" style="margin-bottom:1.5rem;border-left:4px solid var(--warning);">
    <div class="card-header">
      <h2 class="card-title">⚖️ Decision-Clicker (Offene menschliche Entscheidungen)</h2>
      <span class="badge" id="decisions-count-badge">Entscheidungen nicht geprüft</span>
    </div>
    <p style="font-size:0.8rem;color:var(--text-muted);margin-bottom:1rem;">
      Das Register listet Entscheidungsdateien. Der Freigabestatus und die 1-Klick-Aktion sind hier noch nicht angebunden:
    </p>

    <div id="decisions-list" style="display:flex;flex-direction:column;gap:0.75rem;">
      <div style="padding:1rem;background:var(--bg-dark);border:1px solid var(--border);border-radius:var(--radius-sm);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;">
        <div>
          <div style="display:flex;align-items:center;gap:0.5rem;">
            <strong style="color:var(--text);font-size:0.9rem;">Entscheidungsregister</strong>
            <span class="badge">Status nicht geprüft</span>
          </div>
          <p style="font-size:0.78rem;color:var(--text-muted);margin-top:0.25rem;">
            Der aktuelle Registerstand wird geladen.
          </p>
        </div>
        <div style="display:flex;gap:0.5rem;">
          <button class="btn btn-primary" style="padding:0.4rem 0.8rem;font-size:0.8rem;" disabled title="Freigabe-Endpunkt nicht angebunden">
            ✓ Genehmigen (nicht verfügbar)
          </button>
          <button class="btn" style="padding:0.4rem 0.8rem;font-size:0.8rem;" disabled title="Freigabe-Endpunkt nicht angebunden">
            ✕ Ablehnen (nicht verfügbar)
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- TRANSPARENTE ENTSCHEIDUNGSVERARBEITUNGSREGELN & 3-STUFEN-AUTORITÄTS-TUNNEL (doc_machine.config.json) -->
  <section class="card" id="decision-processing-rules-card" data-schema="ellmos.governance.decision-rules-and-tunneling.v1" style="margin-bottom:1.5rem;border:1px solid var(--border);background:var(--bg-card);">
    <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;gap:0.75rem;flex-wrap:wrap;">
      <div>
        <h2 class="card-title" style="margin:0 0 0.25rem 0;">⚖️ Transparente Entscheidungsverarbeitungsregeln &amp; 3-Stufen-Autoritäts-Tunnel</h2>
        <p style="margin:0;font-size:0.83rem;color:var(--text-muted);">
          Bestimmt das Verhalten von BACH &amp; Ocean deterministisch (<code>config/doc_machine.config.json</code> &amp; <code>escalation_ladder.py</code>): Kein künstlicher Verfalls-Timer; Schutz vor der Autoritätswüste (<code>error_authority_desert</code>).
        </p>
      </div>
      <span class="badge" id="wishes-redirect-badge">Lokal in Ocean/BACH (wishes_redirect: aus)</span>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:0.85rem;margin-top:0.85rem;font-size:0.83rem;">
      <div style="padding:0.85rem;border-radius:8px;border:1px solid var(--border);background:var(--bg-dark);">
        <strong style="color:var(--text);">🚇 3-Stufen-Autoritäts-Tunneling</strong>
        <ul style="margin:0.4rem 0 0;padding-left:1.1rem;color:var(--text-muted);">
          <li><strong>Stufe 1 (~80 % Alltag):</strong> <code>semantic_tunneling</code> via Goal/Plan (verhindert Autoritätswüste).</li>
          <li><strong>Stufe 2 (~15 % Schwellen):</strong> <code>quote_evidence_tunnel</code> (&lt;1 ms Wortwörtlich-Check aus NemoFold).</li>
          <li><strong>Stufe 3 (~5 % Irreversibel):</strong> <code>hard_gate</code> (<code>LOCK.user.*</code>, Sicherheits-Hash, Ed25519).</li>
        </ul>
      </div>
      <div style="padding:0.85rem;border-radius:8px;border:1px solid var(--border);background:var(--bg-dark);">
        <strong style="color:var(--text);">🧭 3-Ursachen-Routing (<code>decision_processing_rules</code>)</strong>
        <ul style="margin:0.4rem 0 0;padding-left:1.1rem;color:var(--text-muted);">
          <li><strong>1. Ungewollte Erosion:</strong> <code>["local_taskplan", "user_notification"]</code> (P1-Reparatur-Task + Hinweis).</li>
          <li><strong>2. Geplantes Terraforming:</strong> <code>["local_taskplan"]</code> (P2-Bau-Task + SOLL/IST-Trennung).</li>
          <li><strong>3. Erfolgtes Terraforming:</strong> <code>["local_doc_update"]</code> (Doku &amp; 6 Sprachen lokal nachziehen).</li>
        </ul>
      </div>
      <div style="padding:0.85rem;border-radius:8px;border:1px solid var(--border);background:var(--bg-dark);">
        <strong style="color:var(--text);">🧞 Lokale Wishes-Come-True &amp; Entwickler-Umleitung</strong>
        <p style="margin:0.4rem 0 0;color:var(--text-muted);" id="gov-decision-rules-live">
          Standard: Lokale Task in BACH/Ocean (<code>local_taskplan</code>) oder lokale MarbleRun-Staffette (<code>wishes-come-true-local</code>). Entwickler-Umleitung (<code>wishes_redirect</code>) in <code>doc_machine.config.json</code> frei kombinierbar.
        </p>
      </div>
    </div>
  </section>
  </div>

  <section id="gov-panel-reader" role="tabpanel" tabindex="-1" hidden aria-labelledby="gov-reader-title">
    <h2 id="gov-reader-title" class="card-title"></h2>
    <p class="gov-banner" id="gov-banner">
      <strong>Diese Ansicht schreibt nicht.</strong> Lock-Vorbehalt: Locks stammen aus einem Scan-Cache; ein leerer,
      veralteter oder fehlender Scan ist keine Schreibfreigabe. Gesperrte Bereiche bleiben fail-closed.
    </p>
    <form id="gov-filters" class="gov-filters" hidden>
      <label>scope <input name="scope" maxlength="256" autocomplete="off" /></label>
      <label>consumer <input name="consumer" maxlength="256" autocomplete="off" /></label>
      <label>query <input name="query" maxlength="512" autocomplete="off" /></label>
      <label id="gov-kind-label">kind
        <select name="kind">
          <option value="">alle</option><option>policy</option><option>rule</option>
          <option>decision</option><option>evidence</option><option>decision-candidate</option>
        </select>
      </label>
      <button type="submit" class="btn btn-sm">Laden</button>
      <button type="button" class="btn btn-sm" id="gov-reload">Neu laden</button>
    </form>
    <p id="gov-state" role="status" aria-live="polite" class="gov-state"></p>
    <dl id="gov-meta" class="gov-meta"></dl>
    <ul id="gov-notices" class="gov-notices"></ul>
    <div id="gov-rows"></div>
    <details id="gov-response" hidden><summary>Vollständige öffentliche Antwort (einschließlich zusätzlicher Felder)</summary><pre id="gov-response-json"></pre></details>
  </section>
  </div>

  <script is:inline>
    (async function loadGovernanceDecisionRules() {
      try {
        const res = await fetch("/api/governance/decision-rules");
        if (!res.ok) return;
        const data = await res.json();
        const cfg = data?.doc_machine_config || {};
        const badge = document.getElementById("wishes-redirect-badge");
        if (badge && cfg.wishes_redirect) {
          badge.textContent = cfg.wishes_redirect.enabled
            ? `wishes_redirect AKTIV -> ${cfg.wishes_redirect.target_mode}`
            : `Lokal (${cfg.execution_locality || "local_ocean_bach_only"}) · wishes_redirect: aus`;
        }
      } catch (_e) {}
    })();
  </script>

  <script>
    import {readTab, loadStatus, mountReader, mountTablist} from "../../scripts/governance-reader.mjs";

    const tab = readTab(location.search);
    // Locks have their own page since the split; an old ?tab=locks link lands there.
    if (tab === "locks") location.replace("/governance/sperren");
    mountTablist(tab);
    if (tab === "status") loadStatus();
    else mountReader(tab);
  </script>
</BachLayout>
