---
import BachLayout from "../layouts/BachLayout.astro";
import AgentTriggers from '../components/AgentTriggers.astro';
---
<BachLayout title="Routinen & Jobs" currentPath="/routinen">
  <section class="routine-board" aria-labelledby="routine-board-title" data-routines>
    <header class="routine-header">
      <div>
        <h1 id="routine-board-title">Routinen &amp; Jobs</h1>
        <p class="routine-lead">Alles, was nach Zeitplan läuft, in einer Liste: Daemon-Jobs und wiederkehrende Aufgaben von BACH, Auslöser aus dem Ocean-Scheduler und deine persönlichen Life-Routinen. Jede Quelle wird bei jedem Laden neu geprüft; was nicht antwortet, steht mit Grund im Quellenstatus.</p>
      </div>
      <div class="routine-header-actions">
        <a class="btn" href="/life?tab=routinen">Life-Routinen öffnen</a>
        <button class="btn btn-primary" id="routine-refresh" type="button">Aktualisieren</button>
      </div>
    </header>

    <section class="routine-source-grid" aria-label="Quellenstatus">
      <article class="source-card" data-source-card="bach"><strong>BACH</strong><span data-source-state>wird geprüft…</span><small data-source-note hidden></small></article>
      <article class="source-card" data-source-card="ocean"><strong>Ocean</strong><span data-source-state>wird geprüft…</span><small data-source-note hidden></small></article>
      <article class="source-card" data-source-card="module"><strong>Modul</strong><span data-source-state>wird geprüft…</span><small data-source-note hidden></small></article>
      <article class="source-card" data-source-card="life"><strong>Life · persönlich</strong><span data-source-state>wird geprüft…</span><small data-source-note hidden></small></article>
    </section>

    <section class="routine-filters card" aria-label="Routinen- und Jobfilter">
      <label>Herkunft
        <select id="routine-source-filter">
          <option value="all">Alle Herkünfte</option>
          <option value="bach">BACH</option>
          <option value="ocean">Ocean</option>
          <option value="module">Modul</option>
          <option value="life">Life · persönlich</option>
        </select>
      </label>
      <label>Typ
        <select id="routine-kind-filter">
          <option value="all">Routinen &amp; Jobs</option>
          <option value="routine">Routinen</option>
          <option value="job">Jobs</option>
          <option value="chain">Befehlsketten (Toolchains)</option>
          <option value="miniagent">Miniagenten</option>
        </select>
      </label>
      <label class="routine-search">Suche
        <input id="routine-search" type="search" maxlength="120" placeholder="Name, Herkunft oder Zeitplan" autocomplete="off" />
      </label>
      <p id="routine-status" class="routine-status" role="status" aria-live="polite">Quellen werden geprüft…</p>
    </section>

    <section class="routine-list-card card" aria-labelledby="routine-list-title">
      <header class="routine-list-header"><h2 id="routine-list-title">Gemeinsame Liste</h2><span id="routine-count" class="badge">–</span></header>
      <div class="routine-table-wrap">
        <div class="routine-table" role="table" aria-label="Routinen und Jobs">
          <div class="routine-head" role="row">
            <span class="routine-heading" role="columnheader">Routine / Job</span><span class="routine-heading" role="columnheader">Planung</span><span class="routine-heading" role="columnheader">Nächster Lauf</span><span class="routine-heading" role="columnheader">Letzter Lauf</span><span class="routine-heading" role="columnheader">Run-Schalter</span><span class="routine-heading" role="columnheader">Aktion</span>
          </div>
          <div id="routine-list" role="rowgroup"></div>
        </div>
      </div>
    </section>
  </section>
  <AgentTriggers />
</BachLayout>

<script>
  import {mountRoutines} from '../lib/routines-ui.mjs';
  mountRoutines(document.querySelector('[data-routines]'));
</script>

<!-- is:global: the rows are made by a script and carry no Astro scope attribute (scripts/verify-scoped-styles.mjs). Every rule is prefixed. -->
<style is:global>
  .routine-board{--routine-cols:minmax(13rem,2.3fr) minmax(7rem,1fr) minmax(8rem,1fr) minmax(9.5rem,1.2fr) minmax(6rem,.8fr) minmax(8.5rem,1fr);display:grid;gap:1rem;max-width:1280px;margin:0 auto;padding:1rem}
  .routine-board .routine-header{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-wrap:wrap;padding:1.2rem;border:1px solid var(--border);border-radius:12px;background:var(--bg-panel)}
  .routine-board .routine-header h1{margin:0 0 .4rem;font-size:clamp(1.6rem,3vw,2.2rem)}
  .routine-board .routine-lead{max-width:68ch;color:var(--text-muted);line-height:1.55;margin:0}
  .routine-board .routine-header-actions{display:flex;gap:.5rem;flex-wrap:wrap}

  .routine-board .routine-source-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.7rem}
  .routine-board .source-card{display:grid;align-content:start;gap:.25rem;padding:.8rem .9rem;border:1px solid var(--border);border-left-width:4px;border-radius:8px;background:var(--bg-panel)}
  .routine-board .source-card span{color:var(--text-muted);font-size:.8rem;line-height:1.4}
  .routine-board .source-card small{color:var(--text-muted);font-size:.74rem;line-height:1.4}
  .routine-board .source-card[data-state=available]{border-left-color:var(--success)}
  .routine-board .source-card[data-state=partial]{border-left-color:var(--warning)}
  .routine-board .source-card[data-state=unavailable]{border-left-color:var(--error)}

  .routine-board .routine-filters{display:flex;align-items:end;gap:1rem;flex-wrap:wrap;padding:1rem}
  .routine-board .routine-filters label{display:grid;gap:.35rem;min-width:10rem;color:var(--text-muted);font-size:.8rem}
  .routine-board .routine-filters select,.routine-board .routine-filters input{padding:.6rem;background:var(--bg-dark);color:var(--text);border:1px solid var(--border);border-radius:6px;font:inherit}
  .routine-board .routine-search{flex:1}
  .routine-board .routine-status{flex:1 1 100%;margin:0;color:var(--text-muted);font-size:.82rem}

  .routine-board .routine-list-card{padding:1rem}
  .routine-board .routine-list-header{display:flex;justify-content:space-between;gap:1rem;align-items:center}
  .routine-board .routine-list-header h2{margin:0}
  .routine-board .routine-table-wrap{margin-top:.8rem;container-type:inline-size}
  .routine-board .routine-head,.routine-board .routine-row{display:grid;grid-template-columns:var(--routine-cols);gap:.65rem;align-items:center}
  .routine-board .routine-head{padding:.5rem .8rem;color:var(--text-muted);font-size:.78rem;font-weight:600;border-bottom:1px solid var(--border-hover)}
  .routine-board .routine-row{padding:.55rem .8rem;border-bottom:1px solid var(--border);font-size:.84rem}
  .routine-board .routine-row:hover{background:var(--bg-card)}
  .routine-board .routine-cell{min-width:0;overflow-wrap:anywhere}
  .routine-board .routine-title{display:flex;flex-wrap:wrap;align-items:center;gap:.2rem .5rem}
  .routine-board .routine-title strong{font-weight:600}
  .routine-board .routine-origin{display:block;margin-top:.15rem;color:var(--text-muted);font-size:.74rem}
  .routine-board .routine-flag,.routine-board .routine-result,.routine-board .routine-list-header .badge{text-transform:none;letter-spacing:0;white-space:nowrap}
  .routine-board .routine-cell:nth-child(4){display:flex;flex-direction:column;align-items:flex-start;gap:.2rem}
  .routine-board .routine-state.is-readonly{display:inline-flex;flex-direction:column;padding:.2rem .6rem;border:1px dashed var(--border-hover);border-radius:var(--radius-sm);color:var(--text-muted);font-size:.8rem;line-height:1.3}
  .routine-board .routine-state small{font-size:.68rem}
  .routine-board .routine-toggle[aria-pressed=true]{border-color:var(--success-text);color:var(--success-text)}
  .routine-board .routine-actions{display:flex;flex-wrap:wrap;gap:.4rem}
  .routine-board .routine-result{align-self:flex-start}
  .routine-board .routine-none{color:var(--text-muted)}
  .routine-board .routine-empty{margin:.8rem 0 0;padding:2rem 1rem;color:var(--text-muted);text-align:center;border:1px dashed var(--border-hover);border-radius:8px}

  @container (max-width: 58rem) {
    .routine-board .routine-head{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
    .routine-board .routine-row{grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem 1rem;padding:.9rem .6rem}
    .routine-board .routine-name,.routine-board .routine-actions{grid-column:1/-1}
    .routine-board .routine-cell:not(.routine-name):not(.routine-actions)::before{content:attr(data-label);display:block;margin-bottom:.1rem;color:var(--text-muted);font-size:.7rem}
  }
  @media(max-width:900px){.routine-board .routine-source-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.routine-board{padding:.65rem}}
  @media(max-width:560px){.routine-board .routine-source-grid{grid-template-columns:1fr}.routine-board .routine-header,.routine-board .routine-filters,.routine-board .routine-list-card{padding:.8rem}.routine-board .routine-header-actions{width:100%}.routine-board .routine-header-actions .btn{flex:1}.routine-board .routine-filters label{min-width:0;width:100%}}
</style>
