---
import BachLayout from "../layouts/BachLayout.astro";
---
<BachLayout title="Inbox" currentPath="/user-inbox">
  <p>Die Nutzer-Inbox ist jetzt ein Tab unter <a id="inbox-redirect-link" href="/agenten/sessions?tab=inbox">Sessions &amp; Protokolle</a>. Du wirst weitergeleitet …</p>
</BachLayout>
<script>
  import {redirectTarget} from '../lib/user-inbox.mjs';
  const target = redirectTarget(location.search, location.hash);
  document.getElementById('inbox-redirect-link').setAttribute('href', target);
  location.replace(target);
</script>
