---
// chat.astro - Ocean/BACH chat: sends through the chat-control route, lists stored sessions (Ich / Buddha / Worker / System),
// opens and continues them, shows failed answers. Logic lives in src/scripts/chat-page.mjs and src/lib/chat-client.mjs.
import BachLayout from "../layouts/BachLayout.astro";
---

<BachLayout title="Chat & Voice-IO" currentPath="/chat">
  <div class="chat-page">
    <header class="card-header" style="margin-bottom:1.25rem;flex-wrap:wrap;gap:0.75rem;">
      <div>
        <span class="badge">💬 Ocean · BACH Native Chat &amp; ellmos-voice-io</span>
        <h1 style="margin:0.35rem 0 0.2rem;font-size:1.5rem;" data-i18n="chat.title">Ocean / BACH Live-Chat &amp; Voice-IO</h1>
        <p style="margin:0;color:var(--text-muted);font-size:0.9rem;">
          Chat mit Buddha, gespeicherte Verläufe aller Agenten und Spracheingabe (<code>ellmos-voice-io</code>).
        </p>
      </div>
      <div style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;">
        <label style="font-size:0.82rem;color:var(--text-muted);display:flex;align-items:center;gap:0.4rem;">
          <span>Steckplatz für neue Chats:</span>
          <select id="chat-slot-select" class="lang-switcher" style="min-width:210px;">
            <option value="buddha_chat">💬 Buddha Chat</option>
            <option value="buddha_always_on">⚡ Buddha Always-On</option>
          </select>
        </label>
        <a href="/talk" class="btn btn-secondary" data-i18n="chat.talk_window">🎙️ ELLMOS Talk öffnen</a>
        <a href="/sensation" class="btn btn-secondary">👁️ Sensation &amp; Kamera</a>
      </div>
    </header>

    <div class="chat-layout">
      <aside class="chat-history" aria-labelledby="chat-history-title">
        <div class="chat-history-head">
          <h2 id="chat-history-title">Verläufe</h2>
          <button type="button" id="chat-new" class="btn btn-secondary btn-sm">Neuer Chat</button>
        </div>
        <div class="chat-source" role="group" aria-label="Quelle des Verlaufs">
          <button type="button" class="btn btn-secondary btn-sm" data-chat-source="user" aria-pressed="true">Ich <span class="chat-count"></span></button>
          <button type="button" class="btn btn-secondary btn-sm" data-chat-source="buddha" aria-pressed="false">Buddha <span class="chat-count"></span></button>
          <button type="button" class="btn btn-secondary btn-sm" data-chat-source="worker" aria-pressed="false">Worker <span class="chat-count"></span></button>
          <button type="button" class="btn btn-secondary btn-sm" data-chat-source="system" aria-pressed="false">System <span class="chat-count"></span></button>
        </div>
        <label class="chat-problems-filter"><input type="checkbox" id="chat-problems"> Nur Probleme</label>
        <p id="chat-history-state" role="status" class="text-muted">Verläufe werden geladen …</p>
        <ul id="chat-history-list" class="chat-history-list"></ul>
        <button type="button" id="chat-history-more" class="btn btn-secondary btn-sm" hidden>Weitere Verläufe laden</button>
      </aside>

      <section class="card chat-main">
        <div id="chat-session-bar" class="chat-session-bar" hidden></div>
        <div id="chat-messages" role="log" aria-live="polite" class="chat-log"></div>

        <form id="chat-composer" class="chat-composer">
          <button type="button" id="voice-dictate-btn" class="btn btn-secondary" title="Spracheingabe starten/stoppen (ellmos-voice-io)"
            aria-label="Spracheingabe (ellmos-voice-io)" aria-pressed="false">🎙️ <span id="voice-dictate-label" data-i18n="chat.dictate">Diktat</span></button>
          <textarea id="chat-input" rows="2" placeholder="Nachricht eingeben oder per Diktat sprechen …"></textarea>
          <button type="submit" class="btn btn-primary" id="chat-send-btn" data-i18n="chat.send">Senden</button>
        </form>
        <p id="chat-status" class="chat-status" role="status" aria-live="polite">Chat wird vorbereitet …</p>
      </section>
    </div>
  </div>

  <style is:global>
    .chat-layout { display: grid; grid-template-columns: minmax(250px, 320px) minmax(0, 1fr); gap: 1rem; align-items: start; }
    .chat-history { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 0.85rem; display: flex; flex-direction: column; gap: 0.6rem; max-height: 72vh; }
    .chat-history-head { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; }
    .chat-history-head h2 { font-size: 1.05rem; margin: 0; }
    .chat-source { display: flex; flex-wrap: wrap; gap: 0.35rem; }
    .chat-source [aria-pressed="true"] { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
    .chat-layout [hidden] { display: none !important; }
    .chat-count { opacity: 0.8; font-variant-numeric: tabular-nums; }
    .chat-problems-filter { font-size: 0.85rem; display: flex; gap: 0.4rem; align-items: center; }
    .chat-history-list { list-style: none; margin: 0; padding: 0; overflow-y: auto; display: flex; flex-direction: column; gap: 0.35rem; }
    .chat-history-item { width: 100%; text-align: left; background: transparent; color: var(--text); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.55rem 0.7rem; cursor: pointer; display: flex; flex-direction: column; gap: 0.2rem; font: inherit; }
    .chat-history-item:hover { border-color: var(--border-hover); background: var(--bg-elevated); }
    .chat-history-item[aria-current="true"] { border-color: var(--accent); }
    .chat-history-item:focus-visible, .chat-source button:focus-visible { outline: 2px solid var(--accent-blue); outline-offset: 2px; }
    .chat-history-name { font-weight: 600; overflow-wrap: anywhere; }
    .chat-history-meta { font-size: 0.78rem; color: var(--text-muted); display: flex; flex-direction: column; gap: 0.15rem; }
    .chat-problem { color: var(--error-text); font-weight: 600; }
    #chat-history-state[data-error="true"] { color: var(--error-text); }
    .chat-main { display: flex; flex-direction: column; min-height: 460px; gap: 0.9rem; }
    .chat-session-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; padding-bottom: 0.6rem; border-bottom: 1px solid var(--border); }
    .chat-log { flex: 1; overflow-y: auto; max-height: 520px; display: flex; flex-direction: column; gap: 0.75rem; padding: 0.5rem; }
    .chat-bubble { max-width: 82%; padding: 0.85rem 1rem; border-radius: var(--radius-md); background: var(--bg-card); border: 1px solid var(--border); align-self: flex-start; }
    .chat-bubble-user { align-self: flex-end; background: var(--accent); color: var(--on-accent); }
    .chat-bubble-author { font-size: 0.75rem; opacity: 0.8; margin-bottom: 0.25rem; }
    .chat-bubble-text { white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.55; }
    .chat-bubble-failed, .chat-bubble-error { border-color: var(--error); }
    .chat-bubble-error { display: flex; flex-direction: column; gap: 0.5rem; align-items: flex-start; }
    .chat-composer { display: flex; gap: 0.6rem; align-items: flex-end; border-top: 1px solid var(--border); padding-top: 0.85rem; }
    .chat-composer textarea { flex: 1; min-width: 0; resize: vertical; padding: 0.65rem 0.85rem; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--bg-card); color: var(--text); font: inherit; }
    .chat-composer textarea:disabled { opacity: 0.6; }
    .chat-status { margin: 0; font-size: 0.78rem; color: var(--text-muted); }
    .chat-status[data-error="true"] { color: var(--error-text); }
    @media (max-width: 820px) {
      .chat-layout { grid-template-columns: minmax(0, 1fr); }
      .chat-history { max-height: 40vh; }
      .chat-bubble { max-width: 94%; }
    }
  </style>

  <script>import '../scripts/chat-page.mjs';</script>
</BachLayout>
