---
import BachLayout from "../../layouts/BachLayout.astro";
import portraitAtlas from '../../assets/agent-portraits.png';
import '../../styles/agent-avatars.css';
import '../../styles/ticket-symbols.css';
import {TICKET_SYMBOL_URLS} from '../../lib/ticket-symbol-assets.mjs';
---
<BachLayout title="Agenten-Bibliothek · Vorlagen" currentPath="/agenten/blueprints">
  <div class="workshop-scene">
  <header class="studio-header" data-portrait-atlas={portraitAtlas.src} data-ticket-symbols={JSON.stringify(TICKET_SYMBOL_URLS)} id="studio-portrait-source">
    <div class="workshop-intro"><p class="studio-eyebrow">Agenten-Bibliothek · Reiter 1</p><h1><span aria-hidden="true">🤖</span> Agenten-Bibliothek · Vorlagen</h1><p class="studio-lead">Hier kannst du Vorlagen für Agenten und Rollen erstellen und versionieren.</p><p class="studio-note">Agenten zusammenstellen und aktivieren: <a href="/agenten/running">Living & Running</a>. Standard-Systemagenten auf Werkzustand zurücksetzen: <a href="/settings?tab=core#system-agent-restore">Systemeinstellungen</a>.</p></div>
    <div class="studio-actions">
      <button class="btn" id="studio-refresh">Aktualisieren</button>
      <button class="btn btn-primary" id="studio-new">Neue Vorlage</button>
      <a class="btn" href="/agenten/running">Deine Agenten</a>
    </div>
  </header>
  <p id="studio-status" class="studio-message" role="status" aria-live="polite">Vorlagen werden geladen…</p>
  <div class="studio-tabs" role="tablist" aria-label="Vorlagen-Bibliothek">
    <button role="tab" type="button" aria-selected="true" data-library="templates">Mitgelieferte Vorlagen <span id="count-templates">–</span></button>
    <button role="tab" type="button" aria-selected="false" data-library="custom">Eigene Vorlagen <span id="count-custom">–</span></button>
    <button role="tab" type="button" aria-selected="false" data-library="prompt-agents">Prompt-Agenten</button>
    <button role="tab" type="button" aria-selected="false" data-library="teams">Teams <span id="count-teams">–</span></button>
  </div>
  <div class="studio-toolbar" id="studio-toolbar">
    <label class="studio-search">Suchen<input id="studio-search" type="search" placeholder="Name, Rolle oder Beschreibung" /></label>
    <label>Typ<select id="studio-kind"><option value="">Alle Typen</option><option value="agent">Agenten</option><option value="role">Rollen</option><option value="skill">Skill-Vorlagen</option><option value="workflow">Workflow-Vorlagen</option><option value="service">Service-Vorlagen</option><option value="contractus">Arbeitsverträge</option></select></label>
    <button class="btn" id="studio-prompts" hidden>System- und Rollenvorlagen</button>
  </div>
  <section id="studio-grid" class="studio-grid" aria-label="Blueprints"></section>
  <section id="studio-teams" hidden>
    <div class="studio-section-heading"><h2>Teams</h2><button id="studio-new-team" class="btn">Team anlegen</button></div>
    <p class="studio-note">Mitglieder und Koordination werden gespeichert. Ausführbare Abläufe und ihre Aufgaben stehen unter <a href="/agenten/marblerun">Ketten</a>.</p>
    <div id="studio-team-grid" class="studio-grid"></div>
  </section>
  <section id="studio-prompt-agents" class="subscription-board" aria-labelledby="subscription-title" hidden>
    <header class="subscription-header">
      <div>
        <p class="studio-eyebrow">Agenten-Bibliothek · Prompt-Agenten</p>
        <h2 id="subscription-title">Prompt-Agenten · Vorlagen-Composer</h2>
        <p class="studio-lead">Stelle direkt aus einer Blueprint-Vorlage einen quellengebundenen Startprompt für einen späteren Client zusammen. Prompt-Agenten werden extern zugeschaltet und von dieser GUI nicht gesteuert.</p>
      </div>
      <div class="subscription-actions">
        <a class="btn" href="/agenten/running">Living &amp; Running</a>
        <button id="subscription-refresh" class="btn" type="button">Quellen neu laden</button>
      </div>
    </header>

    <section class="source-state" aria-label="Anbindung">
      <p id="subscription-status" role="status" aria-live="polite">Quellen werden geprüft …</p>
      <p><strong>BACH / verbundener Backendadapter:</strong> <span id="subscription-route-state">unbekannt</span></p>
      <p><strong>Open-Ocean:</strong> unbekannt, solange kein eigener Adapter diese Route bestätigt.</p>
      <p><strong>Statusgrenze:</strong> Vorschau und Kopieren belegen weder einen Client-Start noch einen laufenden Agenten.</p>
    </section>

    <form id="subscription-form" class="subscription-form">
      <section class="studio-prompt-card" aria-labelledby="target-heading">
        <h3 id="target-heading">Zielclient</h3>
        <p class="studio-note">Manuelle, unbestätigte Prompt-Metadaten. Sie wählen keinen installierten Client und beweisen keine Laufzeitfähigkeit.</p>
        <div class="field-grid">
          <label>Client-Kennung<input name="client_id" required maxlength="64" autocomplete="off" placeholder="z. B. codex" /></label>
          <label>Host<input name="host" required maxlength="128" autocomplete="off" placeholder="z. B. Laptop" /></label>
          <label>Anzeigename<input name="client_name" required maxlength="120" autocomplete="off" placeholder="z. B. Codex auf dem Laptop" /></label>
          <label>Arbeitskontext (optional)<input name="workspace" maxlength="1024" autocomplete="off" placeholder="z. B. Repository oder Projektbereich" /></label>
        </div>
        <p class="studio-note">Der Arbeitskontext wird nur als Text übernommen. Zugriff oder Arbeitsverzeichnis werden nicht geprüft.</p>
      </section>

      <section class="studio-prompt-card" aria-labelledby="source-heading">
        <h3 id="source-heading">Blueprint-Vorlage und Skills</h3>
        <label>Blueprint<select id="subscription-blueprint" name="blueprint_id" required><option value="">Blueprints werden geladen …</option></select></label>
        <p class="studio-note">Nur ganzzahlige, aktuelle Blueprint-Revisionen sind auswählbar. Unpassende Revisionen bleiben gesperrt.</p>
        <fieldset class="subscription-fieldset">
          <legend>Aktuelle Skill-Quellen (höchstens 30 auswählen)</legend>
          <div id="subscription-skills" class="skill-list"><p class="studio-note">Skill-Quellen werden geladen …</p></div>
        </fieldset>
      </section>

      <section class="studio-prompt-card" aria-labelledby="task-heading">
        <h3 id="task-heading">Arbeitsauftrag und Task-Kontext</h3>
        <p class="studio-note">Task-IDs sind nur Referenzen. Es gibt keine Queue-Suche, Zuweisung, Lease oder Übernahme.</p>
        <label>Auftrag<textarea name="user_task" rows="5" maxlength="16000" placeholder="Was soll der spätere Client tun?"></textarea></label>
        <label>Task-Referenzen<input name="task_refs" maxlength="240" inputmode="numeric" placeholder="z. B. 123, 456" /></label>
        <label>Textliche Auswahlregel<textarea name="task_selection_rule" rows="3" maxlength="2000" placeholder="Optional; wird nur als Text in die Vorschau übernommen."></textarea></label>
      </section>

      <section class="studio-prompt-card" aria-labelledby="governance-heading">
        <h3 id="governance-heading">Governance-Quellen</h3>
        <p class="studio-note">Policy- und Entscheidungsfragen dienen nur dem lesenden Quellenabgleich. Durchsetzung wird nicht bestätigt.</p>
        <div class="field-grid">
          <label>Geltungsbereich<input name="governance_scope" maxlength="256" value="BACH" /></label>
          <label>Policy-Frage<input name="policy_query" maxlength="128" /></label>
          <label>Entscheidungsfrage<input name="decision_query" maxlength="128" /></label>
        </div>
      </section>

      <div class="subscription-submit-row">
        <button id="subscription-compose" class="btn btn-primary" type="submit" disabled>Preview zusammenstellen</button>
      </div>
    </form>

    <section class="studio-prompt-card preview" aria-labelledby="preview-heading">
      <header class="preview-heading">
        <div><h3 id="preview-heading">Vorschau</h3><p id="subscription-preview-state" class="studio-note">Noch keine bestätigte Vorschau.</p></div>
        <button id="subscription-copy" class="btn" type="button" disabled>Prompt manuell kopieren</button>
      </header>
      <p id="subscription-preview-meta" class="studio-note"></p>
      <div class="preview-columns">
        <section><h4>Quellen</h4><ul id="subscription-source-list"></ul></section>
        <section><h4>Fehlende Quellen</h4><ul id="subscription-missing-list"></ul></section>
      </div>
      <label for="subscription-prompt">Prompttext</label>
      <textarea id="subscription-prompt" rows="16" readonly aria-label="Zusammengestellter Prompt"></textarea>
      <p class="studio-note">„Für Review bereit“ beschreibt nur den Quellenstatus. Es ist kein Client-Readiness-, Launcher-, Governance- oder Laufzeitnachweis. Das Kopieren geschieht ausschließlich nach Klick im Browser.</p>
    </section>
  </section>
  <section id="ocean-role-socket-panel" class="studio-header" data-schema="ellmos.role-socket-catalog.v1" style="margin-top:1.25rem;margin-bottom:1.1rem;">
    <div style="width:100%;">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:0.75rem;flex-wrap:wrap;margin-bottom:0.5rem;">
        <div>
          <p class="studio-eyebrow" style="margin:0;">Ocean-Rollen · Dual-Routing &amp; Flexible Anbieter-Sockel (<code>ellmos.role-socket-catalog.v1</code>)</p>
          <h2 style="font-size:1.15rem;margin:0.15rem 0 0;">🔌 6 Koordinatoren (ehem. Bosse), Domänen-Experten &amp; <span id="ocean-module-role-count"></span>Modul-Rollen (<code>roles[]</code>)</h2>
        </div>
        <label style="flex-direction:row;align-items:center;gap:0.45rem;margin:0;">
          <span>Aktiver Anbieter-Sockel:</span>
          <select id="ocean-socket-provider-select" style="width:auto;padding:0.35rem 0.65rem;">
            <option value="claude">Claude (Opus / Sonnet / Haiku)</option>
            <option value="codex">Codex / OpenAI (GPT-5.4)</option>
            <option value="agy">Gemini / Antigravity (3.1 Pro / Flash)</option>
            <option value="kimi">Kimi (K2.5)</option>
            <option value="ollama">Ollama Lokal (Qwen 3.5 35B)</option>
            <option value="openrouter">OpenRouter</option>
          </select>
        </label>
      </div>
      <p class="studio-note" style="margin:0 0 0.65rem 0;">
        <strong>Semantisches Routing:</strong> Umbrella-Skills (<code>*-umbrella</code>) + <code>semantic-persona-routing</code> &middot;
        <strong>Deterministisches Routing:</strong> <code>ellmos-controlcenter-mcp</code> (<code>resolve_semantic_route</code> / <code>switch_profile</code>) &middot;
        <strong>Modell-Sockel:</strong> <code>reasoning_coordinator</code> | <code>domain_specialist</code> | <code>fast_worker</code>.
      </p>
      <div id="ocean-role-socket-list" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:0.65rem;font-size:0.8rem;"></div>
    </div>
  </section>
  <script>
    import {mountRoleSocketPreview} from "../../lib/role-socket-preview.mjs";
    mountRoleSocketPreview(document);
  </script>

  <dialog id="revision-history" class="studio-dialog" aria-labelledby="revision-title">
    <header class="studio-dialog-header"><h2 id="revision-title">Versionen</h2><button type="button" class="btn" id="revision-close" data-close="revision-history">Schließen</button></header>
    <div class="studio-dialog-body">
      <p id="revision-summary" class="studio-note"></p><p id="revision-policy" class="studio-note"></p>
      <div class="studio-fields">
        <label>Gespeicherte Definition<select id="revision-from"></select></label>
        <label>Vergleichen mit<select id="revision-to"></select></label>
      </div>
      <div class="studio-actions"><button type="button" class="btn" id="revision-refresh">Neu laden</button><button type="button" class="btn" id="revision-more" hidden>Ältere Versionen laden</button><button type="button" class="btn" id="revision-compare">Vergleichen</button></div>
      <p id="revision-hash" class="studio-note" style="overflow-wrap:anywhere"></p>
      <details><summary>Gespeicherte Definition anzeigen</summary><pre id="revision-content" class="studio-prompt-preview"></pre></details>
      <pre id="revision-diff" class="studio-prompt-preview" aria-label="Versionsvergleich"></pre>
      <p id="revision-status" class="studio-message" role="status" aria-live="polite"></p>
    </div>
    <footer class="studio-dialog-footer"><button type="button" class="btn btn-primary" id="revision-restore" disabled>Auswahl als neue Version wiederherstellen</button></footer>
  </dialog>

  <dialog id="blueprint-editor" class="studio-dialog" aria-labelledby="editor-title">
    <form id="blueprint-form">
      <header class="studio-dialog-header"><div><p class="studio-eyebrow" id="editor-revision">Neuer Blueprint</p><h2 id="editor-title">Blueprint anlegen</h2></div><button type="button" class="btn" data-close="blueprint-editor" aria-label="Editor schließen">Schließen</button></header>
      <div class="studio-dialog-body">
        <div class="studio-fields">
          <label>Name (ID)<input name="name" id="bp-name" required maxlength="80" pattern="[A-Za-z0-9._\-]+" placeholder="mein-assistent" /></label>
          <label>Bezeichnung<input id="bp-title" required maxlength="120" /></label>
          <label>Typ<select id="bp-kind"><option value="agent">Agent</option><option value="role">Rolle</option><option value="skill">Skill-Vorlage</option><option value="workflow">Workflow-Vorlage</option><option value="service">Service-Vorlage</option><option value="contractus">Arbeitsvertrag</option></select></label>
          <label>Beschreibung<input id="bp-description" maxlength="20000" /></label>
          <label class="studio-check"><input id="bp-use-color" type="checkbox" /> Blueprint-Farbe verwenden</label>
          <label>Farbe<input id="bp-color" type="color" value="#3b82f6" disabled /><span id="bp-color-status" class="studio-note">Farbvertrag wird geprüft.</span></label>
        </div>
        <details open class="studio-group">
          <summary><span>01</span> Rolle & Systemprompt</summary>
          <div class="studio-group-body">
            <label>Vorhandene Rolle<select id="bp-role"></select></label>
            <label>Rollenprompt<textarea id="bp-persona" rows="7" required maxlength="20000"></textarea></label>
            <label class="studio-check"><input id="bp-include-system" type="checkbox" checked /> Systemprompt verwenden</label>
            <label>Eigener Systemprompt <span class="studio-note">(leer = aktive Systemvorlage)</span><textarea id="bp-system" rows="5" maxlength="20000"></textarea></label>
            <details><summary>Aktiven Systemstandard anzeigen</summary><pre id="bp-system-default" class="studio-prompt-preview"></pre></details>
          </div>
        </details>
        <details class="studio-group">
          <summary><span>02</span> Skills & Tools</summary>
          <div class="studio-group-body">
            <p class="studio-note">Skills liefern Anleitungen. Die folgenden Toolfreigaben begrenzen die tatsächlich verfügbaren Werkzeuge.</p>
            <label>Skills filtern<input id="bp-skill-search" type="search" placeholder="Skill suchen" /></label>
            <div id="bp-skills" class="studio-options"></div>
            <label>Freigabeprofil<select id="bp-governance"></select></label>
            <div id="bp-tools" class="studio-options"></div>
            <p class="studio-note" id="bp-tools-source"></p>
          </div>
        </details>
        <details class="studio-group">
          <summary><span>03</span> Modell & Arbeitsvertrag</summary>
          <div class="studio-group-body">
            <div class="studio-fields">
              <label>Anbieter<select id="bp-backend"><option value="ollama">Ollama · lokal</option><option value="lmstudio">LM Studio · lokal</option><option value="hermes">Hermes · API</option><option value="ollama-cloud">Ollama Cloud</option><option value="openrouter">OpenRouter</option><option value="claude-api">Claude API</option><option value="openai">OpenAI API</option><option value="claude">Claude CLI · Subscription</option><option value="codex">Codex CLI · Subscription</option></select></label>
              <label>Modell<input id="bp-model" list="bp-models" autocomplete="off" maxlength="120" /><datalist id="bp-models"></datalist></label>
              <label>Arbeitsvertrag<select id="bp-contractus-preset"></select></label>
              <label>Modus<select id="bp-mode"><option value="safe">Safe</option><option value="full">Full</option></select></label>
              <label>Arbeitsweise<select id="bp-modus"><option value="casualis">Ein Arbeitsblock</option><option value="usus">Dauerläufer</option><option value="impetus_temporal" disabled>Zeitlich begrenzt · noch nicht ausführbar</option><option value="impetus_causa" disabled>Ereignisgesteuert · noch nicht ausführbar</option></select></label>
              <label>Toolrunden (0 = unbegrenzt)<input id="bp-turns" type="number" min="0" max="1000" value="20" /></label>
              <label>Pause nach<input id="bp-pause-after" type="number" min="0" max="1440" value="5" /></label>
              <label>Pause in Minuten<input id="bp-pause-minutes" type="number" min="0" max="1440" value="1" /></label>
              <label>Pausenauslöser<select id="bp-pause-basis"><option value="none">Keine Pause</option><option value="runs">Worker-Läufe</option><option value="tasks">Aufgaben</option></select></label>
              <label class="studio-check"><input id="bp-think" type="checkbox" checked /> Think</label>
            </div>
            <p class="studio-note">Ein Arbeitsblock endet nach seinem Toolbudget; eine offene Aufgabe wird dabei zurückgegeben. Dauerläufer arbeiten bis zum Stopp. Zeit- und Ereignissteuerung sind noch nicht ausführbar. Cloud- und API-Worker starten über den Startknopf.</p>
          </div>
        </details>
        <details class="studio-group">
          <summary><span>04</span> Bild & Promptvorschau</summary>
          <div class="studio-group-body">
            <div class="studio-avatar-row"><span id="bp-avatar-preview"></span><label>Eigenes Bild hochladen<input id="bp-avatar-upload" type="file" accept="image/png,image/jpeg,image/webp" /></label><button type="button" class="btn" id="bp-avatar-clear">Standardbild</button></div>
            <div id="bp-avatar-presets" class="avatar-preset-picker" aria-label="Porträtvorlagen"></div>
            <label>Symbol aus Ticket-Master<div id="bp-symbols" class="symbol-picker"></div></label>
            <p class="studio-note">PNG, JPEG oder WebP, maximal 180 KB.</p>
            <button type="button" class="btn" id="bp-preview">Startprompt anzeigen</button>
            <pre id="bp-preview-text" class="studio-prompt-preview" hidden></pre>
          </div>
        </details>
        <p id="editor-status" class="studio-message" role="status"></p>
      </div>
      <footer class="studio-dialog-footer"><button type="button" class="btn" data-close="blueprint-editor">Abbrechen</button><button type="submit" class="btn btn-primary" id="bp-save">Blueprint speichern</button></footer>
    </form>
  </dialog>

  <dialog id="instance-editor" class="studio-dialog studio-dialog-small" aria-labelledby="instance-title">
    <form id="instance-form">
      <header class="studio-dialog-header"><h2 id="instance-title">Steckplatz einrichten</h2><button type="button" class="btn" data-close="instance-editor">Schließen</button></header>
      <div class="studio-dialog-body">
        <p id="instance-description"></p>
        <div class="studio-fields">
          <label>Anbieter<select id="instance-backend"></select></label>
          <label>Modell<input id="instance-model" list="instance-models" required maxlength="120" /><datalist id="instance-models"></datalist></label>
          <label>Modus<select id="instance-mode"><option value="safe">Safe</option><option value="full">Full</option></select></label>
        </div>
        <p class="studio-note">Der Steckplatz wird als Living konfiguriert. Einen Worker startest du anschließend ausdrücklich; Aufgaben weist du im Taskboard zu.</p>
        <p id="instance-status" class="studio-message" role="status"></p>
      </div>
      <footer class="studio-dialog-footer"><button type="button" class="btn" data-close="instance-editor">Abbrechen</button><button type="submit" class="btn btn-primary" id="instance-save">Steckplatz einrichten</button></footer>
    </form>
  </dialog>

  <dialog id="prompt-editor" class="studio-dialog" aria-labelledby="prompt-title">
    <header class="studio-dialog-header"><h2 id="prompt-title">System- und Rollenvorlagen</h2><button class="btn" data-close="prompt-editor">Schließen</button></header>
    <div class="studio-dialog-body">
      <label>Vorlage<select id="prompt-key"></select></label>
      <label>Aktiver Prompt<textarea id="prompt-effective" rows="12"></textarea></label>
      <details><summary>Werkstandard anzeigen</summary><pre id="prompt-default" class="studio-prompt-preview"></pre></details>
      <p id="prompt-status" role="status" class="studio-message"></p>
    </div>
    <footer class="studio-dialog-footer"><button class="btn" id="prompt-reset">Werkstandard wiederherstellen</button><button class="btn btn-primary" id="prompt-save">Anpassung speichern</button></footer>
  </dialog>

  <dialog id="team-editor" class="studio-dialog studio-dialog-small" aria-labelledby="team-title">
    <form id="team-form">
      <header class="studio-dialog-header"><h2 id="team-title">Team anlegen</h2><button type="button" class="btn" data-close="team-editor">Schließen</button></header>
      <div class="studio-dialog-body">
        <label>Name<input id="team-name" required maxlength="120" /></label>
        <label>Beschreibung<textarea id="team-description" rows="3" maxlength="20000"></textarea></label>
        <label>Strategie<select id="team-strategy"><option value="swarm_parallel">Gleiche Aufgabe, verschiedene Perspektiven</option><option value="swarm_hierarchy">Koordination und Teilaufgaben</option><option value="sequential_pipeline">Schrittweise Übergabe</option></select></label>
        <p class="studio-note">Mitglieder auswählen</p><div id="team-members" class="studio-options"></div>
        <div id="team-models" class="studio-fields" aria-label="Modelle der Teammitglieder"></div>
        <p class="studio-note">Modellvorgaben je Mitglied; leer übernimmt dessen Steckplatzkonfiguration.</p>
        <label>Koordination<select id="team-leader"></select></label>
        <p id="team-status" class="studio-message" role="status"></p>
      </div>
      <footer class="studio-dialog-footer"><button type="button" class="btn" data-close="team-editor">Abbrechen</button><button type="submit" class="btn btn-primary">Team speichern</button></footer>
    </form>
  </dialog>
  </div>
</BachLayout>

<script>import "../../lib/agent-avatar-browser.mjs";import "../../scripts/blueprint-studio.mjs";import "../../lib/subscription-agents-client.mjs";</script>

<style>
  .workshop-scene{position:relative;isolation:isolate;padding:1.4rem;border:1px solid var(--border);border-radius:18px;min-height:calc(100vh - 160px)}
  .studio-header{padding:1.2rem;border:1px solid var(--border);border-radius:12px;background:var(--bg-panel)}
  .workshop-intro{flex:1;min-width:0}.workshop-intro .studio-note{margin-top:.5rem}
  .workshop-scene>.studio-message,.workshop-scene>.studio-toolbar,.workshop-scene>.studio-tabs,.workshop-scene>#studio-teams>.studio-section-heading,.workshop-scene>#studio-teams>.studio-note{background:var(--bg-panel);padding:.8rem 1rem;border-radius:8px}
  .workshop-scene>.studio-tabs{flex-wrap:wrap}.workshop-scene>.studio-toolbar{margin:.6rem 0}
  @media(max-width:640px){.workshop-scene{padding:.65rem;min-height:calc(100vh - 120px)}.studio-header{padding:1rem}.studio-header h1{font-size:1.7rem}.workshop-scene>.studio-toolbar{padding:.8rem}.studio-search{min-width:0;width:100%}}

  .studio-header,.studio-actions,.studio-toolbar,.studio-section-heading,.studio-dialog-header,.studio-dialog-footer,.studio-avatar-row{display:flex;align-items:center;justify-content:space-between;gap:.8rem;flex-wrap:wrap}
