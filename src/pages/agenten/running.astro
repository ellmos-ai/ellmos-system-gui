---
// running.astro - Deine Agenten · Living & Running
import BachLayout from "../../layouts/BachLayout.astro";
import portraitAtlas from '../../assets/agent-portraits.png';
import '../../styles/agent-avatars.css';
import '../../styles/ticket-symbols.css';
import {TICKET_SYMBOL_URLS} from '../../lib/ticket-symbol-assets.mjs';
---

<BachLayout title="Deine Agenten · Living & Running" currentPath="/agenten/running">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;flex-wrap:wrap;gap:1rem;">
    <div>
      <h1 style="font-size:1.75rem;font-weight:800;letter-spacing:-0.02em;margin-bottom:0.25rem;">
        ⚡ Deine Agenten · Living & Running
      </h1>
      <p style="color:var(--text-muted);font-size:0.875rem;">
        Running und Verlauf • Deine Agenten • Teams und Staffeln
      </p>
    </div>

    <div style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;">
      <a href="/agenten/blueprints?new=1" class="btn">
        <span>＋</span> Vorlage anlegen
      </a>
      <a href="/agenten/fabrika" class="btn">
        <span>🤖</span> Agenten-Bibliothek
      </a>
      <button class="btn btn-primary" onclick="refreshAll(true)">
        <span>🔄</span> Aktualisieren
      </button>
    </div>
  </div>

  <div class="running-history-group">
  <!-- Aktuell arbeitende Agenten; Ready-Worker werden nicht als Running ausgegeben. -->
  <section class="card" aria-labelledby="running-agents-title">
    <div class="card-header"><h2 class="card-title" id="running-agents-title">⚡ Running · Aktive Läufe</h2></div>

    <div class="agent-overview-controls" role="group" aria-label="Gemeinsame Gliederung für einsatzbereite und laufende Agenten">
      <label class="agent-overview-search">Suchen<input id="agent-overview-query" data-agent-overview-control="query" type="search" maxlength="120" placeholder="Name, Anbieter oder Modell" /></label>
      <label>Zugang<select id="agent-overview-access" data-agent-overview-control="access"><option value="all">Alle Zugänge</option><option value="local">Lokal</option><option value="cloud">Cloud / API</option><option value="prompt">Prompt / CLI</option><option value="unknown">Unbekannt</option></select></label>
      <label>Funktion<select id="agent-overview-function" data-agent-overview-control="function"><option value="all">Alle Funktionen</option></select></label>
      <label>Tatsächliche Startart<select id="agent-overview-start" data-agent-overview-control="start"><option value="all">Alle Startarten</option><option value="unknown">Unbekannt</option></select></label>
      <label>Sortierung<select id="agent-overview-sort" data-agent-overview-control="sort"><option value="name">Name</option><option value="access">Zugang</option><option value="function">Funktion</option><option value="start">Startart</option><option value="status">Status</option></select></label>
      <label>Gruppierung<select id="agent-overview-group" data-agent-overview-control="group"><option value="none">Aus</option><option value="access">Zugang</option><option value="function">Funktion</option><option value="start">Startart</option></select></label>
      <label>Darstellung<select id="agent-overview-view" data-agent-overview-control="view"><option value="cards">Karten</option><option value="list">Kompakte Liste</option></select></label>
      <small id="agent-overview-summary" role="status" aria-live="polite">Gemeinsame Filter für Running und Deine Agenten.</small>
    </div>

    <p id="running-empty-state" class="text-muted" role="status" aria-live="polite">Aktive Läufe werden geprüft…</p>
    <div id="running-system-slots-list" class="active-runs-grid" data-agent-overview-lane="running"></div>
    <div id="running-workers-list" class="active-runs-grid" data-agent-overview-lane="running"></div>
  </section>

  <!-- 6. VERLAUF SESSIONS & LÄUFE (TIMELINE) -->
  <details class="card" id="activity-timeline">
    <summary class="card-header" style="cursor:pointer;">📜 Verlauf: Sessions & Task-Läufe <span id="activity-count" class="badge">Wird geladen</span></summary>
    <p style="margin:1rem;"><a href="/agenten/sessions" class="btn btn-secondary btn-sm">Gespeicherte Dialoge & dauerhafte Taskereignisse öffnen</a></p>
    <button class="btn btn-sm" type="button" onclick="refreshActivity()">Neu laden</button>
    <div style="overflow:auto;max-height:420px;margin-top:0.75rem;">
      <table class="data-table" style="width:100%;">
        <thead>
          <tr>
            <th style="width:100px;">Zeit</th>
            <th style="width:160px;">Akteur</th>
            <th>Aktivität (Tool, Task, Runde)</th>
            <th style="width:140px;">Modell</th>
            <th style="width:90px;">Status</th>
          </tr>
        </thead>
        <tbody id="activity-tbody">
          <tr><td colspan="5" style="text-align:center;color:var(--text-muted);">Lade Aktivitäten...</td></tr>
        </tbody>
      </table>
    </div>
  </details>
  </div>

  <div class="agent-creation-group">
  <!-- 3. ANSICHT: DEINE AGENTEN (LIVING / READY) -->
  <details class="card collapsible-section" aria-labelledby="ready-agents-title" open>
    <summary class="card-header"><span><span class="card-title" id="ready-agents-title">✨ Deine Agenten</span><span class="section-description">Konfigurierte Agentenprofile in Ruhestellung · Erstellen, Bearbeiten, Zuweisen und ausdrücklich starten.</span></span></summary>
    <div class="section-action-bar">
      <div class="creation-actions">
        <button class="btn btn-sm btn-primary" type="button" onclick="openOneOffModal()">✨ Agenten erstellen</button>
        <button class="btn btn-sm" type="button" onclick="openPickupWerkstattModal()">🏭 Vorlage auswählen</button>
        <button class="btn btn-sm" type="button" onclick="openCoreEditor()">＋ Systemprofil</button>
      </div>
      <button class="btn btn-sm" type="button" onclick="loadBackgroundWorkers(); loadCoreSlots();">🔄 Neu prüfen</button>
    </div>
    <p id="worker-status-summary" role="status" aria-live="polite" style="font-size:0.8rem;color:var(--text-muted);margin:0.5rem 0 1rem 0;">Workerstatus wird geprüft…</p>
    <div id="ready-agents-grid" class="core-grid agent-overview-container" data-agent-overview-lane="ready" style="display:grid;grid-template-columns:repeat(auto-fit, minmax(290px, 1fr));gap:1rem;">
      <p class="loading-state" style="grid-column:1/-1;text-align:center;padding:2rem;">Prüfe einsatzbereite Agenten…</p>
    </div>
    <section class="core-agent-ready" aria-labelledby="core-agent-ready-title">
      <h3 id="core-agent-ready-title">System- und Core-Agenten</h3>
      <p class="section-description">Systemprofile nutzen dieselben Zugangs-, Funktions-, Startart- und Darstellungsfilter. Die Modellbindung steht direkt beim Agentenprofil; sie bestätigt keine Modellresidenz oder laufende Nutzung. Laufende Profile erscheinen im Running-Bereich.</p>
      <div id="core-agent-feedback" role="status" aria-live="polite"></div>
      <div id="core-agent-cards" class="core-grid agent-overview-container" data-agent-overview-lane="ready" style="display:grid;grid-template-columns:repeat(auto-fit, minmax(290px, 1fr));gap:1rem;">
        <p class="loading-state">System-Agenten werden geprüft…</p>
      </div>
    </section>
  </details>

  <!-- 4. ANSICHT: TEAMS UND STAFFELN -->
  <details class="card collapsible-section" open>
    <summary class="card-header"><span><span class="card-title" id="ready-teams-title">👥 Teams und Staffeln</span><span class="section-description">Teamkonfigurationen und sequenzielle Agenten- oder Skillfolgen erstellen und ausstatten.</span></span></summary>
    <div class="section-action-bar">
      <div class="creation-actions">
        <button class="btn btn-sm btn-primary" type="button" onclick="openPickupTeamModal()">👥 Team erstellen</button>
        <a class="btn btn-sm" href="/agenten/marblerun?new=1">⛓️ Staffel erstellen</a>
      </div>
      <button class="btn btn-sm" type="button" onclick="loadTeamsBeseelen(); loadStaffelnBeseelen();">🔄 Aktualisieren</button>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(320px, 1fr));gap:1.5rem;margin-top:1rem;align-items:start;">
      <!-- TEAMS BESEELEN -->
      <div class="card" id="teams" style="background:var(--bg-dark);border:1px solid var(--border);">
        <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;">
          <div>
            <h3 style="font-size:1.05rem;font-weight:700;margin:0;">👥 Teams (Swarm-AI)</h3>
            <p style="font-size:0.75rem;color:var(--text-muted);margin:0.15rem 0 0 0;">
              Mitglieder mit Modellen ausstatten & starten
            </p>
          </div>
          <button class="btn btn-sm btn-primary" onclick="openPickupTeamModal()">+ Team erstellen</button>
        </div>
        <div id="teams-beseelen-container" style="display:flex;flex-direction:column;gap:1rem;margin-top:0.75rem;">
          <p class="loading-state">Lade konfigurierte Teams...</p>
        </div>
      </div>

      <!-- AGENTEN-STAFFELN (MARBLERUN) BESEELEN -->
      <div class="card" id="staffeln" style="background:var(--bg-dark);border:1px solid var(--border);">
        <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;">
          <div>
            <h3 style="font-size:1.05rem;font-weight:700;margin:0;">⛓️ Agenten-Staffeln (MarbleRun)</h3>
            <p style="font-size:0.75rem;color:var(--text-muted);margin:0.15rem 0 0 0;">
              Schritte ansehen · Bearbeitung und Ausführung im Staffel-Editor
            </p>
          </div>
          <a href="/agenten/marblerun" class="btn btn-sm">Ketten-Editor ↗</a>
        </div>
        <div id="staffel-beseelen-container" style="display:flex;flex-direction:column;gap:1rem;margin-top:0.75rem;">
          <p class="loading-state">Lade Agenten-Staffeln...</p>
        </div>
      </div>
    </div>
  </details>

  </div>

  <div class="card models-relocated-banner" style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;padding:0.85rem 1.1rem;margin-bottom:1rem;">
    <div>
      <strong style="font-size:0.9rem;">🧠 Modelle & Ressourcen im System- und Einstellungsbereich</strong>
      <p style="font-size:0.8rem;color:var(--text-muted);margin:0.15rem 0 0 0;">Hardware-Fackel, Compute-Vorrang, lokale Modellkapazität und OpenRouter Free Tier befinden sich unter Einstellungen & Betrieb.</p>
    </div>
    <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
      <a href="/settings?tab=core" class="btn btn-sm btn-primary">Zu Modelle & Ressourcen →</a>
      <button type="button" class="btn btn-sm" onclick="const d=document.getElementById('running-models-resources-drawer');if(d)d.hidden=!d.hidden;">Hier ein-/ausblenden</button>
    </div>
  </div>

  <div id="running-models-resources-drawer" hidden>
  <!-- Gemessene lokale Modell- und Ressourcenansicht nach den Agentenbereichen. -->
  <details class="card hardware-torch" id="models-resources" aria-labelledby="models-resources-title">
    <summary class="torch-summary">
      <span id="models-resources-title">🧠 Modelle & Ressourcen</span>
      <span class="badge" id="torch-observed-at">Nicht geprüft</span>
    </summary>
    <div class="torch-grid">
      <div class="torch-panel torch-owner" role="status" aria-live="polite">
        <svg id="hardware-flame" class="torch-svg" viewBox="0 0 64 80" role="img" aria-labelledby="torch-svg-title">
          <title id="torch-svg-title">Hardware-Fackel ohne bestätigten Besitz</title>
          <path class="torch-flame-outer" d="M31 4c7 14 5 22 2 28 10-3 13-12 14-16 17 18 17 42 4 55-11 11-32 11-43-1C-2 59 2 41 15 28c1 9 3 14 8 17-2-16 1-29 8-41Z"/>
          <path class="torch-flame-inner" d="M33 39c2 7 6 10 9 15 5 11-1 22-11 22-10 0-16-11-11-21 2-5 8-10 13-16Z"/>
        </svg>
        <div>
          <strong>Aktueller Fackelhalter</strong>
          <p id="fackel-holder">Nicht geprüft</p>
          <small id="fackel-owner-reason">Ein aktueller Halternachweis fehlt.</small>
        </div>
      </div>
      <div class="torch-panel">
        <strong>Compute-Vorrang</strong>
        <p id="fackel-priority">Nicht geprüft</p>
        <button id="btn-toggle-fackel" class="btn btn-sm" type="button" onclick="toggleFackel()" disabled>Vorrang ändern</button>
        <small>Einstellung ändert die Bevorzugung zwischen Compute und Ollama.</small>
      </div>
      <div class="torch-panel">
        <strong>Lokaler Compute-Turn</strong>
        <p id="compute-turn-status">Nicht geprüft</p>
        <small><span id="compute-turn-reason">Aktueller Turn und wartende Vordergrundanfragen.</span></small>
      </div>
      <div class="torch-panel">
        <strong>Gemessene lokale Modellressourcen</strong>
        <p id="fackel-capacity">Nicht geprüft</p>
        <small id="fackel-loaded-models">Modellnamen nicht bestätigt.</small>
        <small id="fackel-compute">Geladene Einheiten & Hostverbindung.</small>
        <small class="torch-evidence-note">Die Belegung ist eine gemeinsame Hostmessung. Modellresidenz und RAM-Anteil je Agent oder Modell bleiben ohne eigenen Beleg unbekannt.</small>
      </div>
    </div>
    <p id="fackel-feedback" class="torch-feedback" role="status" aria-live="polite"></p>
  </details>

  <!-- 7. OPENROUTER FREE TIER KATALOG -->
  <details class="card collapsible-section" aria-labelledby="openrouter-title" style="margin-bottom:1.5rem;">
    <summary class="card-header">
      <span class="card-title" id="openrouter-title">OpenRouter · kostenlose Modelle (Free Tier)</span>
      <span class="badge" id="openrouter-credential-state">Wird geprüft</span>
    </summary>
    <p class="core-explanation">
      Der kostenlose Router und seine Modelle werden ausschließlich aus dem aktuellen Adapterkatalog angezeigt.
      Ohne Katalogantwort bleibt die Auswahl nicht verfügbar.
    </p>
    <datalist id="openrouter-free-models"></datalist>
    <p id="openrouter-catalog-state" role="status" aria-live="polite">Modellkatalog wird geladen…</p>
    <div id="openrouter-model-list" class="openrouter-model-list" role="list"></div>
  </details>
  </div>

  <!-- POP-UP MODAL 2: EIGENE EINZELANFERTIGUNG (ONE-OFF) -->
  <div id="modal-create-oneoff" class="modal-backdrop" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:1000;align-items:center;justify-content:center;backdrop-filter:blur(3px);">
    <div class="card" style="max-width:700px;width:94%;margin:auto;max-height:88vh;display:flex;flex-direction:column;box-shadow:0 15px 35px rgba(0,0,0,0.6);">
      <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;">
        <div>
          <h2 class="card-title" style="margin:0;">✨ Agenten erstellen</h2>
          <p style="font-size:0.75rem;color:var(--text-muted);margin:0.2rem 0 0 0;">Maßgeschneidertes Worker-Profil ohne vorherigen Blueprint anlegen</p>
        </div>
        <button class="btn btn-sm" onclick="closeOneOffModal()">✕</button>
      </div>

      <div style="padding:1.25rem;overflow-y:auto;flex:1;">
        <p id="worker-blueprint-description" class="worker-control-note">Vorlage wird aus der BACH-Rollendefinition geladen…</p>
        <form id="worker-blueprint-form" class="worker-blueprint-form">
          <details><summary>Bild & Symbol</summary>
            <input id="worker-avatar" type="hidden" /><input id="worker-symbol" type="hidden" />
            <div id="worker-avatar-preview"></div><div id="worker-avatar-presets" class="avatar-preset-picker"></div>
            <label>Eigenes Bild (PNG, JPEG oder WebP bis 180 KB)<input id="worker-avatar-upload" type="file" accept="image/png,image/jpeg,image/webp" onchange="uploadWorkerAvatar(this.files[0])" /></label>
            <div id="worker-symbols" class="symbol-picker"></div>
            <p id="worker-skill-state" role="status"></p>
            <button type="button" class="btn btn-sm" id="worker-refresh-skills" disabled onclick="refreshWorkerSkills()">Gebundene Skills auf aktuelle Fassung setzen</button>
          </details>
          <label>Anzeigename<input id="worker-blueprint-name" type="text" maxlength="120" value="BACH Hintergrundworker" required></label>
          <label>Worker-Modus<select id="worker-blueprint-sub-mode" required disabled><option value="">Modi werden geladen…</option></select></label>
          <label>Ausführung<select id="worker-blueprint-run-mode"><option value="continuous">Fortlaufend bis Stopp</option><option value="once">Einzellauf</option></select></label>
          <label>Task-ID (optional)<input id="worker-blueprint-task-id" type="number" min="1" max="2147483647" inputmode="numeric" placeholder="Für einen gezielten Auftrag"></label>
          <label>Backend
            <select id="worker-blueprint-backend">
              <option value="ollama-cloud">Ollama Cloud</option>
              <option value="openrouter">OpenRouter · kostenlos</option>
              <option value="ollama">Ollama lokal</option>
            </select>
          </label>
          <label>Modell<select id="worker-blueprint-model" required disabled><option value="">Modellkatalog wird geladen…</option></select></label>
          <label>Arbeitsmodus
            <select id="worker-blueprint-mode">
              <option value="safe">Sicher</option>
              <option value="full">Voller Modus</option>
            </select>
          </label>
          <label>Think
            <select id="worker-blueprint-think">
              <option value="true">Aktiv</option>
              <option value="false">Aus</option>
            </select>
          </label>
          <label>Maximale Tool-Runden (0 = unbegrenzt)<input id="worker-blueprint-turns" type="number" min="0" max="1000" value="25" required></label>
          <label>Pausenauslöser<select id="worker-blueprint-pause-basis"><option value="none">Keine Pause</option><option value="runs">Abgeschlossene Läufe</option><option value="tasks">Abgeschlossene Aufgaben</option></select></label>
          <label>Pause nach Anzahl Auslöser<input id="worker-blueprint-pause-after" type="number" min="0" max="100" value="5" required></label>
          <label>Pausendauer (Minuten)<input id="worker-blueprint-pause-minutes" type="number" min="0" max="1440" value="1" required></label>
          <label>Automatischer Stopp nach (Minuten, 0 = unbegrenzt)<input id="worker-blueprint-ttl" type="number" min="0" max="1440" value="0"></label>
          <div id="worker-blueprint-expert-fields" class="worker-blueprint-extra" hidden>
            <label>Fachrolle<select id="worker-blueprint-role" disabled><option value="">Rollen werden geladen…</option></select></label>
            <label class="worker-blueprint-check"><input id="worker-blueprint-multi-role" type="checkbox"> Flexibler Expertenrollen-Pool</label>
          </div>
          <div id="worker-blueprint-boss-fields" class="worker-blueprint-extra" hidden>
            <label>Maximale Unter-Experten<input id="worker-blueprint-max-experts" type="number" min="1" max="10" value="3" required></label>
            <label>Modellzuordnung je Experte (JSON, optional)<textarea id="worker-blueprint-expert-models" rows="2" maxlength="2000" placeholder='{"entwickler":"Modell-ID aus dem Katalog"}'></textarea></label>
          </div>
          <label class="worker-blueprint-prompt">Zusatzauftrag (optional)<textarea id="worker-blueprint-task-prompt" rows="3" maxlength="20000" placeholder="Leer lassen: Der Worker sucht nach dem Start eine offene BACH-Aufgabe."></textarea></label>
          <label class="worker-blueprint-check"><input id="worker-blueprint-system-prompt" type="checkbox" checked> BACH-Systemprompt einbinden</label>
          <label class="worker-blueprint-check"><input id="worker-blueprint-allow-tools" type="checkbox" checked> Werkzeuge erlauben</label>
          <div class="worker-blueprint-submit">
            <small id="worker-blueprint-model-status" role="status" aria-live="polite">Modellquelle wird geprüft…</small>
            <div style="display:flex;gap:0.5rem;">
              <button class="btn" id="worker-blueprint-cancel-edit" type="button" onclick="closeOneOffModal()">Schließen</button>
              <button class="btn btn-primary" id="worker-blueprint-create" type="submit" disabled>Blueprint als Living-Profil anlegen</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <dialog id="core-slot-editor" class="core-slot-modal" data-portrait-atlas={portraitAtlas.src} data-ticket-symbols={JSON.stringify(TICKET_SYMBOL_URLS)}>
    <form onsubmit="event.preventDefault();saveCoreSlot()">
      <header style="display:flex;justify-content:space-between;align-items:center;gap:1rem">
        <h2 id="core-slot-title">Agentenprofil bearbeiten</h2>
        <button type="button" class="btn btn-sm" onclick="document.getElementById('core-slot-editor').close()" aria-label="Schließen">✕</button>
      </header>
      <div id="core-slot-fields" class="core-fields"></div>
      <input type="hidden" id="core-slot-symbol" />
      <label>Symbol aus Ticket-Master<div id="core-slot-symbols" class="symbol-picker"></div></label>
      <label>Agentenbild
        <input id="core-slot-avatar-file" type="file" accept="image/png,image/jpeg,image/webp" onchange="uploadCoreAvatar(this.files[0])" />
      </label>
      <input id="core-slot-avatar" type="hidden" />
      <div id="core-slot-avatar-preview"></div>
      <div id="core-slot-avatar-presets" class="avatar-preset-picker" aria-label="Porträtvorlagen"></div>
      <button type="button" class="btn btn-sm" onclick="selectCoreAvatar('')">Standardbild verwenden</button>
      <p id="core-slot-editor-feedback" role="status" aria-live="polite"></p>
      <footer class="core-actions">
        <button type="submit" class="btn btn-primary">Speichern</button>
        <button id="core-slot-reset" type="button" class="btn" onclick="resetCoreSlot()">Werkstandard</button>
        <button id="core-slot-delete" type="button" class="btn" onclick="deleteCoreSlot()">Agentenprofil löschen</button>
      </footer>
    </form>
  </dialog>

  <style>
    :global(.worker-queue-details) {font-size:.8rem;line-height:1.45;margin:.5rem 0;color:var(--text);overflow-wrap:anywhere}
    :global(details.worker-queue-details summary) {cursor:pointer;font-weight:600}
    :global(.worker-queue-details p), :global(.worker-queue-details li) {margin:.3rem 0}
    :global(.worker-queue-details ul) {padding-left:1.25rem}
    :global(.worker-queue-details small) {display:block;color:var(--text-muted)}
    :global(.worker-selection-policy) {font-size:.8rem;line-height:1.45;margin:.5rem 0;color:var(--text);overflow-wrap:anywhere}
    :global(details.worker-selection-policy summary) {cursor:pointer;font-weight:600}
    :global(.worker-selection-policy p), :global(.worker-selection-policy li) {margin:.3rem 0}
    :global(.worker-selection-policy ul), :global(.worker-selection-policy ol) {padding-left:1.25rem}
    :global(.worker-selection-policy small) {display:block;color:var(--text-muted);margin-top:.4rem}
