  <script>import '../../lib/agent-avatar-browser.mjs';import '../../lib/ticket-symbol.mjs';import '../../lib/worker-queue-browser.mjs';import '../../lib/worker-selection-policy.mjs';import '../../scripts/agent-color.mjs';import * as AgentOverview from '../../lib/agent-overview.mjs';import {providerRequestStatusText} from '../../lib/provider-request-status.mjs';window.BachAgentOverview=AgentOverview;window.BachProviderRequestStatus=providerRequestStatusText;</script>
  <script is:inline>
    function escapeHtml(t) {
      if (t == null) return '';
      return String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    let currentPriority = null;
    let coreConfigVersion = null;
    let coreAgents = [];
    let openRouterModels = [];
    let backgroundWorkerBlueprint = null;
    let editingWorker = null;
    let workerModelRequest = 0;
    let workerEditRequest = 0;
    let _allBlueprintsList = [];

    // ── MODEL RESOURCES & HARDWARE EVIDENCE ──
    function setTorchUnknown(message) {
      currentPriority = null;
      const flame = document.getElementById('hardware-flame');
      flame.classList.remove('is-owned');
      document.getElementById('torch-svg-title').textContent = 'Hardware-Fackel ohne bestätigten Besitz';
      document.getElementById('fackel-holder').textContent = message;
      document.getElementById('fackel-owner-reason').textContent = 'Ein aktueller Halternachweis fehlt.';
      document.getElementById('fackel-priority').textContent = 'Nicht geprüft';
      document.getElementById('fackel-compute').textContent = 'Nicht geprüft';
      document.getElementById('fackel-capacity').textContent = 'Nicht geprüft';
      document.getElementById('fackel-loaded-models').textContent = 'Modellnamen nicht bestätigt.';
      document.getElementById('compute-turn-status').textContent = 'Nicht geprüft';
      document.getElementById('compute-turn-reason').textContent = 'Kein aktueller Turn-Nachweis.';
      document.getElementById('btn-toggle-fackel').disabled = true;
      document.getElementById('torch-observed-at').textContent = 'Nicht geprüft';
    }

    async function loadClusterCockpit() {
      try {
        const res = await fetch('/api/system/cluster-cockpit');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        const f = data.fackel;
        if (!f || !f.ownership || !f.capacity || !f.compute_lock) throw new Error('Statusantwort unvollständig');
        const owner = f.ownership;
        const ownerTime = Date.parse(owner.observed_at || '');
        const freshOwner = Number.isFinite(ownerTime) && Math.abs(Date.now() - ownerTime) <= 300000;
        const owned = owner.state === 'owned_by_this_system' && owner.holder_is_this_system === true && owner.flame === true && freshOwner;
        const flame = document.getElementById('hardware-flame');
        flame.classList.toggle('is-owned', owned);
        document.getElementById('torch-svg-title').textContent = owned ? 'Hardware-Fackel: BACH rechnet ohne gemeldete Compute-Konkurrenz' : 'Hardware-Fackel ohne bestätigten eigenen Besitz';
        document.getElementById('fackel-holder').textContent = owned ? String(owner.holder || 'Eigenes System') :
          owner.state === 'foreign' && freshOwner ? String(owner.holder || 'Fremdes System') :
          owner.state === 'competing_compute_reported' && freshOwner ? 'Rechenjobs melden Konkurrenz' :
          owner.state === 'idle' && freshOwner ? 'Derzeit kein lokaler BACH-Lauf' :
          owner.state === 'stale' ? 'Status veraltet' : 'Nicht geprüft';
        document.getElementById('fackel-owner-reason').textContent = owned ? 'Frischer Halternachweis für dieses System.' :
          owner.state === 'foreign' && freshOwner ? 'Ein anderes System hält die Fackel.' :
          owner.state === 'competing_compute_reported' && freshOwner ? 'Ein lokaler Compute-Lock meldet konkurrierende Rechenjobs; BACH-Besitz wird deshalb nicht behauptet.' :
          owner.state === 'idle' && freshOwner ? 'Der lokale Control-Dienst bestätigt, dass BACH gerade keine Inferenz ausführt.' :
          owner.state === 'stale' ? 'Der letzte Halternachweis ist zu alt.' : 'Der Hardware-Halteradapter fehlt oder liefert keinen Beleg.';
        currentPriority = ['compute', 'ollama'].includes(f.priority?.value) ? f.priority.value : null;
        document.getElementById('fackel-priority').textContent = currentPriority === 'compute' ? 'Compute' :
          currentPriority === 'ollama' ? 'Ollama' : 'Nicht geprüft';
        const button = document.getElementById('btn-toggle-fackel');
        button.disabled = !currentPriority;
        button.textContent = currentPriority === 'compute' ? 'Ollama-Vorrang setzen' :
          currentPriority === 'ollama' ? 'Compute-Vorrang setzen' : 'Vorrang nicht verfügbar';
        const lock = f.compute_lock;
        document.getElementById('fackel-compute').textContent = lock.state === 'reported_unverified' ?
          (Number.isSafeInteger(lock.reported_jobs) && lock.reported_jobs >= 0
            ? `Lockdatei meldet ${lock.reported_jobs} Job(s); Identität nicht geprüft`
            : 'Lockdatei meldet Jobs; Anzahl und Identität nicht geprüft') :
          lock.state === 'none_reported' ? 'Frische Lockdatei meldet keine Jobs' :
          lock.state === 'stale' ? 'Status veraltet' : 'Nicht geprüft';
        const turn = f.compute_turn;
        const confirmedTurn = turn && turn.source === 'local_control_api' && typeof turn.active === 'boolean';
        document.getElementById('compute-turn-status').textContent = confirmedTurn
          ? (turn.active ? 'Inferenz läuft · ' + (turn.priority === 'foreground' ? 'Vordergrund' : turn.priority === 'background' ? 'Hintergrund' : 'Priorität unbekannt') : 'Kein aktiver Turn')
          : 'Nicht geprüft';
        document.getElementById('compute-turn-reason').textContent = confirmedTurn
          ? (Number.isInteger(turn.foreground_waiters) && turn.foreground_waiters >= 0 ? turn.foreground_waiters + ' Vordergrundanfrage(n) warten.' : 'Wartende Anfragen nicht bestätigt.')
          : 'Control-Adapter meldet keinen bestätigten Turn.';
        const cap = f.capacity;
        const reportedModelCount = Number.isSafeInteger(cap.loaded_model_count) && cap.loaded_model_count >= 0
          ? cap.loaded_model_count : null;
        const reportedModels = Array.isArray(cap.loaded_models) && cap.loaded_models.every(model =>
          typeof model === 'string' && model.trim().length > 0) ? cap.loaded_models : null;
        const modelNamesComplete = reportedModels !== null && reportedModelCount === reportedModels.length;
        const capacityMeasured = cap.state === 'measured' && reportedModelCount !== null
          && Number.isFinite(cap.occupied_units) && cap.occupied_units >= 0
          && Number.isFinite(cap.used_gib) && cap.used_gib >= 0
          && Number.isFinite(cap.capacity_gib) && cap.capacity_gib > 0;
        const formatResourceNumber = value => new Intl.NumberFormat('de-DE', {maximumFractionDigits:2}).format(value);
        document.getElementById('fackel-capacity').textContent = capacityMeasured ?
          `${reportedModelCount} geladene Modelle · ${formatResourceNumber(cap.used_gib)} / ${formatResourceNumber(cap.capacity_gib)} GiB gemeinsame Modellkapazität · ${formatResourceNumber(cap.occupied_units)} Fackelanteile belegt` :
          cap.state === 'partial' ? 'Ollama antwortet; Fackelspeicher nicht messbar' :
          cap.state === 'measured' ? 'Messung unvollständig' : 'Nicht geprüft';
        document.getElementById('fackel-loaded-models').textContent = modelNamesComplete ?
          (reportedModelCount === 0 ? 'Ollama meldet keine geladenen Modelle.' : `Ollama meldet geladene Modelle: ${reportedModels.join(', ')}`) :
          reportedModelCount !== null ? `${reportedModelCount} Modelle gemeldet; Modellnamen nicht vollständig bestätigt.` :
          cap.state === 'partial' ? 'Ollama antwortet; Modellnamen sind nicht bestätigt.' : 'Modellnamen nicht bestätigt.';
        const observed = Date.parse(data.observed_at || '');
        document.getElementById('torch-observed-at').textContent = Number.isFinite(observed) ?
          'Geprüft ' + new Date(observed).toLocaleTimeString('de-DE', {hour:'2-digit', minute:'2-digit'}) : 'Nicht geprüft';
      } catch (_error) {
        setTorchUnknown('Nicht geprüft');
      }
    }

    async function toggleFackel() {
      if (!currentPriority) return;
      const desired = currentPriority === 'compute' ? 'ollama' : 'compute';
      const button = document.getElementById('btn-toggle-fackel');
      const feedback = document.getElementById('fackel-feedback');
      button.disabled = true;
      feedback.textContent = 'Vorrang wird gespeichert…';
      try {
        const res = await fetch('/api/system/fackel', {
          method: 'POST', headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({preference: desired})
        });
        const data = await res.json();
        if (!res.ok || data.ok !== true || data.preference !== desired || data.ownership_changed !== false) {
          throw new Error('Speicherung nicht bestätigt');
        }
        await loadClusterCockpit();
        if (currentPriority !== desired) throw new Error('Readback weicht ab');
        feedback.textContent = 'Vorrang gespeichert. Der Fackelbesitz wurde nicht verändert.';
      } catch (_error) {
        feedback.textContent = 'Vorrang konnte nicht bestätigt werden.';
        await loadClusterCockpit();
      }
    }

    // ── CORE SYSTEM SLOTS ──
    function coreElement(tag, text, className = '') {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined) node.textContent = String(text);
      return node;
    }

    function coreAgentAccessLabel(agent) {
      const category = window.BachAgentOverview?.classifyAgentAccess(agent) || 'unknown';
      return window.BachAgentOverview?.agentOverviewAccessLabels()[category] || 'Unbekannt';
    }

    function coreAgentLabel(agent) {
      if (agent.runtime_verified !== true) return 'Status unbekannt';
      if (agent.status === 'stopping') return 'Wird beendet';
      if (agent.status === 'starting') return 'Startet';
      if (agent.running === true) return 'Running';
      if (agent.status === 'error') return 'Fehler · Status prüfen';
      if (agent.status === 'expired') return 'Abgelaufen';
      if (agent.status === 'deleted') return 'Entfernt';
      if (agent.enabled !== true || agent.pause_info?.is_paused || agent.status === 'paused') return 'Pausiert';
      if (!String(agent.backend || '').trim() || !String(agent.model || '').trim()) return 'Modell oder Anbieter fehlt';
      return ['idle', 'ready', 'completed'].includes(agent.status) ? 'Ready · Living' : 'Status unbekannt';
    }

    const runningGroupStates = {
      slots: {count: 0, state: 'loading'},
      workers: {count: 0, state: 'loading'}
    };
    let agentOverviewController = null;
    let runningCoreAgentIds = new Set();

    function beginAgentOverviewContainer(id) {
      const container = document.getElementById(id);
      agentOverviewController?.beginContainer(container);
      return container;
    }

    function registerAgentOverviewCard(container, card, agent, source, lane) {
      return agentOverviewController?.register(container, card, agent, {source, lane});
    }

    function labelReportedModelName(content) {
      for (const item of content.querySelectorAll(".agent-overview-runtime-meta-item")) {
        if (item.textContent.startsWith("Modell: ")) item.textContent = item.textContent.replace(/^Modell:/, "Gemeldeter Modellname:");
      }
    }

    function renderAgentOverviewCardContent(card, agent, source, statusLabel) {
      const overview = window.BachAgentOverview;
      if (!card || typeof card.querySelector !== 'function' || typeof card.replaceChildren !== 'function'
          || typeof overview?.createAgentOverviewContent !== 'function') return;
      const avatarNode = card.querySelector('.agent-avatar-preview, .core-avatar');
      const symbolNode = card.querySelector('.core-slot-identity .ticket-symbol');
      const preserved = [...card.children].filter(node => node.matches?.('.agent-overview-actions, .core-actions, details'));
      if (source === 'core') {
        const toggle = card.querySelector(':scope > .core-slot-header .core-slot-toggle');
        const actions = preserved.find(node => node.matches?.('.core-actions'));
        if (toggle && actions) actions.prepend(toggle);
      }
      const content = overview.createAgentOverviewContent(document, agent, {source, statusLabel, avatarNode, symbolNode});
      labelReportedModelName(content);
      card.replaceChildren(content, ...preserved);
    }

    function updateAgentOverviewSummary(result) {
      const summary = document.getElementById('agent-overview-summary');
      if (summary) summary.textContent = `${result.visible} von ${result.total} beobachteten Agenten sichtbar · tatsächliche Startart nur mit Laufzeitbeleg, derzeit unbekannt.`;
    }

    function applyAgentOverviewControls() {
      agentOverviewController?.refresh();
    }

    function initializeAgentOverviewControls() {
      const overview = window.BachAgentOverview;
      if (!overview) return;
      agentOverviewController = overview.createAgentOverviewController(document, {onRefresh:updateAgentOverviewSummary});
      agentOverviewController.bind();
      applyAgentOverviewControls();
    }

    function updateRunningGroupState(group, count, state) {
      runningGroupStates[group] = {count, state};
      const notice = document.getElementById('running-empty-state');
      const sources = Object.values(runningGroupStates);
      const projection = window.BachAgentOverview?.projectRunningSourceNotice(sources, 'Kein Agentenlauf aktiv.')
        || {hidden: false, text: 'Laufstatus derzeit nicht vollständig bestätigt.'};
      notice.hidden = projection.hidden;
      notice.textContent = projection.text;
    }

    const workerSelectionOutcomes = new Map([
      ['resumed', 'Gebundene Aufgabe fortgesetzt'],
      ['normal_task', 'Normale Aufgabe ausgewählt'],
      ['review_task', 'Review-Aufgabe als Ersatz ausgewählt'],
      ['decomposed', 'Komplexe Aufgabe an Task-Divider übergeben'],
      ['idle', 'Keine passende Aufgabe ausgewählt'],
    ]);

    function readWorkerSelectionEvidence(value, now = Date.now()) {
      if (!value || typeof value !== 'object' || Array.isArray(value)
          || value.schema !== 'bach.task-selection-diagnostics.v1'
          || !workerSelectionOutcomes.has(value.outcome)
          || !(value.task_id === null || (Number.isSafeInteger(value.task_id) && value.task_id > 0))
          || typeof value.reason !== 'string' || !value.reason.trim() || value.reason.length > 500
          || !Number.isSafeInteger(value.excluded_count) || value.excluded_count < 0
          || !Array.isArray(value.exclusions) || value.exclusions.length > 20
          || value.excluded_count < value.exclusions.length) return null;
      const observedAt = Date.parse(value.observed_at || '');
      if (!Number.isFinite(observedAt) || observedAt > now + 30000 || now - observedAt > 120000) return null;
      const exclusions = [];
      for (const item of value.exclusions) {
        if (!item || typeof item !== 'object' || Array.isArray(item)
            || !Number.isSafeInteger(item.task_id) || item.task_id <= 0
            || typeof item.reason_code !== 'string' || !item.reason_code.trim() || item.reason_code.length > 80
            || typeof item.reason !== 'string' || !item.reason.trim() || item.reason.length > 500) return null;
        exclusions.push({taskId:item.task_id, reasonCode:item.reason_code, reason:item.reason});
      }
      return {observedAt, outcome:value.outcome, taskId:value.task_id, reason:value.reason,
        excludedCount:value.excluded_count, exclusions};
    }

    function appendWorkerSelectionEvidence(card, worker) {
      const details = document.createElement('details');
      details.className = 'worker-selection-evidence';
      const summary = document.createElement('summary');
      summary.textContent = 'Task-Auswahl und Ausschlussgründe';
      const body = document.createElement('div');
      body.className = 'worker-selection-evidence-body';
      const raw = worker?.selection_diagnostics;
      const evidence = readWorkerSelectionEvidence(raw);
      if (!raw || typeof raw !== 'object') {
        body.append(coreElement('p', 'Backend liefert derzeit keinen Auswahlbeleg.', 'text-muted'));
      } else if (!evidence) {
        body.append(coreElement('p', 'Auswahlbeleg fehlt, ist veraltet oder entspricht nicht dem bestätigten Schema.', 'text-muted'));
      } else {
        const selected = evidence.taskId === null ? 'Keine Task ausgewählt' : 'Task #' + evidence.taskId;
        body.append(coreElement('p', workerSelectionOutcomes.get(evidence.outcome) + ' · ' + selected +
          ' · Stand ' + new Date(evidence.observedAt).toLocaleTimeString('de-DE'), 'text-muted'));
        body.append(coreElement('p', evidence.reason));
        if (evidence.exclusions.length) {
          const list = document.createElement('ul');
          for (const item of evidence.exclusions) {
            const row = document.createElement('li');
            row.textContent = 'Task #' + item.taskId + ' · ' + item.reasonCode + ': ' + item.reason;
            list.append(row);
          }
          body.append(list);
        }
        if (evidence.excludedCount > evidence.exclusions.length) {
          body.append(coreElement('p', (evidence.excludedCount - evidence.exclusions.length) +
            ' weitere Ausschlüsse werden nicht einzeln angezeigt.', 'text-muted'));
        }
      }
      details.append(summary, body);
      card.append(details);
    }

    function renderRunningSystemSlots(agents) {
      const target = typeof beginAgentOverviewContainer === 'function'
        ? beginAgentOverviewContainer('running-system-slots-list')
        : document.getElementById('running-system-slots-list');
      target.replaceChildren();
      const active = agents.filter(agent => agent.runtime_verified === true && agent.running === true && !['starting','stopping'].includes(agent.status));
      runningCoreAgentIds = new Set(active.map(agent => String(agent.id)));
      const unknown = agents.filter(agent => agent.runtime_verified !== true || typeof agent.running !== 'boolean');
      const transitioning = agents.some(agent => ['starting','stopping'].includes(agent.status));
      updateRunningGroupState('slots', active.length, unknown.length || transitioning ? 'unconfirmed' : 'available');
      if (unknown.length) target.append(coreElement('p','Laufstatus unvollständig · ' + unknown.length + ' Systemagent(en) sind nicht bestätigt.','text-muted'));
      if (transitioning) target.append(coreElement('p','Ein Systemagent startet oder beendet seinen Lauf.','text-muted'));
    }

    function coreField(card, field, labelText, value, type = 'text', options = [], backend = '') {
      const label = coreElement('label', labelText);
      let input;
      if (type === 'select') {
        input = document.createElement('select');
        const choices = options.map(choice => typeof choice === 'string'
          ? {value: choice, label: choice}
          : {value: String(choice.value), label: String(choice.label ?? choice.value)});
        const currentValue = String(value ?? '');
        const values = choices.some(choice => choice.value === currentValue)
          ? choices
          : [{value: currentValue, label: currentValue + ' · bestehend, nicht geprüft'}, ...choices];
        for (const choice of values) {
          const option = document.createElement('option');
          option.value = choice.value;
          option.textContent = choice.label;
          input.append(option);
        }
        input.value = currentValue;
      } else {
        input = document.createElement('input');
        input.type = type;
        if (type === 'checkbox') input.checked = value === true;
        else input.value = value == null ? '' : String(value);
        if (type === 'number') { input.min = '0'; input.max = field === 'max_tool_rounds' ? '1000' : '1440'; }
        if (type === 'text') input.maxLength = field === 'icon' ? 8 : 120;
        if (field === 'model' && backend === 'openrouter') input.setAttribute('list', 'openrouter-free-models');
      }
      input.dataset.coreField = field;
      label.append(input);
      if (type === 'checkbox') label.className = 'core-check';
      card.append(label);
    }

    let coreRefreshEpoch = 0;
    let workerRefreshEpoch = 0;
    let coreCatalog = {};
    let coreEditorAgent = null;
    let coreEditorVersion = null;

    function renderCoreAgents(data) {
      coreRefreshEpoch += 1;
      coreConfigVersion = data.configuration_version;
      coreAgents = data.agents;
      coreCatalog = data;
      if (typeof window.dispatchEvent === 'function' && typeof window.CustomEvent === 'function')
        window.dispatchEvent(new window.CustomEvent('bach:core-config-observed', {detail:{configuration_version:data.configuration_version}}));
      renderRunningSystemSlots(coreAgents);
      const target = typeof beginAgentOverviewContainer === 'function'
        ? beginAgentOverviewContainer('core-agent-cards') : document.getElementById('core-agent-cards');
      const runningTarget = document.getElementById('running-system-slots-list');
      const activeCoreIds = typeof runningCoreAgentIds === 'undefined' ? new Set() : runningCoreAgentIds;
      target.replaceChildren();
      for (const agent of coreAgents) {
        const card = coreElement('article', undefined, 'core-agent-card');
        card.dataset.coreAgentId = agent.id;
        const header = coreElement('div', undefined, 'core-slot-header');
        const enabled = agent.enabled === true;
        const toggle = coreElement('button', enabled ? '● AN' : '○ AUS', 'btn btn-sm core-slot-toggle');
        toggle.type = 'button';
        toggle.setAttribute('role', 'switch');
        toggle.setAttribute('aria-checked', String(enabled));
        toggle.setAttribute('aria-label', agent.name + ' ein- oder ausschalten');
        toggle.dataset.enabled = String(enabled);
        toggle.addEventListener('click', () => toggleCoreSlot(agent.id, !enabled));
        header.append(toggle);
        const badge = coreElement('span', coreAgentLabel(agent), 'badge');
        header.append(badge);
        card.append(header);
        const identity = coreElement('div', undefined, 'core-slot-identity');
        identity.append(window.BachAvatars.createAvatar(document, agent.avatar, agent,
          document.getElementById('core-slot-editor').dataset.portraitAtlas, 'core-avatar'));
        identity.append(coreElement('h3', agent.name || agent.id));
        identity.append(window.BachSymbols.createSymbol(document,agent.symbol,
          JSON.parse(document.getElementById('core-slot-editor').dataset.ticketSymbols)));
        card.append(identity);
        card.append(coreElement('small', agent.id, 'core-slot-id'));
        card.append(coreElement('small', coreAgentAccessLabel(agent) + ' · ' + (agent.backend || 'Anbieter unbekannt')));
        card.append(coreElement('div', 'Modellbindung: ' + (agent.model || 'Modell fehlt'), 'core-slot-model'));
        if (agent.runtime_verified === true && agent.running === true && agent.resolved_model && agent.resolved_model !== agent.model)
          card.append(coreElement('small', 'Gemeldetes Laufzeitmodell: ' + agent.resolved_model));
        card.append(coreElement('small', agent.runtime_verified === true
          ? 'Tool: ' + (agent.current_tool || '—') + ' · Runde: ' + (agent.tool_round ?? 0) +
            (agent.task_id ? ' · Task #' + agent.task_id : '')
          : 'Tool / Runde: nicht bestätigt'));
        const actions = coreElement('div', undefined, 'core-actions');
        const edit = coreElement('button', 'Bearbeiten', 'btn btn-sm');
        edit.addEventListener('click', () => openCoreEditor(agent.id));
        actions.append(edit);
        const chat = coreElement('a', 'Chat öffnen', 'btn btn-sm');
        chat.href = '/chat?slot_id=' + encodeURIComponent(agent.id);
        actions.append(chat);
        const assign = coreElement('a','Aufgabe zuweisen','btn btn-sm');
        assign.href = '/tasks?create=1&assign_slot=' + encodeURIComponent(agent.id);
        actions.append(assign);
        card.append(actions);
        if (activeCoreIds.has(String(agent.id))) {
          card.dataset.runningSlot = agent.id;
          card.dataset.coreAgentId = agent.id;
          appendWorkerSelectionEvidence(card, agent);
          renderAgentOverviewCardContent(card, agent, 'core', coreAgentLabel(agent));
          runningTarget.append(card);
          if (typeof registerAgentOverviewCard === 'function') registerAgentOverviewCard(runningTarget, card, agent, 'core', 'running');
        } else {
          renderAgentOverviewCardContent(card, agent, 'core', coreAgentLabel(agent));
          target.append(card);
          if (typeof registerAgentOverviewCard === 'function') registerAgentOverviewCard(target, card, agent, 'core', 'ready');
        }
        window.BachAgentColor?.applyAgentColor(card, agent);
      }
      const add = coreElement('button', '+ Agentenprofil', 'btn core-slot-add');
      add.addEventListener('click', () => openCoreEditor());
      target.append(add);
      if (typeof renderCoreQueueDiagnostics === 'function') renderCoreQueueDiagnostics();
      if (typeof applyAgentOverviewControls === 'function') applyAgentOverviewControls();
    }

    async function coreRequest(path, method = 'GET', body) {
      if (method !== 'GET') coreRefreshEpoch += 1;
      const response = await fetch('/api/system/core-agents' + path, {
        method, headers: body ? {'Content-Type': 'application/json'} : {},
        ...(body ? {body: JSON.stringify(body)} : {})
      });
      const data = await response.json();
      if (!response.ok) throw new Error(typeof data.detail === 'string' ? data.detail : 'HTTP ' + response.status);
      if (data.schema !== 'bach.core-system-agents.v1' || !Array.isArray(data.agents)) throw new Error('Agentenprofilantwort ungültig');
      return data;
    }

    async function loadCoreSlots() {
      const epoch = ++coreRefreshEpoch;
      try {
        const data = await coreRequest('');
        if (epoch !== coreRefreshEpoch) return;
        renderCoreAgents(data);
      } catch (error) {
        if (epoch !== coreRefreshEpoch) return;
        coreConfigVersion = null;
        updateRunningGroupState('slots', 0, 'unavailable');
        beginAgentOverviewContainer('running-system-slots-list');
        beginAgentOverviewContainer('core-agent-cards');
        document.getElementById('running-system-slots-list').replaceChildren(coreElement('p','Laufstatus der Systemagenten nicht verfügbar.'));
        document.getElementById('core-agent-cards').replaceChildren(
          coreElement('p', 'System-Agenten nicht verfügbar: ' + error.message));
        applyAgentOverviewControls();
      }
    }

    function openCoreEditor(slotId = null) {
      if (!coreConfigVersion) return;
      coreEditorAgent = slotId ? coreAgents.find(agent => agent.id === slotId) : null;
      coreEditorVersion = coreConfigVersion;
      const source = coreEditorAgent || {...coreAgents.find(agent => agent.id === 'buddha_chat'), name: '', avatar: '', icon: '🤖'};
      const form = document.getElementById('core-slot-fields');
      form.replaceChildren();
      document.getElementById('core-slot-title').textContent = slotId ? 'Agentenprofil bearbeiten' : 'Agentenprofil anlegen';
      if (!slotId) coreField(form, 'preset', 'Vorlage', 'assistant', 'select',
        Object.entries(coreCatalog.slot_presets || {}).map(([value, item]) => ({value, label:item.name})));
      coreField(form, 'name', 'Bezeichnung', source.name);
      coreField(form, 'description', 'Beschreibung', source.description || '');
      if (coreCatalog.color_contract === 'bach.agent-colors.v1') {
        coreField(form, 'color_override', 'Eigene Farbe (#RRGGBB, leer = Blueprint/Standard)', coreEditorAgent?.color_override || '');
        const colorInput = form.querySelector('[data-core-field="color_override"]');
        colorInput.maxLength = 7;
        colorInput.pattern = '#[0-9a-fA-F]{6}';
        colorInput.placeholder = coreEditorAgent?.blueprint_color || '#3b82f6';
      }
      coreField(form, 'backend', 'Anbieter', source.backend, 'select', coreCatalog.supported_backend_ids || []);
      coreField(form, 'model', 'Modell', source.model, 'text', [], source.backend);
      coreField(form, 'mode', 'Arbeitsmodus', source.mode, 'select', ['safe', 'full']);
      coreField(form, 'role_id', 'Rolle', source.role_id || 'personal-assistant', 'select', coreCatalog.role_ids || []);
      coreField(form, 'sub_mode', 'Rollenmodus', source.sub_mode || 'expert_role', 'select',
        ['expert_role', 'boss_routing', 'task_worker', 'hintergrund_worker']);
      coreField(form, 'think', 'Denken', source.think, 'checkbox');
      coreField(form, 'allow_tools', 'Werkzeuge erlauben', source.allow_tools !== false, 'checkbox');
      coreField(form, 'max_tool_rounds', 'Maximale Tool-Runden (0 = unbegrenzt)', source.max_tool_rounds, 'number');
      coreField(form, 'pause_after', 'Pause nach', source.pause_after, 'number');
      coreField(form, 'pause_basis', 'Pausenauslöser', Number(source.pause_after ?? 5) === 0 ? 'none' : source.pause_basis, 'select',
        [{value:'none', label:'Keine Pause'}, {value:'runs', label:'Läufe'}, {value:'tasks', label:'Aufgaben'}]);
      coreField(form, 'pause_minutes', 'Pausendauer (Minuten)', source.pause_minutes, 'number');
      coreField(form, 'include_system_prompt', 'Systemprompt einbinden', source.include_system_prompt !== false, 'checkbox');
      const pauseBasis = form.querySelector('[data-core-field="pause_basis"]');
      const syncPauseInputs = () => {
        const disabled = pauseBasis.value === 'none';
        for (const field of ['pause_after', 'pause_minutes']) {
          const input = form.querySelector('[data-core-field="' + field + '"]');
          input.disabled = disabled;
          if (!disabled && Number(input.value) === 0) input.value = '1';
        }
      };
      pauseBasis.addEventListener('change', syncPauseInputs);
      syncPauseInputs();
      const templates = coreCatalog.prompt_templates || {system_default:'', roles:{}};
      for (const [field, label, defaultText] of [
        ['custom_system_prompt', 'Systemprompt', templates.system_default],
        ['custom_role_prompt', 'Rollenprompt', templates.roles[source.sub_mode === 'task_worker' ? 'task_worker' :
          source.sub_mode === 'hintergrund_worker' ? 'hintergrund_worker' :
          source.sub_mode === 'boss_routing' ? 'boss_routing' : source.role_id] || '']
      ]) {
        const row = coreElement('label', label, 'core-prompt-field');
        const input = document.createElement('textarea');
        input.rows = 7; input.maxLength = 20000; input.dataset.coreField = field;
        input.dataset.defaultText = defaultText;
        input.dataset.wasCustom = source[field] ? 'true' : 'false';
        input.value = source[field] || defaultText;
        row.append(input);
        const reset = coreElement('button', 'Standard verwenden', 'btn btn-sm');
        reset.type = 'button';
        reset.addEventListener('click', () => {input.value = input.dataset.defaultText; input.dataset.wasCustom = 'false';});
        row.append(reset); form.append(row);
      }
      const roleInput = form.querySelector('[data-core-field="role_id"]');
      const modeInput = form.querySelector('[data-core-field="sub_mode"]');
      const updateRole = () => {
        const input = form.querySelector('[data-core-field="custom_role_prompt"]');
        const key = ['boss_routing', 'task_worker', 'hintergrund_worker'].includes(modeInput.value) ? modeInput.value : roleInput.value;
        input.dataset.defaultText = templates.roles[key] || '';
        if (input.dataset.wasCustom !== 'true') input.value = input.dataset.defaultText;
        drawCoreAvatar();
      };
      roleInput.addEventListener('change', updateRole);
      modeInput.addEventListener('change', updateRole);
      form.querySelector('[data-core-field="preset"]')?.addEventListener('change', event => {
        const preset = coreCatalog.slot_presets[event.target.value];
        if (!preset) return;
        roleInput.value = preset.role_id;
        modeInput.value = preset.sub_mode || 'expert_role';
        if (!form.querySelector('[data-core-field="name"]').value) form.querySelector('[data-core-field="name"]').value = preset.name;
        updateRole();
      });
      document.getElementById('core-slot-avatar').value = source.avatar || '';
      document.getElementById('core-slot-symbol').value = source.symbol || '';
      drawCoreSymbols();
      drawCoreAvatar();
      document.getElementById('core-slot-avatar-file').value = '';
      document.getElementById('core-slot-delete').hidden = !coreEditorAgent?.deletable;
      document.getElementById('core-slot-reset').hidden = !coreEditorAgent;
      document.getElementById('core-slot-editor-feedback').textContent = '';
      document.getElementById('core-slot-editor').showModal();
    }

    function drawCoreAvatar() {
      const value = document.getElementById('core-slot-avatar').value;
      const identity = {...coreEditorAgent,role_id:document.querySelector('[data-core-field="role_id"]')?.value};
      const atlas = document.getElementById('core-slot-editor').dataset.portraitAtlas;
      document.getElementById('core-slot-avatar-preview').replaceChildren(window.BachAvatars.createAvatar(document,value,identity,atlas,'agent-avatar-preview'));
      window.BachAvatars.mountAvatarPicker(document.getElementById('core-slot-avatar-presets'),value,identity,atlas,selectCoreAvatar);
    }

    function selectCoreAvatar(value) {
      document.getElementById('core-slot-avatar').value = value;
      drawCoreAvatar();
      document.getElementById('core-slot-editor-feedback').textContent = 'Bild vorbereitet. Mit Speichern übernehmen.';
    }

    function drawCoreSymbols() {
      const input=document.getElementById('core-slot-symbol');
      window.BachSymbols.mountSymbolPicker(document.getElementById('core-slot-symbols'),input.value,
        JSON.parse(document.getElementById('core-slot-editor').dataset.ticketSymbols),value=>{input.value=value;drawCoreSymbols();});
    }

    async function uploadCoreAvatar(file) {
      if (!file) return;
      if (!['image/png', 'image/jpeg', 'image/webp'].includes(file.type) || file.size > 5 * 1024 * 1024) {
        document.getElementById('core-slot-editor-feedback').textContent = 'Bitte PNG, JPEG oder WebP bis 5 MB wählen.';
        return;
      }
      const url = URL.createObjectURL(file);
      try {
        const image = new Image(); image.src = url; await image.decode();
        const canvas = document.createElement('canvas'); canvas.width = 256; canvas.height = 256;
        const context = canvas.getContext('2d');
        const size = Math.min(image.width, image.height);
        context.drawImage(image, (image.width-size)/2, (image.height-size)/2, size, size, 0, 0, 256, 256);
        document.getElementById('core-slot-avatar').value = canvas.toDataURL('image/webp', 0.85);
        drawCoreAvatar();
        document.getElementById('core-slot-editor-feedback').textContent = 'Bild vorbereitet. Mit Speichern übernehmen.';
      } catch (_error) { document.getElementById('core-slot-editor-feedback').textContent = 'Bild konnte nicht geladen werden.'; }
      finally { URL.revokeObjectURL(url); }
    }

    async function saveCoreSlot() {
      const form = document.getElementById('core-slot-fields');
      const feedback = document.getElementById('core-slot-editor-feedback');
      const changes = {};
      let preset = 'assistant';
      for (const input of form.querySelectorAll('[data-core-field]')) {
        const field = input.dataset.coreField;
        if (field === 'preset') {preset = input.value; continue;}
        let value = input.type === 'checkbox' ? input.checked : input.type === 'number' ? Number(input.value) : input.value;
        if (field.startsWith('custom_') && input.dataset.wasCustom !== 'true' && value === input.dataset.defaultText) value = '';
        if (field === 'color_override') {
          value = value === '' ? null : value.toLowerCase();
          if (!coreEditorAgent || value !== (coreEditorAgent.color_override ?? null)) changes[field] = value;
        } else if (!coreEditorAgent || value !== coreEditorAgent[field]) changes[field] = value;
      }
      if (form.querySelector('[data-core-field="pause_basis"]')?.value === 'none') {
        delete changes.pause_basis;
        changes.pause_after = 0;
      }
      const avatar = document.getElementById('core-slot-avatar').value;
      if (!coreEditorAgent || avatar !== coreEditorAgent.avatar) changes.avatar = avatar;
      const symbol = document.getElementById('core-slot-symbol').value;
      if (!coreEditorAgent || symbol !== coreEditorAgent.symbol) changes.symbol = symbol;
      if (!Object.keys(changes).length) {feedback.textContent = 'Keine Änderungen.'; return;}
      try {
        const data = await coreRequest(coreEditorAgent ? '/' + encodeURIComponent(coreEditorAgent.id) : '',
          coreEditorAgent ? 'PUT' : 'POST', {configuration_version:coreEditorVersion, changes, preset});
        if (Object.hasOwn(changes, 'color_override')) {
          const saved = data.agents.find(agent => agent.id === (coreEditorAgent?.id || data.slot_id));
          if (!saved || saved.color_override !== changes.color_override)
            throw new Error('Gespeicherte Farbe nicht bestätigt. Entwurf bleibt geöffnet.');
        }
        renderCoreAgents(data);
        document.getElementById('core-slot-editor').close();
        document.getElementById('core-agent-feedback').textContent = 'Agentenprofil gespeichert.';
      } catch (error) {feedback.textContent = 'Speichern fehlgeschlagen: ' + error.message;}
    }

    async function resetCoreSlot() {
      if (!coreEditorAgent || !confirm('Agentenprofil auf Werkstandard zurücksetzen?')) return;
      try {
        renderCoreAgents(await coreRequest('/' + encodeURIComponent(coreEditorAgent.id) + '/reset', 'POST', {configuration_version:coreEditorVersion}));
        document.getElementById('core-slot-editor').close();
      } catch (error) {document.getElementById('core-slot-editor-feedback').textContent = error.message;}
    }

    async function deleteCoreSlot() {
      if (!coreEditorAgent?.deletable || !confirm('Diesen Systemsteckplatz löschen?')) return;
      try {
        renderCoreAgents(await coreRequest('/' + encodeURIComponent(coreEditorAgent.id), 'DELETE', {configuration_version:coreEditorVersion}));
        document.getElementById('core-slot-editor').close();
      } catch (error) {document.getElementById('core-slot-editor-feedback').textContent = error.message;}
    }

    async function toggleCoreSlot(slotId, enabled) {
      const feedback = document.getElementById('core-agent-feedback');
      try {
        const data = await coreRequest('/' + encodeURIComponent(slotId) + '/toggle', 'POST',
          {configuration_version:coreConfigVersion, enabled});
        renderCoreAgents(data);
        feedback.textContent = enabled ? 'Agentenprofil eingeschaltet; Live-Status wird geprüft.' :
          'Agentenprofil ausgeschaltet. Laufende Arbeit wird beendet; Status neu prüfen.';
      } catch (error) {feedback.textContent = 'Schalter nicht bestätigt: ' + error.message; await loadCoreSlots();}
    }

    // ── OPENROUTER CATALOG ──
    async function loadOpenRouterCatalog() {
      const credentialState = document.getElementById('openrouter-credential-state');
      const catalogState = document.getElementById('openrouter-catalog-state');
      const list = document.getElementById('openrouter-model-list');
      const datalist = document.getElementById('openrouter-free-models');
      try {
        const [statusResponse, modelsResponse] = await Promise.all([
          fetch('/api/system/openrouter/status'),
          fetch('/api/system/openrouter/models')
        ]);
        if (!statusResponse.ok || !modelsResponse.ok) throw new Error('Geräteanmeldung oder Dienst fehlt');
        const [status, catalog] = await Promise.all([statusResponse.json(), modelsResponse.json()]);
        credentialState.textContent = status.credential?.configured === true ? 'Schlüssel konfiguriert' : 'Schlüssel fehlt';
        credentialState.className = 'badge ' + (status.credential?.configured === true ? 'badge-accent' : '');
        openRouterModels = (catalog.models || []).filter(item => item && item.free === true && typeof item.id === 'string');
        datalist.replaceChildren(...openRouterModels.map(item => {
          const option = document.createElement('option');
          option.value = item.id;
          return option;
        }));
        list.replaceChildren(...openRouterModels.map(item => {
          const code = document.createElement('code');
          code.textContent = item.id;
          code.title = item.name || item.id;
          return code;
        }));
        catalogState.textContent = `${openRouterModels.length} kostenlose Auswahl(en) verfügbar · OpenRouter Free Tier`;
      } catch (_error) {
        credentialState.textContent = 'Status nicht verfügbar';
        catalogState.textContent = 'OpenRouter-Katalog nicht erreichbar.';
        list.replaceChildren();
      }
    }

    // ── BACKGROUND WORKERS (EINSATZBEREIT vs. RUNNING) ──
    let workerQueueSnapshots = new Map();
    let workerQueueAvailable = false;

    function renderWorkerSelectionPolicies() {
      if (!window.BachWorkerSelectionPolicy) return;
      for (const card of document.querySelectorAll('.core-agent-card[data-appearance-worker], .core-agent-card[data-worker-id]')) {
        const workerId = card.dataset.appearanceWorker || card.dataset.workerId;
        if (workerId) window.BachWorkerSelectionPolicy.appendSelectionPolicy(document, card, workerId);
      }
    }

    function rememberWorkerSelectionPolicyStates() {
      const remember = window.BachWorkerSelectionPolicy?.rememberOpenStates;
      if (typeof remember === 'function') remember(document);
    }

    function renderCoreQueueDiagnostics() {
      renderWorkerSelectionPolicies();
      if (!window.BachWorkerQueue) return;
      for (const card of document.querySelectorAll('[data-core-agent-id]')) {
        const worker = workerQueueSnapshots.get(card.dataset.coreAgentId);
        if (card.dataset.coreAgentId !== 'buddha_always_on' && worker?.system !== true
            && card.querySelectorAll('.worker-queue-details').length === 0) continue;
        window.BachWorkerQueue.appendQueueDetails(document,card,
          worker?.system === true && worker.runtime_verified === true ? worker.queue_status : null,
          {key:card.dataset.coreAgentId,available:workerQueueAvailable});
      }
    }

    function workerReadiness(worker) {
      const status = String(worker.status || '').toLowerCase();
      const configured = typeof worker.backend === 'string' && !!worker.backend.trim() &&
        typeof worker.model === 'string' && !!worker.model.trim();
      const labels = {idle:'Living · Bereit', paused:'Pausiert', completed:'Abgeschlossen · bereit',
        error:'Fehler · Status prüfen', expired:'Abgelaufen', deleted:'Entfernt',
        starting:'Startet', stopping:'Wird beendet'};
      const canEdit = ['idle', 'paused', 'completed', 'error'].includes(status);
      const waiting = worker.runtime_verified === true && worker.worker_active === true && worker.running === false && status === 'running';
      const ready = configured && (waiting || ['idle', 'completed'].includes(status));
      return {ready, canEdit, canStart:configured && canEdit,
        waiting, label:waiting ? 'Living · Wartet auf Aufgaben' : !configured && canEdit ? 'Modell oder Anbieter fehlt' : status === 'running' ? 'Laufstatus nicht bestätigt' : labels[status] || 'Status unbekannt'};
    }

    async function loadBackgroundWorkers() {
      const epoch = ++workerRefreshEpoch;
      const summary = document.getElementById('worker-status-summary');
      const readyGrid = document.getElementById('ready-agents-grid');
      const runningList = document.getElementById('running-workers-list');
      try {
        const response = await fetch('/api/system/workers');
        if (!response.ok) throw new Error('HTTP ' + response.status);
        const data = await response.json();
        if (epoch !== workerRefreshEpoch) return;
        if (data.schema !== 'bach.workers.status.v1' || data.availability !== 'available' || !Array.isArray(data.workers))
          throw new Error('Workerquelle ist nicht bestätigt');
        rememberWorkerSelectionPolicyStates();
        agentOverviewController?.beginContainer(readyGrid);
        agentOverviewController?.beginContainer(runningList);
        workerQueueAvailable = true;
        workerQueueSnapshots = new Map(data.workers.filter(worker=>worker && typeof worker.id==='string').map(worker=>[worker.id,worker]));
        renderCoreQueueDiagnostics();
        const workers = data.workers.filter(worker=>worker && typeof worker === 'object' && worker.system!==true);

        const runningWorkers = workers.filter(w => window.BachAgentOverview?.isConfirmedAgentRunning(w) === true);
        const workerStatusUnknown = workers.some(w => w.runtime_verified !== true || typeof w.running !== 'boolean' || ['starting','stopping'].includes(w.status));
        updateRunningGroupState('workers', runningWorkers.length, workerStatusUnknown ? 'unconfirmed' : 'available');
        const waitingWorkers = workers.filter(w => workerReadiness(w).waiting);
        const profileWorkers = workers.filter(w => !runningWorkers.includes(w));
        const readyWorkers = profileWorkers.filter(w => workerReadiness(w).ready);

        const activityLabel = window.BachAgentOverview?.workerActivityLabel?.(runningWorkers.length, workerStatusUnknown)
          || (workerStatusUnknown
            ? `${runningWorkers.length} bestätigt aktiv (Running) · weitere Laufzustände unbestätigt`
            : `${runningWorkers.length} aktiv (Running)`);
        summary.textContent = `${workers.length} Worker registriert · ${readyWorkers.length} einsatzbereit (Living) · ${activityLabel} · ${waitingWorkers.length} warten auf Aufgaben · ${profileWorkers.length - readyWorkers.length} andere Zustände · Geprüft ${new Date().toLocaleTimeString('de-DE')}`;

        // Ready/profile cards show configured bindings only; resolved_model may describe a prior run.
        // 1. Render Einsatzbereite Agenten
        if (profileWorkers.length === 0) {
          readyGrid.innerHTML = `
            <div style="grid-column:1/-1;text-align:center;padding:2rem;background:var(--bg-dark);border:1px dashed var(--border);border-radius:var(--radius-sm);">
              <p style="color:var(--text-muted);margin-bottom:0.75rem;">Keine einsatzbereiten Workerprofile vorhanden.</p>
              <button class="btn btn-sm btn-primary" onclick="openPickupWerkstattModal()">+ Vorlage auswählen</button>
            </div>
          `;
        } else {
          readyGrid.innerHTML = profileWorkers.map(w => {
            const isPaused = w.status === 'paused';
            const state = workerReadiness(w);
            const providerStatus = window.BachProviderRequestStatus?.(w) || '';
            return `
              <div class="core-agent-card" data-appearance-worker="${escapeHtml(w.id)}" style="display:flex;flex-direction:column;justify-content:space-between;">
                <div>
                  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.4rem;">
                    <span class="badge" style="background:${state.ready ? '#059669' : isPaused ? '#92400e' : '#475569'};color:#fff;font-size:0.75rem;">
                      ${escapeHtml(state.label)}
                    </span>
                    <small style="color:var(--text-muted);font-family:monospace;">${escapeHtml(w.backend || 'Anbieter fehlt')}</small>
                  </div>
                  <h3 style="font-size:1.05rem;font-weight:700;margin-bottom:0.25rem;">${escapeHtml(w.name || w.id)}</h3>
                  <p style="font-size:0.8rem;color:var(--text-muted);margin-bottom:0.5rem;">
                    Modellbindung: <code style="color:var(--accent-text);">${escapeHtml(w.model || 'Modell fehlt')}</code>
                  </p>
                  <p style="font-size:0.75rem;color:var(--text-muted);line-height:1.4;">
                    ${escapeHtml(w.has_task_prompt === true ? 'Eigener Zusatzauftrag gespeichert' : w.has_task_prompt === false ? 'Kein eigener Zusatzauftrag gespeichert' : 'Zusatzauftrag hier nicht bestätigt')}
                  </p>
                  <p style="font-size:0.8rem;color:var(--text);line-height:1.4;">
                    ${escapeHtml(w.current_activity || '')}
                  </p>
                  ${providerStatus ? '<p class="provider-request-status" aria-label="Status der Provideranfrage" style="font-size:0.75rem;color:var(--text-muted);line-height:1.4;">' + escapeHtml(providerStatus) + '</p>' : ''}
                </div>

                <div class="agent-overview-actions">
                  ${state.waiting ? `
                    <button class="btn btn-sm" onclick="runWorkerAction('${escapeHtml(w.id)}', 'pause')">⏸ Pause</button>
                    <button class="btn btn-sm" onclick="runWorkerAction('${escapeHtml(w.id)}', 'stop')">⏹ Stoppen</button>
                  ` : !state.canStart ? `<span class="text-muted" style="font-size:0.75rem;">Start nicht bestätigt</span>` : isPaused ? `
                    <button class="btn btn-sm btn-primary" onclick="runWorkerAction('${escapeHtml(w.id)}', 'start')">▶ Fortsetzen</button>
                  ` : `
                    <button class="btn btn-sm btn-primary" onclick="runWorkerAction('${escapeHtml(w.id)}', 'start')">▶ Start</button>
                    <button class="btn btn-sm" onclick="runWorkerAction('${escapeHtml(w.id)}', 'pause')">⏸ Pause</button>
                  `}
                  <button class="btn btn-sm" ${state.canEdit ? '' : 'disabled'} onclick="editWorkerConfiguration('${escapeHtml(w.id)}')">Bearbeiten</button>
                  <button class="btn btn-sm" style="color:var(--error-text);margin-left:auto;" title="Workerprofil löschen" onclick="deleteWorker('${escapeHtml(w.id)}')">🗑️</button>
                </div>
              </div>
            `;
          }).join('');
        }
        for (const card of readyGrid.querySelectorAll('[data-appearance-worker]')) {
          const worker = profileWorkers.find(item => item.id === card.dataset.appearanceWorker);
          if (worker) {
            registerAgentOverviewCard(readyGrid, card, worker, 'worker', 'ready');
            window.BachAgentColor?.applyAgentColor(card, worker);
          }
        }

        // 2. Render Running Workers
        if (runningWorkers.length === 0) {
          runningList.replaceChildren();
        } else {
          runningList.innerHTML = runningWorkers.map(w => {
            const toolRound = Number(w.tool_round) || 0;
            const maxRounds = Number(w.max_tool_rounds ?? 25) === 0 ? 'unbegrenzt' : Number(w.max_tool_rounds ?? 25);
            const providerStatus = window.BachProviderRequestStatus?.(w) || '';
            return `
              <div class="core-agent-card" data-appearance-worker="${escapeHtml(w.id)}" data-worker-id="${escapeHtml(w.id)}" style="border-color:#38bdf8;background:rgba(56,189,248,0.04);">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.4rem;">
                  <span class="badge" style="background:#0284c7;color:#fff;font-size:0.75rem;">⚡ RUNNING</span>
                  <small style="color:var(--accent-text);">Runde ${toolRound}/${maxRounds}</small>
                </div>
                <h3 style="font-size:1.05rem;font-weight:700;margin-bottom:0.25rem;">${escapeHtml(w.name || w.id)}</h3>
                <p style="font-size:0.8rem;color:var(--text-muted);margin-bottom:0.4rem;">
                  Modell: <code>${escapeHtml(w.model)}</code>
                  ${w.resolved_model && w.resolved_model !== w.model ? `<span style="font-size:0.75rem;color:var(--accent-text);display:block;margin-top:0.2rem;">↳ Aufgelöst: <code>${escapeHtml(w.resolved_model)}</code></span>` : ''}
                </p>
                <p style="font-size:0.8rem;color:var(--text);margin-bottom:0.75rem;">
                  ${escapeHtml(w.current_activity || 'Verarbeitet Aufgabe…')}
                </p>
                ${providerStatus ? '<p class="provider-request-status" aria-label="Status der Provideranfrage" style="font-size:0.75rem;color:var(--text-muted);line-height:1.4;">' + escapeHtml(providerStatus) + '</p>' : ''}

                <div class="agent-overview-actions">
                  <button class="btn btn-sm" onclick="runWorkerAction('${escapeHtml(w.id)}', 'pause')">⏸ Pause</button>
                  <button class="btn btn-sm" style="color:var(--error-text);" onclick="runWorkerAction('${escapeHtml(w.id)}', 'stop')">⏹ Stoppen</button>
                </div>
              </div>
            `;
          }).join('');
        }
        for (const card of runningList.querySelectorAll('[data-worker-id]')) {
          const worker = runningWorkers.find(item => item.id === card.dataset.workerId);
          if (worker) {
            registerAgentOverviewCard(runningList, card, worker, 'worker', 'running');
            window.BachAgentColor?.applyAgentColor(card, worker);
          }
        }
        for(const card of document.querySelectorAll('[data-appearance-worker]')) {
          const worker=workers.find(item=>item.id===card.dataset.appearanceWorker);
          if (window.BachWorkerQueue) window.BachWorkerQueue.appendQueueDetails(document,card,
            worker?.runtime_verified === true ? worker.queue_status : null,
            {key:worker?.id,available:true});
          const heading=card.querySelector('h3');
          if(worker&&heading)heading.prepend(window.BachAvatars.createAvatar(document,worker.avatar,worker,
            document.getElementById('core-slot-editor').dataset.portraitAtlas,'agent-avatar-preview'));
          if (worker?.runtime_verified === true && ['idle', 'completed', 'running'].includes(worker.status)) {
            const actions = card.querySelector('.agent-overview-actions') || coreElement('div', undefined, 'core-actions');
            const assign = coreElement('a', 'Aufgabe zuweisen', 'btn btn-sm');
            assign.href = '/tasks?create=1&assign_slot=' + encodeURIComponent(worker.id);
            const deleteBtn = actions.querySelector('button[title="Workerprofil löschen"]');
            if (deleteBtn) actions.insertBefore(assign, deleteBtn);
            else actions.append(assign);
            if (!actions.parentNode) card.append(actions);
          }
        }
        runningList.querySelectorAll('[data-worker-id]').forEach(card => {
          const worker = runningWorkers.find(item => item.id === card.dataset.workerId);
          if (!worker) return;
          appendWorkerSelectionEvidence(card, worker);
          if (typeof worker.generation !== 'string') return;
          const actions = document.createElement('div');
          actions.className = 'core-actions';
          for (const [action, label] of [['handoff', 'Kontext übergeben'], ['decompose', 'Task zerlegen']]) {
            if (worker.action_capabilities?.[action] !== true) continue;
            if (action === 'decompose' && !worker.task_action_binding) continue;
            const button = coreElement('button', label, 'btn btn-sm');
            button.type = 'button';
            button.addEventListener('click', () => runWorkerAction(worker.id, action,
              worker.generation, worker.task_action_binding));
            actions.append(button);
          }
          if (worker.task_action_receipt) {
            const receipt = worker.task_action_receipt;
            actions.append(coreElement('small', 'Zerlegung: ' + receipt.state +
              (receipt.state === 'confirmed' ? ' · ' + receipt.created_ids.map(id => '#' + id).join(', ') : '')));
          }
          card.append(actions);
        });
        for (const card of [...readyGrid.querySelectorAll('[data-appearance-worker]'), ...runningList.querySelectorAll('[data-worker-id]')]) {
          const worker = workers.find(item => item.id === card.dataset.appearanceWorker);
          if (!worker) continue;
          const statusLabel = card.dataset.workerId ? 'Running · bestätigt' : workerReadiness(worker).label;
          renderAgentOverviewCardContent(card, worker, 'worker', statusLabel);
        }
        renderWorkerSelectionPolicies();
        applyAgentOverviewControls();
        window.BachWorkerLeaseCountdown?.update(runningWorkers);
      } catch (error) {
        if (epoch !== workerRefreshEpoch) return;
        summary.textContent = 'Workerstatus konnte nicht geladen werden.';
        rememberWorkerSelectionPolicyStates();
        agentOverviewController?.beginContainer(readyGrid);
        agentOverviewController?.beginContainer(runningList);
        workerQueueAvailable = false;
        workerQueueSnapshots = new Map();
        renderCoreQueueDiagnostics();
        if (window.BachWorkerQueue) for (const card of document.querySelectorAll('[data-appearance-worker]'))
          window.BachWorkerQueue.appendQueueDetails(document,card,null,{available:false});
        readyGrid.replaceChildren(coreElement('p','Workerprofile nicht verfügbar.','text-muted'));
        runningList.replaceChildren(coreElement('p','Worker-Laufstatus nicht verfügbar.','text-muted'));
        window.BachWorkerLeaseCountdown?.clear();
        updateRunningGroupState('workers', 0, 'unavailable');
        applyAgentOverviewControls();
      }
    }

    async function runWorkerAction(workerId, action, generation, taskBinding) {
      const summary = document.getElementById('worker-status-summary');
      const safeActions = new Set(['start', 'pause', 'stop', 'handoff', 'decompose']);
      if (!safeActions.has(action)) return;
      workerRefreshEpoch += 1;
      summary.textContent = 'Aktion wird angefordert…';
      try {
        const response = await fetch(`/api/system/workers/${encodeURIComponent(workerId)}/${action}`, {
          method: 'POST', headers: {'Content-Type': 'application/json'},
          body: JSON.stringify(action === 'decompose' ? {generation, ...taskBinding} :
            action === 'handoff' ? {generation} : {})
        });
        const data = await response.json();
        if (!response.ok || data.ok !== true) throw new Error(data.detail || 'Aktion nicht bestätigt');
        if (action === 'decompose') {
          summary.textContent = data.receipt?.state === 'confirmed'
            ? 'Teilaufgabenanlage durch den Lead bestätigt.'
            : data.receipt?.state === 'error' ? 'Zerlegung ohne bestätigte Teilaufgaben beendet.'
            : data.receipt?.state === 'cancelled' ? 'Zerlegungsanfrage abgebrochen.'
            : 'Zerlegung angefordert · Bestätigung folgt im Workerstatus.';
        } else if (action === 'handoff') {
          summary.textContent = data.receipt?.state === 'confirmed'
            ? 'Kontextübergabe durch die Laufzeit bestätigt.'
            : 'Kontextübergabe angefordert · Bestätigung folgt im Workerstatus.';
        } else {
          summary.textContent = 'Aktion bestätigt; Laufstatus wird neu gelesen.';
        }
      } catch (error) {
        summary.textContent = error.message;
      }
      await loadBackgroundWorkers();
    }

    async function deleteWorker(workerId) {
      if (!confirm('Diesen Worker wirklich löschen?')) return;
      workerRefreshEpoch += 1;
      try {
        const res = await fetch(`/api/system/workers/${encodeURIComponent(workerId)}/delete`, {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({})
        });
        if (res.ok) {
          loadBackgroundWorkers();
        } else {
          alert('Fehler beim Löschen des Workers.');
        }
      } catch (e) {
        alert('Netzwerkfehler: ' + e.message);
      }
    }

    // ── TEAMS & STAFFELN BESEELEN ──
    async function loadTeamsBeseelen() {
      const container = document.getElementById('teams-beseelen-container');
      try {
        const res = await fetch('/api/agenten/teams');
        const data = await res.json();
        const teams = data.teams || [];

        if (teams.length === 0) {
          container.innerHTML = '<p style="color:var(--text-muted);font-size:0.85rem;">Keine Teams vorhanden. Lege ein Team unter Blueprints an.</p>';
          return;
        }

        container.innerHTML = teams.map(t => {
          const members = (t.member_agents || '').split(',').map(m => m.trim()).filter(Boolean);
          const modelsMap = t.member_models || {};

          return `
            <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-sm);padding:0.85rem;">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.4rem;">
                <strong style="color:var(--text);font-size:0.95rem;">${escapeHtml(t.name)}</strong>
                <span class="badge badge-accent" style="font-size:0.7rem;">${escapeHtml(t.strategy)}</span>
              </div>
              <p style="font-size:0.75rem;color:var(--text-muted);margin:0 0 0.6rem 0;">${escapeHtml(t.description || '')}</p>

              <div style="display:flex;flex-direction:column;gap:0.4rem;background:var(--bg-dark);padding:0.6rem;border-radius:4px;border:1px solid var(--border);margin-bottom:0.6rem;">
                ${members.map(m => {
                  const curMod = typeof modelsMap[m] === 'string' ? modelsMap[m] : '';
                  return `
                    <div style="display:flex;justify-content:space-between;align-items:center;gap:0.4rem;">
                      <span style="font-size:0.78rem;color:var(--text);">🤖 ${escapeHtml(m)}</span>
                      <input class="team-member-model-input" data-team="${t.id}" data-member="${escapeHtml(m)}" value="${escapeHtml(curMod)}" placeholder="Modell-ID aus Adapter" aria-label="Modell-ID für ${escapeHtml(m)}" style="padding:0.2rem 0.4rem;font-size:0.72rem;background:var(--bg-card);color:var(--text);border:1px solid var(--border);border-radius:4px;min-width:10rem;" />
                    </div>
                  `;
                }).join('')}
              </div>
              <small style="display:block;color:var(--text-muted);font-size:0.72rem;margin-bottom:0.6rem;">Keine Modellliste wird vorgetäuscht. Trage eine vom zuständigen Adapter gemeldete Modell-ID ein.</small>

              <div style="display:flex;justify-content:space-between;align-items:center;">
                <button class="btn btn-sm" style="font-size:0.72rem;color:var(--error-text);" onclick="deleteTeamFromRunning(${t.id})">🗑️ Löschen</button>
                <button class="btn btn-sm btn-primary" style="font-size:0.75rem;" onclick="saveTeamBeseelung(${t.id})">
                  ✨ Speichern
                </button>
              </div>
            </div>
          `;
        }).join('');
      } catch (e) {
        container.innerHTML = `<p style="color:var(--error-text);font-size:0.8rem;">Fehler: ${e.message}</p>`;
      }
    }

    async function saveTeamBeseelung(teamId) {
      const selects = document.querySelectorAll(`.team-member-model-input[data-team="${teamId}"]`);
      const member_models = {};
      selects.forEach(sel => {
        const mem = sel.getAttribute('data-member');
        if (mem && sel.value.trim()) member_models[mem] = sel.value.trim();
      });

      try {
        const res = await fetch(`/api/agenten/teams/${teamId}/beseelen`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ member_models })
        });
        if (res.ok) {
          alert('✨ Team-Beseelung erfolgreich gespeichert!');
          loadTeamsBeseelen();
        } else {
          alert('Fehler beim Speichern.');
        }
      } catch (e) {
        alert('Netzwerkfehler: ' + e.message);
      }
    }

    async function deleteTeamFromRunning(teamId) {
      if (!confirm('Dieses Team wirklich löschen?')) return;
      try {
        const res = await fetch(`/api/agenten/teams/${teamId}`, { method: 'DELETE' });
        if (res.ok) loadTeamsBeseelen();
      } catch (e) {
        alert('Fehler: ' + e.message);
      }
    }

    // ── STAFFELN BESEELEN ──
    async function loadStaffelnBeseelen() {
      const container=document.getElementById('staffel-beseelen-container');
      const opened = new Set([...container.querySelectorAll('details[open]')].map(node=>node.dataset.chain));
      try {
        const res=await fetch('/api/marblerun/chains');if(!res.ok)throw new Error('HTTP '+res.status);
        const data=await res.json();if(data.schema!=='bach.native-sequences.v1'||!Array.isArray(data.chains))throw new Error('Staffelantwort ungültig');
        container.replaceChildren();
        if(!data.chains.length){container.append(coreElement('p','Keine Staffeln vorhanden. Erstelle eine im Staffel-Editor.'));return;}
        for(const chain of data.chains){
          const card=coreElement('details',undefined,'staffel-card');card.dataset.chain=String(chain.id);card.open=opened.has(String(chain.id));
          const steps=Array.isArray(chain.steps)?chain.steps:[];
          const summary=coreElement('summary',(chain.title||chain.name||'Staffel')+' · '+steps.length+' Stationen');card.append(summary);
          if(chain.description)card.append(coreElement('p',chain.description));
          if(chain.legacy)card.append(coreElement('p','Älterer Entwurf · im Staffel-Editor in eine native Folge übernehmen.'));
          const list=coreElement('ol');
          for(const step of steps)list.append(coreElement('li',String(step.label||step.action||'Schritt')+(step.agent_slot?' · '+step.agent_slot:'')));
          card.append(list);const edit=coreElement('a','Im Staffel-Editor öffnen','btn btn-sm');edit.href='/agenten/marblerun?edit='+encodeURIComponent(chain.id);card.append(edit);container.append(card);
        }
      } catch(error){container.replaceChildren(coreElement('p','Staffeln nicht verfügbar: '+error.message));}
    }

    // ── LIVE-AKTIVITÄT & TIMELINE ──
    async function refreshActivity() {
      const tbody = document.getElementById('activity-tbody');
      try {
        const response = await fetch('/api/system/core-agents/timeline');
        if (!response.ok) throw new Error('HTTP ' + response.status);
        const data = await response.json();
        if (data.schema !== 'bach.agent-timeline.v1' || !Array.isArray(data.events)) throw new Error('Timeline-Antwort ungültig');
        document.getElementById('activity-count').textContent = data.events.length + ' jüngste Ereignisse';
        tbody.replaceChildren();
        if (!data.events.length) {
          const row = document.createElement('tr');
          const cell = coreElement('td', 'Noch keine Session- oder Task-Ereignisse.');
          cell.colSpan = 5; row.append(cell); tbody.append(row);
        }
        for (const event of data.events) {
          const row = document.createElement('tr');
          const stamp = Date.parse(event.timestamp || '');
          const time = Number.isFinite(stamp) ? new Date(stamp).toLocaleString('de-DE') : 'Zeit unbekannt';
          const description = event.task_id ? 'Task #' + event.task_id + ' · ' + (event.task_title || event.activity || event.event || '') :
            (event.activity || event.event || 'Session') + (event.session_id ? ' · ' + event.session_id : '');
          for (const value of [time, event.slot_id || event.source || 'System', description,
            event.model_id || event.backend_id || '—', event.status || 'unknown']) row.append(coreElement('td', value));
          tbody.append(row);
        }
      } catch (_error) {
        const row = document.createElement('tr');
        const cell = coreElement('td', 'Timeline derzeit nicht verfügbar.');
        cell.colSpan = 5; row.append(cell); tbody.replaceChildren(row);
      }
    }

    function openPickupWerkstattModal() { window.BachTemplatePicker.open(); }
    function openPickupTeamModal() { location.assign('/agenten/blueprints?tab=teams&create=team'); }

    // ── ONE-OFF MODAL & BLUEPRINT FORM ──
    async function openOneOffModal() {
      editingWorker=null;
      document.getElementById('worker-refresh-skills').disabled=true;
      document.getElementById('worker-skill-state').textContent='';
      document.getElementById('worker-blueprint-form').reset();
      document.getElementById('worker-blueprint-create').textContent='Workerprofil anlegen';
      document.getElementById('modal-create-oneoff').style.display = 'flex';
      await loadBackgroundWorkerBlueprint();
    }

    function closeOneOffModal() {
      document.getElementById('modal-create-oneoff').style.display = 'none';
    }

    async function loadBackgroundWorkerBlueprint() {
      const description = document.getElementById('worker-blueprint-description');
      const create = document.getElementById('worker-blueprint-create');
      try {
        const response = await fetch('/api/system/workers/blueprint');
        if (!response.ok) throw new Error('HTTP ' + response.status);
        const data = await response.json();
        backgroundWorkerBlueprint = data;
        document.getElementById('worker-avatar').value='';document.getElementById('worker-symbol').value='';drawWorkerAppearance();
        const modeSelect = document.getElementById('worker-blueprint-sub-mode');
        modeSelect.replaceChildren(...data.sub_modes.map(item => new Option(item.label, item.id)));
        modeSelect.value = data.sub_mode || 'hintergrund_worker';
        modeSelect.disabled = false;
        const roleSelect = document.getElementById('worker-blueprint-role');
        roleSelect.replaceChildren(...data.expert_roles.map(item => new Option(item.label, item.id)));
        roleSelect.disabled = false;
        document.getElementById('worker-blueprint-name').value = data.name || 'BACH Hintergrundworker';
        document.getElementById('worker-blueprint-turns').value = data.defaults.max_tool_rounds ?? 25;
        document.getElementById('worker-blueprint-mode').value = data.defaults.mode === 'safe' ? 'safe' : 'full';
        document.getElementById('worker-blueprint-think').value = data.defaults.think === true ? 'true' : 'false';
        document.getElementById('worker-blueprint-pause-after').value = data.defaults.pause_after ?? 5;
        document.getElementById('worker-blueprint-pause-basis').value = Number(data.defaults.pause_after ?? 5) === 0 ? 'none' : data.defaults.pause_basis === 'tasks' ? 'tasks' : 'runs';
        document.getElementById('worker-blueprint-pause-minutes').value = data.defaults.pause_minutes ?? 1;
        updateWorkerPauseFields();
        document.getElementById('worker-blueprint-run-mode').value = data.defaults.type === 'once' ? 'once' : 'continuous';
        document.getElementById('worker-blueprint-ttl').value = data.defaults.ttl_minutes ?? 0;
        document.getElementById('worker-blueprint-backend').value = data.defaults.backend || 'ollama-cloud';
        document.getElementById('worker-blueprint-system-prompt').checked = data.defaults.include_system_prompt === true;
        document.getElementById('worker-blueprint-allow-tools').checked = data.defaults.allow_tools === true;
        updateWorkerRunModeFields();
        updateWorkerCreationModeFields();
        drawWorkerAppearance();
        description.textContent = `${data.description} Konfigurationsquelle: ${data.defaults_source}. Profil wird idle angelegt.`;
        create.disabled = false;
        await loadWorkerBlueprintModels();
      } catch (_error) {
        backgroundWorkerBlueprint = null;
        description.textContent = 'Standard-Rollenvorlage konnte nicht gelesen werden.';
        create.disabled = true;
      }
    }

    async function loadWorkerBlueprintModels(selectedModel) {
      const requestId = ++workerModelRequest;
      const backend = document.getElementById('worker-blueprint-backend').value;
      const modelSelect = document.getElementById('worker-blueprint-model');
      const status = document.getElementById('worker-blueprint-model-status');
      const create = document.getElementById('worker-blueprint-create');
      modelSelect.replaceChildren(new Option('Modellkatalog wird geladen…', ''));
      modelSelect.disabled = true;
      create.disabled = true;
      status.textContent = 'Aktueller Modellkatalog wird geprüft…';
      try {
        const response = await fetch('/api/system/workers/models?backend=' + encodeURIComponent(backend));
        if (!response.ok) throw new Error('HTTP ' + response.status);
        const data = await response.json();
        if (requestId !== workerModelRequest) return;
        const models = [...new Set(data.models.filter(model => typeof model === 'string' && model.trim()))];
        modelSelect.replaceChildren(...models.map(model => new Option(model, model)));
        if (typeof selectedModel === 'string' && models.includes(selectedModel)) modelSelect.value = selectedModel;
        modelSelect.disabled = models.length === 0;
        status.textContent = `${models.length} Modell(e) bereitgestellt.`;
        create.disabled = !backgroundWorkerBlueprint || models.length === 0;
      } catch (_error) {
        if (requestId !== workerModelRequest) return;
        modelSelect.replaceChildren(new Option('Modellkatalog nicht verfügbar', ''));
        status.textContent = 'Keine Modelle gemeldet.';
      }
    }

    async function createWorkerFromBlueprint(event) {
      event.preventDefault();
      if (!backgroundWorkerBlueprint) return;
      const button = document.getElementById('worker-blueprint-create');
      const status = document.getElementById('worker-blueprint-model-status');
      const ttlMinutes = Number(document.getElementById('worker-blueprint-ttl').value);
      const runMode = document.getElementById('worker-blueprint-run-mode').value;
      const backend = document.getElementById('worker-blueprint-backend').value;
      const model = document.getElementById('worker-blueprint-model').value;
      const subMode = document.getElementById('worker-blueprint-sub-mode').value;
      const taskIdValue = document.getElementById('worker-blueprint-task-id').value.trim();
      const taskId = taskIdValue ? Number(taskIdValue) : null;
      const taskPrompt = document.getElementById('worker-blueprint-task-prompt').value.trim();
      const multiRole = document.getElementById('worker-blueprint-multi-role').checked;

      const payload = {
        ...(editingWorker?.capabilities||{}),
        avatar:document.getElementById('worker-avatar').value,
        symbol:document.getElementById('worker-symbol').value,
        name: document.getElementById('worker-blueprint-name').value.trim(),
        backend,
        model,
        sub_mode: subMode,
        role_id: subMode === 'expert_role' && !multiRole ? document.getElementById('worker-blueprint-role').value : '',
        multi_role: subMode === 'expert_role' && multiRole,
        max_experts: subMode === 'boss_routing' ? Number(document.getElementById('worker-blueprint-max-experts').value) : 3,
        expert_models: {},
        task_id: taskId,
        max_tool_rounds: Number(document.getElementById('worker-blueprint-turns').value),
        mode: document.getElementById('worker-blueprint-mode').value,
        think: document.getElementById('worker-blueprint-think').value === 'true',
        pause_after: document.getElementById('worker-blueprint-pause-basis').value === 'none' ? 0 : Number(document.getElementById('worker-blueprint-pause-after').value),
        pause_minutes: Number(document.getElementById('worker-blueprint-pause-minutes').value),
        pause_basis: document.getElementById('worker-blueprint-pause-basis').value === 'tasks' ? 'tasks' : 'runs',
        type: runMode,
        ttl_minutes: runMode === 'continuous' ? ttlMinutes : 0,
        task_prompt: taskPrompt,
        include_system_prompt: document.getElementById('worker-blueprint-system-prompt').checked,
        allow_tools: document.getElementById('worker-blueprint-allow-tools').checked
      };

      try {payload.expert_models=JSON.parse(document.getElementById('worker-blueprint-expert-models').value||'{}');}
      catch(_error) {status.textContent='Modellzuordnung muss ein gültiges JSON-Objekt sein.';return;}

      button.disabled = true;
      status.textContent = 'Workerprofil wird angelegt…';
      try {
        const editing = editingWorker;
        workerRefreshEpoch += 1;
        const response = await fetch(editing
          ? `/api/system/workers/${encodeURIComponent(editing.id)}/configuration` : '/api/system/workers', {
          method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(editing
            ? {configuration_version: editing.version, configuration: payload} : payload)
        });
        const data = await response.json();
        if (!response.ok || data.ok !== true) throw new Error(data.detail || 'Fehler beim Anlegen');
        alert(editing ? 'Worker-Einstellungen gespeichert!' : 'Profil erfolgreich angelegt!');
        closeOneOffModal();
        await loadBackgroundWorkers();
      } catch (error) {
        status.textContent = error.message;
      } finally {
        button.disabled = false;
      }
    }

    async function editWorkerConfiguration(workerId) {
      await openOneOffModal();
      document.getElementById('worker-blueprint-create').disabled=true;
      const status = document.getElementById('worker-blueprint-model-status');
      try {
        const response = await fetch(`/api/system/workers/${encodeURIComponent(workerId)}/configuration`);
        const data = await response.json();
        if (!response.ok || data.ok !== true) throw new Error(data.detail);
        const config = data.configuration;
        document.getElementById('worker-blueprint-name').value = config.name || '';
        document.getElementById('worker-blueprint-backend').value = config.backend || 'ollama';
        document.getElementById('worker-blueprint-turns').value = config.max_tool_rounds ?? 25;
        document.getElementById('worker-blueprint-task-prompt').value = config.task_prompt || '';
        const fields={sub_mode:'sub-mode',role_id:'role',mode:'mode',think:'think',pause_after:'pause-after',
          pause_basis:'pause-basis',pause_minutes:'pause-minutes',max_experts:'max-experts',task_id:'task-id'};
        for(const [field,id] of Object.entries(fields)) {
          const input=document.getElementById('worker-blueprint-'+id);
          if(input)input.value=config[field]!=null?String(config[field]):'';
        }
        if (Number(config.pause_after ?? 0) === 0) document.getElementById('worker-blueprint-pause-basis').value = 'none';
        updateWorkerPauseFields();
        for(const [field,id] of Object.entries({multi_role:'multi-role',include_system_prompt:'system-prompt',allow_tools:'allow-tools'}))
          document.getElementById('worker-blueprint-'+id).checked=config[field]===true;
        document.getElementById('worker-avatar').value=config.avatar||'';
        document.getElementById('worker-blueprint-expert-models').value=JSON.stringify(config.expert_models||{});
        document.getElementById('worker-symbol').value=config.symbol||'';drawWorkerAppearance();
        updateWorkerCreationModeFields();
        editingWorker = { id: workerId, version: data.configuration_version,
          capabilities:Object.fromEntries(['allowed_tools','skill_refs'].filter(key=>key in config).map(key=>[key,config[key]])) };
        document.getElementById('worker-refresh-skills').disabled=!(config.skill_refs?.length);
        document.getElementById('worker-skill-state').textContent=(data.skill_bindings||[]).some(item=>item.state!=='current')
          ? 'Mindestens eine Skill-Quelle wurde geändert oder fehlt. Die gespeicherte Bindung bleibt sichtbar; vor dem Start neu binden.'
          : (config.skill_refs?.length||0)+' gebundene Skill-Anleitungen.';
        document.getElementById('worker-blueprint-create').textContent = 'Einstellungen speichern';
        await loadWorkerBlueprintModels(config.model);
      } catch (e) {
        status.textContent = 'Ladefehler: ' + e.message;
      }
    }

    function updateWorkerPauseFields() {
      const disabled = document.getElementById('worker-blueprint-pause-basis').value === 'none';
      for (const suffix of ['pause-after', 'pause-minutes']) {
        const input = document.getElementById('worker-blueprint-' + suffix);
        input.disabled = disabled;
        if (!disabled && Number(input.value) === 0) input.value = '1';
      }
    }

    function updateWorkerCreationModeFields() {
      const subMode = document.getElementById('worker-blueprint-sub-mode').value;
      const expertFields = document.getElementById('worker-blueprint-expert-fields');
      const bossFields = document.getElementById('worker-blueprint-boss-fields');
      const roleSelect = document.getElementById('worker-blueprint-role');
      const multiRole = document.getElementById('worker-blueprint-multi-role');
      expertFields.hidden = subMode !== 'expert_role';
      bossFields.hidden = subMode !== 'boss_routing';
      roleSelect.required = subMode === 'expert_role' && !multiRole.checked;
      roleSelect.disabled = subMode !== 'expert_role' || multiRole.checked;
    }

    function drawWorkerAppearance() {
      const modal=document.getElementById('core-slot-editor'),atlas=modal.dataset.portraitAtlas;
      const avatar=document.getElementById('worker-avatar'),symbol=document.getElementById('worker-symbol');
      const identity={role_id:document.getElementById('worker-blueprint-role').value};
      document.getElementById('worker-avatar-preview').replaceChildren(window.BachAvatars.createAvatar(document,avatar.value,identity,atlas,'agent-avatar-preview'));
      window.BachAvatars.mountAvatarPicker(document.getElementById('worker-avatar-presets'),avatar.value,identity,atlas,value=>{avatar.value=value;drawWorkerAppearance();});
      window.BachSymbols.mountSymbolPicker(document.getElementById('worker-symbols'),symbol.value,JSON.parse(modal.dataset.ticketSymbols),value=>{symbol.value=value;drawWorkerAppearance();});
    }

    async function uploadWorkerAvatar(file) {
      if(!file)return;
      const status=document.getElementById('worker-blueprint-model-status');
      if(file.size>180000||!['image/png','image/jpeg','image/webp'].includes(file.type)){status.textContent='Bitte PNG, JPEG oder WebP bis 180 KB verwenden.';return;}
      try {
        document.getElementById('worker-avatar').value=await new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(reader.result);reader.onerror=reject;reader.readAsDataURL(file);});
        drawWorkerAppearance();
      }catch(_error){status.textContent='Bild konnte nicht geladen werden.';}
    }

    async function refreshWorkerSkills() {
      if(!editingWorker)return;
      const current=editingWorker,status=document.getElementById('worker-skill-state');
      try {
        const pins=[];
        for(const pin of current.capabilities.skill_refs||[]) {
          const response=await fetch('/api/capabilities/skills/'+encodeURIComponent(pin.id)+'/source');
          const source=await response.json();
          if(!response.ok||source.id!==pin.id||!/^[a-f0-9]{64}$/.test(source.source_version))throw new Error('Aktuelle Skill-Quelle fehlt: '+pin.id);
          pins.push({id:pin.id,source_version:source.source_version,version:source.version});
        }
        if(editingWorker!==current)return;
        current.capabilities.skill_refs=pins;status.textContent='Aktuelle Skill-Bindungen vorbereitet. Mit Speichern übernehmen.';
      } catch(error) {status.textContent=error.message;}
    }

    function updateWorkerRunModeFields() {
      const once = document.getElementById('worker-blueprint-run-mode').value === 'once';
      const ttl = document.getElementById('worker-blueprint-ttl');
      ttl.disabled = once;
      if (once) ttl.value = '0';
    }

    async function refreshAll(interactive = false) {
      await Promise.all([

        loadClusterCockpit(),
        loadBackgroundWorkers(),
        loadTeamsBeseelen(),
        loadStaffelnBeseelen(),
        loadCoreSlots(),
        loadOpenRouterCatalog(),
        refreshActivity()
      ]);
      if (interactive) console.log("Living & Running Daten aktualisiert");
    }

    window.addEventListener('DOMContentLoaded', () => {
      if (location.hash === '#models-resources' || new URLSearchParams(location.search).get('tab') === 'resources') {
        const drawer = document.getElementById('running-models-resources-drawer');
        if (drawer) drawer.hidden = false;
        const torch = document.getElementById('models-resources');
        if (torch) torch.open = true;
      }
      initializeAgentOverviewControls();
      document.getElementById('worker-blueprint-backend')?.addEventListener('change', () => loadWorkerBlueprintModels());
      document.getElementById('worker-blueprint-sub-mode')?.addEventListener('change', updateWorkerCreationModeFields);
      document.getElementById('worker-blueprint-run-mode')?.addEventListener('change', updateWorkerRunModeFields);
      document.getElementById('worker-blueprint-pause-basis')?.addEventListener('change', updateWorkerPauseFields);
      document.getElementById('worker-blueprint-multi-role')?.addEventListener('change', updateWorkerCreationModeFields);
      document.getElementById('worker-blueprint-form')?.addEventListener('submit', createWorkerFromBlueprint);
      refreshAll();
      setInterval(loadClusterCockpit, 15000);
      setInterval(refreshActivity, 5000);
      setInterval(loadBackgroundWorkers, 6000);
      setInterval(loadCoreSlots, 6000);
    });
  </script>
