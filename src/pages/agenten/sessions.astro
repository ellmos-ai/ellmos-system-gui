---
import BachLayout from "../../layouts/BachLayout.astro";
---
<BachLayout title="Sessions & Protokolle" currentPath="/agenten/sessions">
  <section id="native-history" aria-label="Sessions und Protokolle" class="history-container">
    <header class="history-heading">
      <div><h1>📜 Sessions & Protokolle</h1><p class="text-muted">Gespeicherte Dialoge, Aufgabenereignisse und Gedächtnisnotizen.</p></div>
      <button id="history-refresh" class="btn btn-secondary" type="button">🔄 Aktualisieren</button>
    </header>
    <nav class="history-tabs" aria-label="Verlaufsquelle">
      <button class="btn btn-secondary" type="button" data-history-tab="sessions" aria-pressed="true">💬 Dialoge</button>
      <button class="btn btn-secondary" type="button" data-history-tab="tasks" aria-pressed="false">📋 Taskereignisse</button>
      <button class="btn btn-secondary" type="button" data-history-tab="notes" aria-pressed="false">📝 Gedächtnisnotizen</button>
      <a class="btn btn-secondary" href="/memory">🧠 Gedächtnis & Prozessmodell</a>
    </nav>
    <section id="history-session-filters" class="history-filters" aria-label="Dialogfilter">
      <label>Dialogkontext<select id="history-profile"><option value="">Systemslots & globale Dialoge</option></select></label>
      <label>Speicherstand<select id="history-archive"><option value="all">Alle gespeicherten Ausschnitte</option><option value="current">Aktuell gespeichert</option><option value="archived">Archiviert</option></select></label>
      <span id="history-profile-state" role="status"></span>
    </section>
    <section id="history-task-filters" hidden>
      <form id="history-task-form" class="history-filters">
        <label>Aufgabe #<input id="history-task" type="number" min="1" max="2147483647" placeholder="Alle Aufgaben"></label>
        <label>Aktueller Aufgabenstatus<select id="history-task-status"><option value="">Alle</option><option value="pending">Offen</option><option value="in_progress">In Bearbeitung</option><option value="done">Erledigt</option><option value="blocked">Blockiert</option><option value="review">Im Review</option><option value="cancelled">Abgebrochen</option></select></label>
        <button class="btn btn-secondary" type="submit">Filtern</button>
      </form>
    </section>
    <p id="history-status" role="status">Verlaufsquelle wird geprüft…</p>
    <div class="history-pager" id="history-pager">
      <button id="history-prev" class="btn btn-secondary btn-sm" type="button" disabled>← Zurück</button>
      <span id="history-count" aria-live="polite">Wird geprüft…</span>
      <button id="history-next" class="btn btn-secondary btn-sm" type="button" disabled>Weitere →</button>
    </div>
    <div id="history-content" class="history-list"></div>
    <dialog id="history-dialog" class="history-dialog" aria-labelledby="history-dialog-title">
      <header class="history-heading"><h2 id="history-dialog-title">Gespeicherter Dialog</h2><button class="btn btn-secondary" type="button" data-close>Schließen</button></header>
      <div id="history-dialog-content"></div>
    </dialog>
  </section>
</BachLayout>
<style is:global>
  .history-container{max-width:1200px;margin:auto;padding:1.5rem;display:grid;gap:1rem}
  .history-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-wrap:wrap}
  .history-heading h1,.history-heading h2{margin:0 0 .5rem}
  .history-tabs,.history-filters,.history-pager{display:flex;gap:.75rem;align-items:center;flex-wrap:wrap}
  .history-tabs [aria-pressed="true"]{border-color:var(--accent);color:var(--text)}
  .history-filters label{display:grid;gap:.4rem}
  .history-filters select,.history-filters input{padding:.6rem;background:var(--bg-card);color:var(--text);border:1px solid var(--border);border-radius:6px}
  .history-list{display:grid;gap:1rem}
  .history-card,.history-message{padding:1rem;background:var(--bg-card);border:1px solid var(--border);border-radius:10px}
  .history-card h2,.history-message h3{font-size:1.05rem;margin:0 0 .6rem;overflow-wrap:anywhere}
  .history-dialog{width:min(900px,calc(100vw - 2rem));max-height:85vh;overflow:auto;background:var(--bg-main,#151824);color:var(--text);border:1px solid var(--border);border-radius:12px;padding:1.2rem}
  .history-dialog::backdrop{background:rgba(0,0,0,.7)}
  .history-dialog-content,.history-message{margin-top:.8rem}
  .history-message pre{white-space:pre-wrap;overflow-wrap:anywhere;font-family:inherit;line-height:1.6}
  .history-message[data-role="user"]{border-left:3px solid var(--accent)}
  #history-status[data-error="true"],.history-error{color:#fca5a5}
  #native-history [hidden]{display:none!important}
</style>
<script>import '../../scripts/agent-history.mjs';</script>
