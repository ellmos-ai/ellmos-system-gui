  <div hidden>
    <LegacyRouteFallback route={route.path} label={route.label} reason={route.reason} nextHref={route.nextHref} nextLabel={route.nextLabel} />
  </div>

  <script is:inline>
    (function initHelpTabs() {
      const buttons = Array.from(document.querySelectorAll('.help-tab-btn'));
      const map = {
        architecture: document.getElementById('help-panel-architecture'),
        modules: document.getElementById('help-panel-modules'),
        manual: document.getElementById('ocean-doc-system') || document.getElementById('ocean-help-projection'),
      };
      function selectTab(tab) {
        buttons.forEach((btn) => {
          const active = btn.getAttribute('data-help-tab') === tab;
          btn.classList.toggle('btn-primary', active);
          btn.classList.toggle('btn-secondary', !active);
        });
        Object.entries(map).forEach(([key, panel]) => {
          if (!panel) return;
          panel.style.display = (!tab || tab === 'all' || key === tab) ? 'grid' : 'none';
        });
      }
      buttons.forEach((btn) => {
        btn.addEventListener('click', () => selectTab(btn.getAttribute('data-help-tab')));
      });
      const requested = new URLSearchParams(window.location.search).get('tab');
      if (requested && map[requested]) selectTab(requested);
    })();

    (async function loadManifestHelpProjection() {
      const container = document.getElementById("help-module-manifest-list");
      if (!container) return;
      try {
        const res = await fetch("/api/domains/modules");
        if (res.ok) {
          const payload = await res.json();
          const items = Array.isArray(payload?.modules) ? payload.modules : [];
          for (const mod of items) {
            const docs = mod?.docs || {};
            const entry = docs.entry || "README.md";
            const langs = Array.isArray(docs.languages) && docs.languages.length ? docs.languages.join(", ") : "de, en";
            const card = document.createElement("div");
            card.className = "help-module-card";
            card.style.cssText = "padding:0.75rem;border-radius:8px;border:1px solid rgba(148,163,184,0.18);";
            card.innerHTML = `<strong>${mod.id || mod.name || "Modul"}</strong> <span style="opacity:0.75;">v${mod.version || "0.0.0"}</span><div style="font-size:0.9rem;opacity:0.85;">Doku-Einstieg: <code>${entry}</code> &middot; Sprachen: <code>${langs}</code></div>`;
            container.appendChild(card);
          }
        }
        const auditRes = await fetch("/api/help/doc-audit");
        if (auditRes.ok) {
          const audit = await auditRes.json();
          const findingsEl = document.getElementById("help-doc-audit-findings");
          if (findingsEl && Array.isArray(audit?.findings)) {
            findingsEl.innerHTML = audit.findings.map((f) =>
              `<div style="padding:0.45rem 0.65rem;border-radius:6px;background:rgba(15,23,42,0.55);border:1px solid rgba(148,163,184,0.18);">
                <strong>[${f.cause}]</strong> <code>${f.doc_source}</code>: ${f.claim_statement} &rarr; <em>${f.execution_status || f.deterministic_action}</em>
              </div>`
            ).join("");
          }
        }
      } catch (_err) {
        // Honest readback: keep static core documentation and language parity card if live endpoints are offline.
      }
    })();
  </script>
