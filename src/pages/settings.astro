---
// src/pages/settings.astro - Einstellungen, Setup, Ocean Modulschaltplan & Installer
import BachLayout from "../layouts/BachLayout.astro";
import SystemClusterStatus from "../components/SystemClusterStatus.astro";
import WorkerPolicySettings from "../components/WorkerPolicySettings.astro";
import ModelSockets from "../components/ModelSockets.astro";
---

<BachLayout title="Einstellungen & Setup" currentPath="/settings">
  <div class="settings-container">
    <div class="page-header">
      <div class="header-content">
        <h1><span class="icon">⚙️</span> Einstellungen</h1>
        <p class="subtitle">Verbindung, Gerät, Darstellung und Regeln für die tägliche Arbeit</p>
      </div>
    </div>

    <!-- Tab Bar -->
    <div class="tab-bar" role="tablist" aria-label="Einstellungsbereiche">
      <button class="tab-btn active" data-tab="connections" id="settings-tab-connections" type="button" role="tab" aria-controls="pane-connections" aria-selected="true" tabindex="0">🔗 Verbindungen & Gerät</button>
      <button class="tab-btn" data-tab="appearance" id="settings-tab-appearance" type="button" role="tab" aria-controls="pane-appearance" aria-selected="false" tabindex="-1">🎨 Darstellung</button>
      <button class="tab-btn" data-tab="worker-policy" id="settings-tab-worker-policy" type="button" role="tab" aria-controls="pane-worker-policy" aria-selected="false" tabindex="-1">🧭 Worker & Aufgaben</button>
      <button class="tab-btn" data-tab="ocean-map" id="settings-tab-ocean-map" type="button" role="tab" aria-controls="pane-ocean-map" aria-selected="false" tabindex="-1">🌊 Ocean Modulschaltplan</button>
      <button class="tab-btn" data-tab="installer" id="settings-tab-installer" type="button" role="tab" aria-controls="pane-installer" aria-selected="false" tabindex="-1">📦 Installer & Erweiterungen</button>
      <button class="tab-btn" data-tab="learning" id="settings-tab-learning" type="button" role="tab" aria-controls="pane-learning" aria-selected="false" tabindex="-1">🧠 NemoFold & Hermes (Lernen)</button>
      <button class="tab-btn" data-tab="core" id="settings-tab-core" type="button" role="tab" aria-controls="pane-core" aria-selected="false" tabindex="-1">⚙️ Core & Repo-Klärung</button>
    </div>

    <div class="tab-pane active" id="pane-connections" role="tabpanel" aria-labelledby="settings-tab-connections" tabindex="0">
      <div class="card-grid">
        <div class="glass-card">
          <h2>Ausführendes Backend</h2>
          <p class="card-desc">Hier wird geprüft, welche Instanz die Daten für diese Oberfläche bereitstellt.</p>
          <p id="backend-origin-status" role="status" aria-live="polite">Backend-Herkunft noch nicht geprüft</p>
          <p id="backend-instance-status">Instanz noch nicht bestätigt</p>
          <p id="backend-observed-status" class="text-muted">Noch kein Prüfzeitpunkt</p>
          <button id="backend-origin-refresh" class="btn btn-secondary" type="button">Verbindung erneut prüfen</button>
          <p class="card-desc">Der Verbindungsbeleg bestätigt keine laufenden Agenten oder geladenen Modelle. Diese Zustände stehen unter <a href="/agenten/running">Running & Ressourcen</a>.</p>
        </div>
        <div class="glass-card">
          <h2>Dieses Gerät und diese Oberfläche</h2>
          <p id="settings-ui-origin">Adresse der Oberfläche wird gelesen…</p>
          <p class="card-desc">Diese Adresse gehört zur Ansicht in deinem Browser. Bei einem Tunnel kann sie lokal sein, während das Backend auf einem anderen Rechner arbeitet.</p>
          <a class="btn btn-secondary" href="/token-dashboard">Geräteanmeldung verwalten</a>
          <p class="card-desc">Anmeldung, Betriebssystemberechtigungen und Sandbox sind getrennte Freigaben. Betriebssystemzugriffe sind hier nicht geprüft.</p>
        </div>
      </div>
      <div class="glass-card">
        <h2>Weitere Einstellungen</h2>
        <p class="card-desc">Farbschema unter „Darstellung“, Aufgabenauswahl und Abschlussregeln unter „Worker & Aufgaben“. Architektur, Erweiterungen und Lernansichten bleiben in den weiteren Bereichen erreichbar.</p>
      </div>
    </div>

    <!-- TAB 1: OCEAN MODULSCHALTPLAN -->
    <div class="tab-pane" id="pane-ocean-map" role="tabpanel" aria-labelledby="settings-tab-ocean-map" tabindex="0" hidden>
      <p class="text-muted">Systemaufbau · <a href="/skills/ocean">Ocean-Module und Quellen durchsuchen ↗</a></p>
      <div class="header-actions">
        <span class="badge">Modulstatus ungeprüft</span>
        <button class="btn btn-secondary" type="button" onclick="loadOceanMap()">Modulschaltplan aktualisieren</button>
      </div>
      <div class="glass-card">
        <h3><span class="icon">🌊</span> Ocean Architektur- & Modulschaltplan</h3>
        <p class="card-desc">Visuelle Topologie der Kernsysteme aus <code>ellmos-ai</code> (Trithon, Muschelgrund, Salt & Subsysteme)</p>

        <div class="ocean-components-grid" id="ocean-components-grid">
          <p class="loading-state">Lade Ocean Modulschaltplan...</p>
        </div>
      </div>
    </div>

    <!-- TAB 2: INSTALLER & ERWEITERUNGEN -->
    <div class="tab-pane" id="pane-installer" role="tabpanel" aria-labelledby="settings-tab-installer" tabindex="0" hidden>
      <div class="card-grid">
        <div class="glass-card">
          <h3><span class="icon">📦</span> Backend-Installer</h3>
          <p class="card-desc">In Arbeit: Für eine Installation fehlen ein gepinnter Paket-Hash, ein signierter CapabilityGrant, ein passendes ApprovalReceipt, Installationsprotokoll und Rollback. Die Oberfläche führt keine Paketinstallation aus.</p>
          <div class="installer-box">
            <label>Paket oder Modulname zur Nachinstallation</label>
            <div style="display:flex;gap:0.5rem;margin-top:0.4rem;">
              <input type="text" id="install-package-input" placeholder="Paketquelle noch nicht angebunden" disabled style="flex:1;padding:0.5rem;background:var(--bg-dark);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text);" />
              <button class="btn btn-primary" disabled title="Installation erst nach überprüftem Backend-Vertrag möglich">Installieren</button>
            </div>
            <div id="install-log" style="margin-top:1rem;background:rgba(0,0,0,0.3);padding:0.75rem;border-radius:var(--radius-sm);font-family:monospace;font-size:0.8rem;display:none;"></div>
          </div>
        </div>

        <div class="glass-card">
          <h3><span class="icon">🔌</span> Verfügbare Erweiterungen</h3>
          <ul class="extension-list">
            <li>
              <div><strong>ellmos-voice-io</strong><p>Sprachein- und -ausgabe via Whisper & TTS</p></div>
              <span class="badge">Nicht geprüft</span>
            </li>
            <li>
              <div><strong>ellmos-blender-use-mcp</strong><p>3D-Visualisierung & automatische Geometrie-Generierung</p></div>
              <span class="badge">Nicht geprüft</span>
            </li>
            <li>
              <div><strong>media-editor-core</strong><p>High-Speed Renderengine für Windows und macOS</p></div>
              <span class="badge">Nicht geprüft</span>
            </li>
          </ul>
        </div>

        <!-- GUX-066: Externe Artefakte & Prompt-Suiten -->
        <div class="glass-card" style="grid-column: 1 / -1;">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem;">
            <h3><span class="icon">📦</span> Belegte Externe Prompt-Suiten & Artefakte (GUX-066)</h3>
            <button class="btn btn-secondary" style="font-size:0.75rem;padding:0.25rem 0.5rem;" onclick="loadExternalArtifacts()">🔄 Neu prüfen</button>
          </div>
          <p class="card-desc">Forensische Erkennung und verifizierter Import von ProfiPrompt, PromptBoard und Explorer Pro Suiten.</p>
          <div id="settings-artifacts-grid" style="display:grid;grid-template-columns:repeat(auto-fit, minmax(min(100%, 280px), 1fr));gap:1rem;margin-top:1rem;">
            <p style="color:var(--text-muted);font-size:0.85rem;">Prüfe Artefakt-Bestand...</p>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 3: NEMOFOLD & HERMES (LERNEN) -->
    <div class="tab-pane" id="pane-learning" role="tabpanel" aria-labelledby="settings-tab-learning" tabindex="0" hidden>
      <div class="card-grid">
        <div class="glass-card">
          <div class="learning-header">
            <span class="learning-icon">🧬</span>
            <div>
              <h3>NemoFold: Workflow-Lernen & Step-Ketten</h3>
              <p class="card-desc">Autonomes Lernen: analysiert Werkzeugfolgen, synthetisiert geprüfte Step-Ketten für MarbleRun und sichert Rollbacks via Two-Phase Action Journal ab.</p>
            </div>
          </div>
          <div class="learning-content">
            <div class="pipeline-step">
              <span class="step-num">1</span>
              <div>
                <strong>Ablaufbeobachtung & Heuristik-Detektor</strong>
                <p>Extrahiert und normalisiert Werkzeugfolgen und Shell-Aktionen aus autonomen Session-Logs.</p>
              </div>
            </div>
            <div class="pipeline-step">
              <span class="step-num">2</span>
              <div>
                <strong>Ketten-Synthese & Step-Ketten Generierung</strong>
                <p>Erkennt wiederkehrende Muster (Dev, Research, Review) und erzeugt formale Step-Ketten.</p>
              </div>
            </div>
            <div class="pipeline-step">
              <span class="step-num">3</span>
              <div>
                <strong>Workflow-TÜV & Rollback-Schutz</strong>
                <p>Prüft Sicherheitsregeln, Reversibilität (Two-Phase Action Journal) und übergibt an Operator-Queue.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="glass-card">
          <div class="learning-header">
            <span class="learning-icon">📜</span>
            <div>
              <h3>Hermes: Skill-Lernen aus Chat-Sessions</h3>
              <p class="card-desc">Autonome Skill-Destillation aus Dialogen mit Rauschfilterung & Human-in-the-Loop Freigabe</p>
            </div>
          </div>
          <div class="learning-content">
            <div class="pipeline-step">
              <span class="step-num">1</span>
              <div>
                <strong>Dialog-Mining & Transkript-Analyse</strong>
                <p>Filtert Floskeln und Tracebacks heraus (>50% Rauschreduktion) und erkennt Problemlösungsmuster.</p>
              </div>
            </div>
            <div class="pipeline-step">
              <span class="step-num">2</span>
              <div>
                <strong>Automatische Lessons Learned & Best Practices</strong>
                <p>Validierte Lösungswege werden direkt in <code>memory_lessons</code> gesichert.</p>
              </div>
            </div>
            <div class="pipeline-step">
              <span class="step-num">3</span>
              <div>
                <strong>Prozedurales Gedächtnis</strong>
                <p>Generiert standardisierte SKILL.md-Entwürfe zur Freigabe durch den Operator.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- NEMOFOLD INTERACTIVE WORKBENCH -->
      <div class="glass-card" style="margin-top: 1rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
          <div>
            <h3 style="margin: 0; display: flex; align-items: center; gap: 0.5rem;">
              <span>🧬</span> NemoFold Workbench: Gelernte Step-Ketten (MarbleRun)
            </h3>
            <p class="card-desc" style="margin: 0.25rem 0 0 0;">Human-in-the-Loop Freigabe: Geprüfte Ketten werden sofort im MarbleRun Designer aktivierbar.</p>
          </div>
          <div style="display: flex; gap: 0.5rem;">
            <button class="btn btn-secondary" id="btn-nemofold-refresh" onclick="loadNemoFoldCandidates()">Aktualisieren</button>
            <button class="btn btn-accent" id="btn-nemofold-synthesize" onclick="triggerNemoFoldSynthesis()">▶ Synthese ausführen</button>
          </div>
        </div>

        <!-- Live KPI Bar -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.75rem; margin-bottom: 1.25rem;">
          <div class="repo-item" style="text-align: center;">
            <span style="font-size: 1.25rem; font-weight: bold; color: var(--accent-text);" id="nf-kpi-runs">-</span>
            <span style="font-size: 0.75rem; color: var(--text-muted); display: block;">Synthese-Läufe</span>
          </div>
          <div class="repo-item" style="text-align: center;">
            <span style="font-size: 1.25rem; font-weight: bold; color: #ffb703;" id="nf-kpi-pending">-</span>
            <span style="font-size: 0.75rem; color: var(--text-muted); display: block;">In Prüfung</span>
          </div>
          <div class="repo-item" style="text-align: center;">
            <span style="font-size: 1.25rem; font-weight: bold; color: var(--success-text);" id="nf-kpi-approved">-</span>
            <span style="font-size: 0.75rem; color: var(--text-muted); display: block;">Freigegeben</span>
          </div>
          <div class="repo-item" style="text-align: center;">
            <span style="font-size: 1.25rem; font-weight: bold; color: #3a86ff;" id="nf-kpi-tuv">-</span>
            <span style="font-size: 0.75rem; color: var(--text-muted); display: block;">TÜV-Zertifiziert</span>
          </div>
        </div>

        <!-- Candidates Table -->
        <div style="overflow-x: auto;">
          <table class="data-table" id="nemofold-candidates-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Kette</th>
                <th>Schritte</th>
                <th>Konfidenz</th>
                <th>TÜV-Status</th>
                <th>Status</th>
                <th>Aktionen</th>
              </tr>
            </thead>
            <tbody id="nemofold-candidates-tbody">
              <tr>
                <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 1.5rem;">
                  Lade NemoFold-Kandidaten...
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- DARSTELLUNG: bestehender ThemeHandler mit Speicher-Readback -->
    <div class="tab-pane" id="pane-appearance" role="tabpanel" aria-labelledby="settings-tab-appearance" tabindex="0" hidden>
      <div class="card-grid">
        <div class="glass-card">
          <h3>🎨 Darstellung</h3>
          <p class="card-desc">Theme des verbundenen Backends. Eine Änderung gilt erst nach bestätigtem Speichern und erneutem Lesen.</p>
          <label for="theme-select">Farbschema</label>
          <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-top:0.5rem;">
            <select id="theme-select" style="padding:0.5rem;background:var(--bg-dark);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text);">
              <option value="dark">Dunkel</option>
              <option value="light">Hell</option>
              <option value="ocean">Ocean</option>
              <option value="warm">Warm</option>
              <option value="custom">Benutzerfarben (gespeicherte Palette)</option>
            </select>
            <button id="theme-save" class="btn btn-primary" type="button" disabled>Theme speichern</button>
          </div>
          <p id="theme-status" role="status" aria-live="polite">Theme noch nicht geprüft</p>
          <p class="card-desc">Benutzerfarben werden im Backend gespeichert. Die benutzerdefinierte Palette wird derzeit nicht auf jeder Seite vollständig angewendet.</p>
        </div>
      </div>
    </div>

    <div class="tab-pane" id="pane-worker-policy" role="tabpanel" aria-labelledby="settings-tab-worker-policy" tabindex="0" hidden>
      <p class="text-muted">Abschlussmodi, Reviewer, Task-Auswahl und Review-Verfall. Hochsicherheit kann Läufe anhalten; ausgewogener Modus erlaubt unabhängige Weiterarbeit. GitHub-Aufgaben können ihre externe PR-Prüfung nutzen. Änderungen bleiben deaktiviert, solange das verbundene Backend keine versionierte Policy bestätigt.</p>
      <WorkerPolicySettings />
    <details class="glass-card model-access-configuration" aria-labelledby="model-access-title">
      <summary id="model-access-title">Gespeicherte lokale Modellangebote und Agentenzugriff</summary>
      <p class="section-description">Lokale Haupt- und Fallbackziele unterliegen den gespeicherten Zugriffsregeln und der Ressourcenadmission. Eine gespeicherte Zuordnung belegt keine aktive Belegung; Cloudinferenz benötigt keinen lokalen Modellplatz.</p>
      <ModelSockets />
    </details>
    </div>

    <!-- TAB 5: CORE & REPO-KLÄRUNG -->
    <div class="tab-pane" id="pane-core" role="tabpanel" aria-labelledby="settings-tab-core" tabindex="0" hidden>
      <div class="card-grid">
        <SystemClusterStatus />

        <div class="glass-card">
          <h3><span class="icon">🏛️</span> Repo- & Architektur-Klassifizierung</h3>
          <p class="card-desc">Klare Trennung der Komponenten und Verantwortlichkeiten:</p>
          <div class="repo-box">
            <div class="repo-item">
              <span class="badge badge-accent">BACH/Ocean GUI</span>
              <strong>Gemeinsame Astro-Oberfläche (dieses Dashboard)</strong>
              <p>Eine GUI-Quelle; BACH und Ocean benötigen jeweils eigene geprüfte Backend-Adapter.</p>
            </div>
            <div class="repo-item">
              <span class="badge badge-secondary">Universal GUI</span>
              <strong>Eigenständige FastAPI-/Jinja-Konsole</strong>
              <p>Separater Operator-Zugang mit eigenem Modul; technischer Paketname derzeit <code>ellmos-unified-gui</code>.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BachLayout>

<style>
  .settings-container {
    min-width: 0;
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(.75rem,2vw,2rem) clamp(.5rem,2vw,1.5rem);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .settings-container a:not(.btn) {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: .15em;
  }
  .page-header {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.25rem;
  }
  .header-content h1 {
    font-size: 1.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.25rem 0;
  }
  .subtitle {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin: 0;
  }
  .tab-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tab-btn {
    padding: 0.5rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .tab-btn:hover {
    background: var(--bg-hover);
    color: var(--text);
  }
  .tab-btn.active {
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
    border-color: var(--accent);
  }
  .tab-pane {
    display: none;
    flex-direction: column;
    gap: 1.25rem;
  }
  .tab-pane[hidden] { display: none; }
  .tab-btn:focus-visible, .tab-pane:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .tab-pane.active {
    display: flex;
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 1.25rem;
  }
  .glass-card {
    min-width: 0;
    overflow-wrap: anywhere;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }
  .glass-card h3 {
    margin: 0 0 0.25rem 0;
    font-size: 1.15rem;
  }
  .card-desc {
    font-size: 0.825rem;
    color: var(--text-muted);
    margin: 0 0 1.25rem 0;
  }
  .ocean-components-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1rem;
  }
  .ocean-card {
    background: rgba(255,255,255,0.02);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 1.25rem;
  }
  .ocean-card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .ocean-card-icon {
    font-size: 1.5rem;
  }
  .ocean-card-title {
    font-weight: 600;
    font-size: 1rem;
  }
  .ocean-card-role {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0 0 0.75rem 0;
    line-height: 1.35;
  }
  .extension-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .extension-list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0.8rem;
    border-radius: var(--radius-sm);
    background: rgba(255,255,255,0.02);
    border: 1px solid var(--border);
  }
  .extension-list strong {
    font-size: 0.875rem;
  }
  .extension-list p {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin: 0;
  }
  .learning-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .learning-icon {
    font-size: 2rem;
  }
  .pipeline-step {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    padding: 0.6rem;
    border-radius: var(--radius-sm);
    background: rgba(255,255,255,0.015);
  }
  .step-num {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--accent);
    color: #0b0d14;
    font-weight: 700;
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .pipeline-step strong {
    font-size: 0.875rem;
  }
  .pipeline-step p {
    font-size: 0.775rem;
    color: var(--text-muted);
    margin: 0.15rem 0 0 0;
  }
  .repo-box {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .repo-item {
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    background: rgba(255,255,255,0.02);
    border-left: 3px solid var(--accent);
  }
  .repo-item strong {
    display: block;
    margin: 0.35rem 0 0.15rem 0;
    font-size: 0.9rem;
  }
  .repo-item p {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .data-table th, .data-table td {
    padding: 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }
  .data-table th {
    color: var(--text-muted);
    font-weight: 500;
  }
</style>

<script is:inline>
  async function loadOceanMap() {
    const grid = document.getElementById('ocean-components-grid');
    if (!grid) return;
    try {
      const res = await fetch('/api/setup/ocean-map');
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json();
      const components = Array.isArray(data.core_components) ? data.core_components : [];
      grid.replaceChildren();
      for (const component of components) {
        const card = document.createElement('div');
        card.className = 'ocean-card';
        const header = document.createElement('div');
        header.className = 'ocean-card-header';
        const icon = document.createElement('span');
        icon.className = 'ocean-card-icon';
        icon.textContent = String(component.icon || '🌊');
        const title = document.createElement('div');
        title.className = 'ocean-card-title';
        title.textContent = String(component.name || 'Unbenanntes Modul');
        header.append(icon, title);
        const role = document.createElement('p');
        role.className = 'ocean-card-role';
        role.textContent = String(component.role || 'Rolle nicht beschrieben');
        const footer = document.createElement('div');
        footer.style.cssText = 'display:flex;justify-content:space-between;align-items:center';
        const status = document.createElement('span');
        status.className = 'badge';
        status.textContent = 'Laufstatus nicht geprüft';
        const type = document.createElement('span');
        type.style.cssText = 'font-size:0.75rem;color:var(--text-muted)';
        type.textContent = String(component.type || 'Modul');
        footer.append(status, type);
        card.append(header, role, footer);
        grid.append(card);
      }
      if (!components.length) grid.textContent = 'Keine Modulkonfiguration verfügbar.';
    } catch (e) {
      grid.textContent = 'Modulschaltplan nicht verfügbar; Backend-Anbindung prüfen.';
    }
  }

  function applyStoredTheme(theme) {
    localStorage.setItem('bach-theme', theme);
    if (theme === 'dark') document.documentElement.removeAttribute('data-theme');
    else document.documentElement.setAttribute('data-theme', theme);
  }

  async function loadTheme() {
    const status = document.getElementById('theme-status');
    const save = document.getElementById('theme-save');
    save.disabled = true;
    try {
      const response = await fetch('/api/settings/theme', { cache: 'no-store' });
      if (!response.ok) throw new Error('HTTP ' + response.status);
      const data = await response.json();
      if (!data.success || !['dark', 'light', 'ocean', 'warm', 'custom'].includes(data.theme))
        throw new Error('Theme-Antwort ungültig');
      document.getElementById('theme-select').value = data.theme;
      applyStoredTheme(data.theme);
      status.textContent = data.configured
        ? 'Gespeichertes Theme: ' + data.theme
        : 'Backend-Standard: ' + data.theme + ' · noch keine eigene Auswahl';
      // The authenticated readback already proves that the HttpOnly device
      // cookie is available for the subsequent write.
      save.disabled = false;
    } catch (error) {
      status.textContent = 'Theme nicht verfügbar: ' + error.message;
    }
  }

  async function saveTheme() {
    const status = document.getElementById('theme-status');
    const save = document.getElementById('theme-save');
    const theme = document.getElementById('theme-select').value;
    save.disabled = true;
    status.textContent = 'Speichere Theme…';
    try {
      const response = await fetch('/api/settings/theme', {
        method: 'PUT', cache: 'no-store',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ theme })
      });
      if (!response.ok) throw new Error('HTTP ' + response.status);
      const saved = await response.json();
      const readbackResponse = await fetch('/api/settings/theme', { cache: 'no-store' });
      if (!readbackResponse.ok) throw new Error('Readback HTTP ' + readbackResponse.status);
      const readback = await readbackResponse.json();
      if (!saved.success || readback.theme !== theme || !readback.configured)
        throw new Error('Speicherung nicht bestätigt');
      applyStoredTheme(readback.theme);
      status.textContent = 'Gespeichertes Theme bestätigt: ' + readback.theme;
    } catch (error) {
      status.textContent = 'Theme nicht gespeichert: ' + error.message;
    } finally {
      save.disabled = false;
    }
  }

  async function loadNemoFoldStats() {
    try {
      const res = await fetch('/api/learning/nemofold/stats');
      if (!res.ok) return;
      const data = await res.json();
      const elRuns = document.getElementById('nf-kpi-runs');
      const elPending = document.getElementById('nf-kpi-pending');
      const elApproved = document.getElementById('nf-kpi-approved');
      const elTuv = document.getElementById('nf-kpi-tuv');
      if (elRuns) elRuns.textContent = data.total_runs || 0;
      if (elPending) elPending.textContent = data.pending_candidates || 0;
      if (elApproved) elApproved.textContent = data.approved_candidates || 0;
      if (elTuv) elTuv.textContent = data.tuv_certified_count || 0;
    } catch (e) {
      console.warn('NemoFold Stats nicht geladen:', e);
    }
  }

  async function loadNemoFoldCandidates() {
    const tbody = document.getElementById('nemofold-candidates-tbody');
    if (!tbody) return;
    try {
      const res = await fetch('/api/learning/nemofold/candidates?status=all');
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json();
      const list = data.candidates || [];
      if (list.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" style="text-align: center; color: var(--text-muted); padding: 1.5rem;">Keine Workflow-Kandidaten vorhanden. Klicke auf "Synthese ausführen".</td></tr>';
        return;
      }
      tbody.innerHTML = list.map(c => `
        <tr>
          <td><code style="font-size:0.75rem;">#${c.id}</code></td>
          <td>
            <strong>${c.title || c.chain_name}</strong>
            <div style="font-size:0.75rem; color:var(--text-muted);">${c.chain_name}</div>
          </td>
          <td><span class="badge badge-secondary">${c.steps ? c.steps.length : 0} Schritte</span></td>
          <td><span style="font-weight:600; color:var(--accent-text);">${Math.round((c.confidence_score || 0.8) * 100)}%</span></td>
          <td>
            <span class="badge ${c.tuv_status === 'certified' ? 'badge-success' : 'badge-warning'}">
              ${c.tuv_status === 'certified' ? '🛡️ TÜV OK' : '⚠️ Prüfung'}
            </span>
          </td>
          <td>
            <span class="badge ${c.status === 'approved' ? 'badge-success' : c.status === 'rejected' ? 'badge-danger' : 'badge-accent'}">
              ${c.status}
            </span>
          </td>
          <td>
            <div style="display:flex; gap:0.25rem;">
              ${c.status === 'pending' ? `
                <button class="btn btn-primary" style="padding:0.2rem 0.5rem; font-size:0.75rem;" onclick="approveNemoFoldCandidate(${c.id})">Freigeben</button>
                <button class="btn" style="padding:0.2rem 0.5rem; font-size:0.75rem; color:var(--error-text);" onclick="rejectNemoFoldCandidate(${c.id})">Ablehnen</button>
              ` : `
                <span style="font-size:0.75rem; color:var(--text-muted);">${c.reviewed_by ? 'Geprüft (' + c.reviewed_by + ')' : '-'}</span>
              `}
            </div>
          </td>
        </tr>
      `).join('');
      loadNemoFoldStats();
    } catch (e) {
      tbody.innerHTML = `<tr><td colspan="7" style="color:var(--error-text); text-align:center; padding:1rem;">Fehler: ${e.message}</td></tr>`;
    }
  }

  async function approveNemoFoldCandidate(id) {
    if (!confirm('Diesen Workflow-Kandidaten freigeben und in MarbleRun als ausführbare Kette übernehmen?')) return;
    try {
      const res = await fetch(`/api/learning/nemofold/candidates/${id}/approve`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ approved_by: 'operator', notes: 'Manuelle Freigabe via Settings GUI' })
      });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      alert('Kette freigegeben und nach MarbleRun übertragen!');
      loadNemoFoldCandidates();
    } catch (e) {
      alert('Fehler bei Freigabe: ' + e.message);
    }
  }

  async function rejectNemoFoldCandidate(id) {
    const reason = prompt('Begründung für die Ablehnung:');
    if (reason === null) return;
    try {
      const res = await fetch(`/api/learning/nemofold/candidates/${id}/reject`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ rejected_by: 'operator', reason: reason || 'Operator-Ablehnung' })
      });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      loadNemoFoldCandidates();
    } catch (e) {
      alert('Fehler bei Ablehnung: ' + e.message);
    }
  }

  async function triggerNemoFoldSynthesis() {
    const btn = document.getElementById('btn-nemofold-synthesize');
    if (btn) btn.disabled = true;
    try {
      const res = await fetch('/api/learning/nemofold/synthesize', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ source_type: 'database_sessions' })
      });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json();
      alert(`NemoFold Synthese abgeschlossen: ${data.chains_synthesized || 0} Ketten synthetisiert!`);
      loadNemoFoldCandidates();
    } catch (e) {
      alert('Synthese-Fehler: ' + e.message);
    } finally {
      if (btn) btn.disabled = false;
    }
  }

  async function loadExternalArtifacts() {
    const grid = document.getElementById('settings-artifacts-grid');
    if (!grid) return;
    grid.innerHTML = '<p style="color:var(--text-muted);font-size:0.85rem;">Prüfe Artefakt-Bestand...</p>';
    try {
      const res = await fetch('/api/system/external-artifacts');
      const data = await res.json();
      grid.innerHTML = Object.values(data).map(art => `
        <div style="background:var(--bg-dark);border:1px solid var(--border);border-radius:var(--radius-sm);padding:1rem;display:flex;flex-direction:column;justify-content:space-between;">
          <div>
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.4rem;">
              <strong style="font-size:0.95rem;">${art.title}</strong>
              <span class="badge ${art.present ? 'badge-success' : ''}" style="${!art.present ? 'opacity:0.6;' : ''}">
                ${art.present ? 'Gefunden' : 'Nicht gefunden'}
              </span>
            </div>
            <p style="font-size:0.8rem;color:var(--text-muted);margin:0 0 0.5rem 0;">${art.description}</p>
            ${art.path ? `<code style="font-size:0.7rem;display:block;background:rgba(0,0,0,0.3);padding:0.25rem 0.4rem;border-radius:4px;word-break:break-all;margin-bottom:0.6rem;">${art.path}</code>` : ''}
            ${art.preview_items && art.preview_items.length ? `
              <div style="font-size:0.72rem;color:var(--text-muted);margin-bottom:0.6rem;">
                <strong>Vorschau:</strong>
                <ul style="margin:0.2rem 0 0 0;padding-left:1rem;">
                  ${art.preview_items.map(p => `<li>${p.title || p.name} (${p.category})</li>`).join('')}
                </ul>
              </div>
            ` : ''}
          </div>
          <button class="btn btn-primary" style="width:100%;font-size:0.8rem;padding:0.35rem 0.6rem;" ${!art.can_import ? 'disabled' : ''} onclick="importExternalArtifact('${art.id}')">
            📥 ${art.present ? 'In Prompt-DB importieren' : 'Nicht verfügbar'}
          </button>
        </div>
      `).join('');
    } catch (e) {
      grid.innerHTML = `<p style="color:var(--accent-red);font-size:0.85rem;">Fehler beim Laden: ${e.message}</p>`;
    }
  }

  async function importExternalArtifact(artId) {
    if (!confirm(`Soll das Artefakt "${artId}" in die Prompt-DB importiert werden?`)) return;
    try {
      const res = await fetch('/api/system/external-artifacts/import', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ artifact: artId })
      });
      const data = await res.json();
      if (res.ok && data.success) {
        alert(`Import erfolgreich: ${data.imported} Einträge importiert (${data.skipped} übersprungen).`);
        loadExternalArtifacts();
      } else {
        alert("Import fehlgeschlagen: " + (data.detail || "Fehler"));
      }
    } catch (e) {
      alert("Netzwerkfehler: " + e.message);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    loadOceanMap();
    loadTheme();
    loadNemoFoldStats();
    loadNemoFoldCandidates();
    loadExternalArtifacts();
    document.getElementById('theme-save').addEventListener('click', saveTheme);
  });
</script>

<script>
  import { describeBackendOrigin, setupSettingsTabs } from '../lib/settings-connections.mjs';

  document.addEventListener('DOMContentLoaded', () => {
    setupSettingsTabs(document, window);
    document.getElementById('settings-ui-origin').textContent = 'Adresse der Oberfläche: ' + window.location.origin;
    const status = document.getElementById('backend-origin-status');
    const instance = document.getElementById('backend-instance-status');
    const observed = document.getElementById('backend-observed-status');
    const refresh = document.getElementById('backend-origin-refresh');
    async function loadBackendOrigin() {
      refresh.disabled = true;
      status.textContent = 'Prüfe Backend-Herkunft…';
      instance.textContent = 'Instanz noch nicht bestätigt';
      observed.textContent = 'Noch kein Prüfzeitpunkt';
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 5000);
      try {
        const response = await fetch('/api/gui/backend-origin', { cache: 'no-store', signal: controller.signal });
        if (!response.ok) throw new Error('HTTP ' + response.status);
        const state = describeBackendOrigin(await response.json());
        status.textContent = state.summary;
        instance.textContent = state.instance;
        observed.textContent = state.observed;
      } catch (_) {
        status.textContent = 'Backend-Herkunft nicht verfügbar. Verbindung prüfen und erneut versuchen.';
      } finally {
        clearTimeout(timeout);
        refresh.disabled = false;
      }
    }
    refresh.addEventListener('click', loadBackendOrigin);
    loadBackendOrigin();
  });
</script>
