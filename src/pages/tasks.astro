    async function loadTaskResultHistory(id, revision, {append = false} = {}) {
      if (taskResultHistoryLoading) return false;
      const status = document.getElementById('task-result-history-status');
      const list = document.getElementById('task-result-history-events');
      const more = document.getElementById('task-result-history-more');
      const beforeEventId = append ? taskResultHistoryCursor : null;
      if (append && (!taskResultHistoryHasMore || !Number.isSafeInteger(beforeEventId) || beforeEventId <= 0)) return false;
      if (!append) resetTaskResultHistory();
      const requestGeneration = ++taskResultHistoryGeneration;
      taskResultHistoryLoading = true; more.disabled = true;
      const query = new URLSearchParams({limit:String(taskResultHistoryPageSize)});
      if (beforeEventId !== null) query.set('before_event_id', String(beforeEventId));
      try {
        const response = await fetch('/api/tasks/' + encodeURIComponent(id) + '/result/history?' + query.toString());
        if (!response.ok) throw new Error(`Ergebnisverlauf nicht verfügbar (HTTP ${response.status}).`);
        const data = await response.json();
        if (revision !== taskDetailRevision) return false;
        const page = validateResultHistoryPage(data, id, {limit:taskResultHistoryPageSize, beforeEventId});
        if (!page) throw new Error('Der Ergebnisverlauf entspricht nicht dem bestätigten Format.');
        if (append && taskResultHistoryEvents.length
            && page.events.length && taskResultHistoryEvents.at(-1).event_id <= page.events[0].event_id) {
          throw new Error('Der Ergebnisverlauf ist nicht lückenlos sortiert.');
        }
        if (!append) list.replaceChildren();
        for (const event of page.events) {
          taskResultHistoryEvents.push(event);
          list.append(renderTaskResultHistoryEvent(event));
        }
        taskResultHistoryCursor = page.next_before_event_id;
        taskResultHistoryHasMore = page.has_more;
        status.textContent = taskResultHistoryEvents.length
          ? `${taskResultHistoryEvents.length} Verlaufseinträge geladen.` : 'Für diesen Task sind keine bestätigten Verlaufseinträge vorhanden.';
        more.hidden = !page.has_more;
        return true;
      } catch (cause) {
        if (revision !== taskDetailRevision) return false;
        status.textContent = cause instanceof Error ? cause.message : 'Ergebnisverlauf nicht bestätigt.';
        if (!append) list.replaceChildren();
        more.hidden = true;
        return false;
      } finally {
        if (requestGeneration === taskResultHistoryGeneration) taskResultHistoryLoading = false;
        if (revision === taskDetailRevision) more.disabled = false;
      }
    }

