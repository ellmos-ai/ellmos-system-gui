    async function openTask(id, {releaseCorrectionGate = true} = {}) {
      if (!Number.isSafeInteger(id) || id <= 0) return;
      const mayReleaseCorrectionGate = releaseCorrectionGate && correctionGateTaskId === id && !correctionPostInFlight;
      const revision = ++taskDetailRevision;
      selectedResult = null; taskResultReadback = null;
      taskResultCapabilities = {valid:false, accept_result:false, request_correction:false};
      taskResultStatusMessage = '';
