        const historyLoaded = await loadTaskResultHistory(id, revision);
        if (revision !== taskDetailRevision) return null;
        if (mayReleaseCorrectionGate && resultLoaded && historyLoaded && !correctionPostInFlight
            && correctionGateTaskId === id) {
          correctionRequiresRefresh = false; correctionGateTaskId = null;
          document.getElementById('task-result-status').textContent = taskResultStatusMessage;
          renderTaskResultCorrectionAvailability({resetNote:true});
