---
// tasks.astro - Das moderne BACH Aufgabenboard mit Filterung
import BachLayout from "../layouts/BachLayout.astro";
import TaskCreateForm from "../components/TaskCreateForm.astro";
import TaskWorkerPolicySettings from "../components/TaskWorkerPolicySettings.astro";
---

<BachLayout title="Aufgaben & Tasks" currentPath="/tasks">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;flex-wrap:wrap;gap:1rem;">
    <div>
      <h1 style="font-size:1.75rem;font-weight:800;letter-spacing:-0.02em;margin-bottom:0.25rem;">
        📋 Aufgaben & Taskboard
      </h1>
      <p style="color:var(--text-muted);font-size:0.875rem;">
        Aufgaben aus der verbundenen Task-Datenbank · persönliche und zugewiesene Aufgaben
      </p>
    </div>

    <!-- Actions -->
    <div style="display:flex;gap:0.5rem;" id="modal-new-task" class="modal-new-task">
      <TaskCreateForm id="task-create-dialog" label="Neue Aufgabe" />
      <button class="btn" onclick="loadTasks()">
        <span>🔄</span> Aktualisieren
      </button>
    </div>
  </div>

  <!-- Filter Bar -->
  <div class="card" style="padding:0.75rem 1.25rem;margin-bottom:1.5rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;">
    <div class="task-filter-controls" aria-label="Aufgaben kombinieren">
      <label for="tasks-assignment-filter">Zuordnung<select id="tasks-assignment-filter">
        <option value="all">Alle Aufgaben</option><option value="user">👤 Persönlich (User)</option>
        <option value="auto">🤖 Automatisiert / Agenten</option><option value="unassigned">Unzugewiesen</option>
      </select></label>
      <label for="tasks-status-filter">Status<select id="tasks-status-filter">
        <option value="open" selected>⏳ Offen</option><option value="done">✅ Erledigt</option><option value="all">Alle Status</option>
      </select></label>
      <label for="tasks-priority-filter">Priorität<select id="tasks-priority-filter">
        <option value="">Alle Prioritäten</option><option value="P1">P1 · Kritisch</option>
        <option value="P2">P2 · Wichtig</option><option value="P3">P3 · Normal</option><option value="P4">P4 · Niedrig</option>
      </select></label>
      <label for="tasks-agent-filter">Agent<select id="tasks-agent-filter" disabled><option value="">Alle Agenten</option></select></label>
      <label for="tasks-search">Suche<input type="search" id="tasks-search" maxlength="200" placeholder="Titel, Beschreibung oder #ID" autocomplete="off"></label>
      <button class="btn" id="tasks-reset-filters" type="button">Zurücksetzen</button>
    </div>
    <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
      <span style="color:var(--text-muted);font-size:0.85rem;" id="tasks-count-badge">Lade...</span>
      <button class="btn" id="tasks-prev-page" type="button" disabled>← Zurück</button>
      <span id="tasks-page-label" aria-live="polite">Seite 1</span>
      <button class="btn" id="tasks-next-page" type="button" disabled>Weitere →</button>
    </div>
  </div>

  <!-- Task List -->
  <div class="card task-table-scroll">
    <div id="tasks-table-container">
      <p style="text-align:center;padding:3rem;color:var(--text-muted);">Lade Aufgaben...</p>
    </div>
  </div>

  <section class="card task-detail" id="task-detail" aria-live="polite" hidden>
    <div class="task-detail-head">
      <div><span id="task-detail-id" class="muted"></span><h2 id="task-detail-title"></h2></div>
      <div class="task-detail-actions">
        <button type="button" class="btn btn-primary" id="task-detail-edit">Bearbeiten</button>
        <button type="button" class="btn" id="task-detail-close">Schließen</button>
      </div>
    </div>
    <p id="task-detail-error" role="alert" hidden></p>
    <div id="task-detail-view">
      <dl class="task-detail-grid">
        <div><dt>Status</dt><dd id="task-view-status"></dd></div>
        <div><dt>Priorität</dt><dd id="task-view-priority"></dd></div>
        <div><dt>Kategorie</dt><dd id="task-view-category"></dd></div>
        <div><dt>Zugewiesen an</dt><dd id="task-view-assigned_to"></dd></div>
        <div><dt>Erstellt von</dt><dd id="task-view-created_by"></dd></div>
        <div><dt>Zuletzt geändert von</dt><dd id="task-view-modified_by"></dd></div>
        <div><dt>Fällig am</dt><dd id="task-view-due_date"></dd></div>
        <div><dt>Abhängig von</dt><dd id="task-view-depends_on"></dd></div>
        <div><dt>Benötigtes Modell</dt><dd id="task-view-required_model"></dd></div>
        <div><dt>Agenten-Slot</dt><dd id="task-view-assigned_slot"></dd></div>
        <div><dt>Erstellt am</dt><dd id="task-view-created_at"></dd></div>
        <div><dt>Abgeschlossen am</dt><dd id="task-view-completed_at"></dd></div>
      </dl>
      <h3>Beschreibung</h3><p id="task-view-description" class="task-description"></p>
      <TaskWorkerPolicySettings />
      <section class="task-worker-result" aria-live="polite">
        <h3>Worker-Ergebnis</h3>
        <p id="task-result-status">Noch nicht geprüft.</p>
        <p id="task-result-content" class="task-description" hidden></p>
        <p id="task-result-meta" class="muted" hidden></p>
        <details>
          <summary>Persönliche Freigabe einrichten</summary>
          <p>Mit deiner Bestätigung erklärst du den Auftrag fachlich für erfüllt. Weitere erforderliche Prüfungen bleiben verbindlich. Der Schlüssel gilt in diesem Browser bis zum Schließen des Tabs.</p>
          <label>Freigabeschlüssel<input id="task-result-operator-key" type="password" autocomplete="off" /></label>
          <button type="button" class="btn" id="task-result-save-key">Freigabe merken</button>
          <button type="button" class="btn" id="task-result-forget-key">Freigabe vergessen</button>
          <p id="task-result-key-status" class="muted"></p>
        </details>
        <button type="button" class="btn btn-primary" id="task-result-accept" hidden disabled>Geprüftes Ergebnis abnehmen</button>
        <form id="task-result-correction" class="task-result-correction" hidden>
          <h4>Korrektur anfordern</h4>
          <p>Die Korrektur bezieht sich auf das unten dokumentierte Originalergebnis.</p>
          <label for="task-result-correction-note">Hinweis für den nächsten Versuch</label>
          <textarea id="task-result-correction-note" rows="4" required></textarea>
          <p id="task-result-correction-count" class="muted">0 von 1200 Zeichen</p>
          <button type="submit" class="btn">Korrektur anfordern</button>
        </form>
        <section class="task-result-history" aria-labelledby="task-result-history-heading">
          <h4 id="task-result-history-heading">Ergebnisverlauf</h4>
          <p id="task-result-history-status" class="muted" aria-live="polite">Verlauf noch nicht geladen.</p>
          <ol id="task-result-history-events"></ol>
          <button type="button" class="btn" id="task-result-history-more" hidden>Ältere Einträge laden</button>
        </section>
      </section>
    </div>
    <form id="task-edit-form" hidden>
      <div class="task-edit-grid">
        <label class="task-edit-wide">Titel<input name="title" required /></label>
        <label>Priorität<select name="priority"><option value="P1">P1 · Kritisch</option><option value="P2">P2 · Wichtig</option><option value="P3">P3 · Normal</option><option value="P4">P4 · Niedrig</option></select></label>
        <label>Status<select name="status"><option value="pending">Offen</option><option value="completed">Erledigt</option></select></label>
        <label>Kategorie<input name="project" /></label>
        <label>Zugewiesen an<select name="assigned_to"></select></label>
        <label>Erstellt von<input name="created_by" readonly /></label>
        <label>Abhängig von Task-IDs<input name="depends_on" inputmode="numeric" pattern="\s*\d+(\s*,\s*\d+)*\s*" /></label>
        <label>Fällig am<input name="due_date" type="date" /></label>
        <label>Benötigtes Modell<input name="required_model" /></label>
        <label class="task-edit-wide" data-task-result-max-chars-field hidden>Maximale Länge des Worker-Ergebnisses
          <input name="result_max_chars" type="number" min="1" max="3000" step="1" inputmode="numeric" />
          <small>Leer lassen, um ein vorhandenes Limit zu entfernen.</small>
        </label>
        <label>Agent oder Blueprint-Instanz<select name="assignment_target" data-task-target><option value="">Manuell zuweisen · ohne Agenten-Slot</option></select></label>
        <div class="task-edit-wide"><p data-task-target-status aria-live="polite">Agentenauswahl noch nicht geladen.</p><button type="button" class="btn" data-task-target-reload>Agentenauswahl neu laden</button> <a href="/agenten/blueprints">Blueprints bearbeiten</a></div>
        <label class="task-edit-wide">Beschreibung<textarea name="description" rows="5"></textarea></label>
      </div>
      <div class="task-detail-actions"><button type="button" class="btn" id="task-edit-cancel">Abbrechen</button><button type="submit" class="btn btn-primary">Änderungen speichern</button></div>
    </form>
  </section>

  <style>
    .hidden, [hidden] { display: none !important; }
    .task-filter-controls {display:flex;align-items:end;gap:.65rem;flex-wrap:wrap;min-width:0}
    .task-filter-controls label {display:flex;flex-direction:column;gap:.35rem;color:var(--text-muted);font-size:.8rem;min-width:0}
    .task-filter-controls input[type=search] {background:var(--bg-card);color:var(--text);border:1px solid var(--border);border-radius:var(--radius-sm);padding:.6rem;max-width:100%;font:inherit;min-width:12rem}
    .task-filter-controls select {background:var(--bg-card);color:var(--text);border:1px solid var(--border);border-radius:var(--radius-sm);padding:.6rem;max-width:100%;font:inherit}
    @media(max-width:620px) {.task-filter-controls {width:100%}.task-filter-controls label {flex:1 1 150px}}
    .task-detail { margin-top:1.25rem; padding:1.25rem; }
    .task-table-scroll { overflow-x:auto; }
    .task-detail-head,.task-detail-actions { display:flex; justify-content:space-between; align-items:flex-start; gap:.7rem; flex-wrap:wrap; }
    .task-detail-head h2 { margin:.2rem 0 1rem; overflow-wrap:anywhere; }
    .task-detail-grid,.task-edit-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.75rem 1.25rem; }
    .task-detail-grid>div { min-width:0; border-top:1px solid var(--border); padding:.45rem 0; }
    .task-detail-grid dt,.muted { color:var(--text-muted); font-size:.8rem; }
    .task-detail-grid dd { margin:.25rem 0 0; overflow-wrap:anywhere; }
    .task-description { white-space:pre-wrap; overflow-wrap:anywhere; }
    .task-worker-result {border-top:1px solid var(--border);margin-top:1rem;padding-top:.5rem;}
    .task-worker-result details {margin:.8rem 0;}
    .task-worker-result label {display:flex;flex-direction:column;gap:.35rem;}
    .task-worker-result input {color:var(--text);background:var(--bg-card);border:1px solid var(--border);padding:.6rem;margin-bottom:.6rem;max-width:100%;box-sizing:border-box;}
    .task-result-correction {margin-top:1rem;padding-top:.7rem;border-top:1px solid var(--border);}
    .task-result-correction textarea {display:block;width:100%;box-sizing:border-box;resize:vertical;color:var(--text);background:var(--bg-card);border:1px solid var(--border);padding:.6rem;font:inherit;}
    .task-result-history {margin-top:1rem;padding-top:.7rem;border-top:1px solid var(--border);}
    .task-result-history ol {padding-left:1.5rem;}
    .task-result-history li {margin:.65rem 0;padding-left:.2rem;overflow-wrap:anywhere;}
    .task-result-history li p {white-space:pre-wrap;}
    .task-result-history details {margin:.4rem 0;}
    .task-edit-grid label { min-width:0; display:flex; flex-direction:column; gap:.35rem; }
    .task-edit-grid input,.task-edit-grid select,.task-edit-grid textarea { min-width:0; width:100%; box-sizing:border-box; padding:.6rem; background:var(--bg-dark); color:var(--text); border:1px solid var(--border); border-radius:var(--radius-sm); font:inherit; }
    .task-edit-wide { grid-column:1/-1; }
    #task-detail-error { color:var(--error-text); overflow-wrap:anywhere; }
    @media (max-width:620px) { .task-detail-grid,.task-edit-grid { grid-template-columns:minmax(0,1fr); } .task-edit-wide { grid-column:auto; } }
  </style>

  <script>
    import {createAssignmentController, taskResponseError, assignmentCatalogue} from '../lib/task-assignment.mjs';
    import {readTaskFilters, taskFilterQuery, writeTaskFilters, readTaskPage, taskCountLabel} from '../lib/task-filters.mjs';
    import {correctionAttemptMatchesView, createCorrectionAttempt, generateCorrectionRequestId,
      buildResultAcceptanceRequest, canConfirmTaskResult, resultAcceptanceConfirmed, taskResultCompletionMessage,
      isCurrentCorrectionTarget, normalizeCorrectionNote, parseTaskResultMaxCharsInput,
      resultMaxCharsEditChange,
      resultOperatorCapabilities, supportsTaskResultMaxChars, taskResultMaxCharsReadback,
      transitionCorrectionAttempt, validateResultHistoryPage} from '../lib/task-result-contract.mjs';
    let allTasks = [];
    let currentFilters = readTaskFilters(location.search);
    let filteredTotal = null;
    let taskLoadGeneration = 0;
    let currentOffset = 0;
    let hasMoreTasks = false;
    let selectedTask = null;
    const pageSize = 100;
    const editAssignment = createAssignmentController(document.getElementById('task-edit-form'));
    async function loadTaskResultMaxCharsCapabilities() {
      try {
        const response = await fetch('/api/task-capabilities', {redirect:'error'});
        if (!response.ok) return null;
        const capabilities = await response.json();
        return supportsTaskResultMaxChars(capabilities) ? capabilities : null;
      } catch (_) { return null; }
    }

    async function loadTasks() {
      const generation = ++taskLoadGeneration;
      const container = document.getElementById('tasks-table-container');
      const filters = {...currentFilters};
      try {
        const query = taskFilterQuery(filters, currentOffset, pageSize);
        const res = await fetch('/api/tasks?' + query);
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        if (generation !== taskLoadGeneration) return;
        const page = readTaskPage(data, filters);
        if (page.searchUnsupported) throw new Error('Suche vom Backend nicht unterstützt');
        allTasks = page.tasks;
        filteredTotal = page.total;
        hasMoreTasks = page.hasMore;
        renderTasks();
      } catch (error) {
        if (generation !== taskLoadGeneration) return;
        allTasks = [];
        filteredTotal = null;
        container.textContent = 'Tasks konnten nicht geladen werden: ' + error.message;
        document.getElementById('tasks-count-badge').textContent = 'Quelle nicht verfügbar';
        hasMoreTasks = false;
        updateTaskPagination();
      }
    }

    function updateTaskPagination() {
      document.getElementById('tasks-prev-page').disabled = currentOffset === 0;
      document.getElementById('tasks-next-page').disabled = !hasMoreTasks;
      document.getElementById('tasks-page-label').textContent = `Seite ${Math.floor(currentOffset / pageSize) + 1}`;
    }

    function renderTasks() {
      const container = document.getElementById('tasks-table-container');
      let filtered = allTasks;

      const normalizedStatus = status => String(status || '').trim().toLowerCase();
      const isDoneStatus = status => ['done', 'completed', 'closed'].includes(normalizedStatus(status));
      const isTerminalStatus = status => ['done', 'completed', 'closed', 'cancelled', 'canceled', 'duplicate'].includes(normalizedStatus(status));
      document.getElementById('tasks-count-badge').textContent = taskCountLabel(filtered.length, filteredTotal, currentOffset);
      updateTaskPagination();

      if (filtered.length === 0) {
        container.innerHTML = '<p style="text-align:center;padding:3rem;color:var(--text-muted);">Keine Tasks für diesen Filter gefunden.</p>';
        return;
      }

      container.innerHTML = `
        <table style="width:100%;border-collapse:collapse;font-size:0.875rem;">
          <thead>
            <tr style="border-bottom:1px solid var(--border);color:var(--text-muted);text-align:left;">
              <th style="padding:0.75rem 0.5rem;width:70px;">ID</th>
              <th style="padding:0.75rem 0.5rem;">Aufgabe</th>
              <th style="padding:0.75rem 0.5rem;width:140px;">Zuständig</th>
              <th style="padding:0.75rem 0.5rem;width:100px;">Prio</th>
              <th style="padding:0.75rem 0.5rem;width:100px;">Status</th>
              <th style="padding:0.75rem 0.5rem;width:120px;text-align:right;">Aktion</th>
            </tr>
          </thead>
          <tbody>
            ${filtered.map(t => {
              const isDone = isDoneStatus(t.status);
              const isTerminal = isTerminalStatus(t.status);
              const prioColor = (t.priority === 'P1' || t.priority === 'hoch' || t.priority === 'kritisch') ? 'var(--error)' : 'var(--text-muted)';
              const rawAssignee = t.assigned_to || t.assignee || 'Unzugewiesen';
              const isUser = rawAssignee.toLowerCase() === 'user';
              const badgeClass = isUser ? 'badge-accent' : 'badge-success';

              return `
                <tr style="border-bottom:1px solid rgba(255,255,255,0.03);opacity:${isDone ? '0.55' : '1'};">
                  <td style="padding:0.75rem 0.5rem;font-family:monospace;color:var(--text-muted);">#${escapeHtml(t.id)}</td>
                  <td style="padding:0.75rem 0.5rem;">
                    <div style="font-weight:600;color:var(--text);${isDone ? 'text-decoration:line-through;' : ''}">${escapeHtml(t.title || t.name || 'Unbenannt')}</div>
                    ${t.description ? `<div style="font-size:0.75rem;color:var(--text-muted);margin-top:0.2rem;">${escapeHtml(t.description.slice(0, 100))}</div>` : ''}
                  </td>
                  <td style="padding:0.75rem 0.5rem;">
                    <span class="badge ${badgeClass}">${escapeHtml(rawAssignee)}</span>
                  </td>
                  <td style="padding:0.75rem 0.5rem;color:${prioColor};font-weight:600;">
                    ${escapeHtml(t.priority || 'normal')}
                  </td>
                  <td style="padding:0.75rem 0.5rem;">
                    <span class="badge ${isDone ? 'badge-success' : 'badge-warning'}">${escapeHtml(t.status || 'open')}</span>
                  </td>
                  <td style="padding:0.75rem 0.5rem;text-align:right;">
                    <button class="btn" style="padding:0.25rem 0.5rem;font-size:0.75rem;" onclick="openTask(${Number(t.id)})">Öffnen</button>
                    ${normalizedStatus(t.status) === 'review' ? `<button class="btn" onclick="openTask(${Number(t.id)})">Ergebnis prüfen</button>` : !isTerminal ? `
                      <button class="btn" style="padding:0.25rem 0.5rem;font-size:0.75rem;" onclick="completeTask(${Number(t.id)})">
                        ✓ Erledigt
                      </button>
                    ` : (isDone ? '<span style="color:var(--success-text);font-size:0.8rem;">✓ Erledigt</span>' : '<span style="color:var(--text-muted);font-size:0.8rem;">Beendet</span>')}
                  </td>
                </tr>
              `;
            }).join('')}
          </tbody>
        </table>
      `;
    }

    function syncTaskFilterControls() {
      document.getElementById('tasks-assignment-filter').value = currentFilters.assignment;
      document.getElementById('tasks-status-filter').value = currentFilters.status;
      document.getElementById('tasks-priority-filter').value = currentFilters.priority;
      document.getElementById('tasks-search').value = currentFilters.q;
      const agent = document.getElementById('tasks-agent-filter');
      if (currentFilters.agent && ![...agent.options].some(o => o.value === currentFilters.agent)) agent.add(new Option(currentFilters.agent, currentFilters.agent));
      agent.value = currentFilters.agent;
    }
    // Agentenliste kommt ausschliesslich aus /api/task-assignees (Filter ueber assigned_to).
    async function loadAgentOptions() {
      const select = document.getElementById('tasks-agent-filter');
      try {
        const response = await fetch('/api/task-assignees');
        if (!response.ok) throw new Error('HTTP ' + response.status);
        const seen = new Set([...select.options].map(o => o.value));
        for (const target of assignmentCatalogue(await response.json()).targets) {
          const id = target.binding.assigned_to;
          if (id && !seen.has(id)) { seen.add(id); select.add(new Option(target.name + ' (' + id + ')', id)); }
        }
        select.disabled = false;
        select.value = currentFilters.agent;
      } catch (error) {
        select.options[0].textContent = 'Agentenliste nicht verfügbar';
      }
    }
    function applyFilterChange() {
      currentOffset = 0;
      history.replaceState(null, '', writeTaskFilters(location.href, currentFilters));
      loadTasks();
    }
    document.getElementById('tasks-agent-filter').addEventListener('change', event => {
      currentFilters = {...currentFilters, agent:event.target.value};
      applyFilterChange();
    });
    let searchTimer = null;
    document.getElementById('tasks-search').addEventListener('input', event => {
      clearTimeout(searchTimer);
      const value = event.target.value.trim().slice(0, 200);
      searchTimer = setTimeout(() => { if (value !== currentFilters.q) { currentFilters = {...currentFilters, q:value}; applyFilterChange(); } }, 300);
    });
    for (const [id, key] of [['tasks-assignment-filter','assignment'], ['tasks-status-filter','status'], ['tasks-priority-filter','priority']]) {
      document.getElementById(id).addEventListener('change', event => {
        currentFilters = {...currentFilters, [key]:event.target.value};
        currentOffset = 0;
        history.replaceState(null, '', writeTaskFilters(location.href, currentFilters));
        loadTasks();
      });
    }
    document.getElementById('tasks-reset-filters').addEventListener('click', () => {
      currentFilters = {assignment:'all',status:'open',priority:'',q:'',agent:''};
      currentOffset = 0;
      syncTaskFilterControls();
      history.replaceState(null, '', writeTaskFilters(location.href, currentFilters));
      loadTasks();
    });
    document.getElementById('tasks-prev-page').addEventListener('click', () => {
      if (currentOffset === 0) return;
      currentOffset = Math.max(0, currentOffset - pageSize);
      loadTasks();
    });
    document.getElementById('tasks-next-page').addEventListener('click', () => {
      if (!hasMoreTasks) return;
      currentOffset += pageSize;
      loadTasks();
    });

    function detailError(message) {
      const node = document.getElementById('task-detail-error');
      node.textContent = message || '';
      node.hidden = !message;
    }

    let taskDetailRevision = 0;
    let selectedResult = null;
    let taskResultReadback = null;
    let taskResultCapabilities = {valid:false, accept_result:false, request_correction:false};
    let taskResultMaxCharsCapabilities = null;
    let taskResultHistoryEvents = [];
    let taskResultHistoryCursor = null;
    let taskResultHistoryHasMore = false;
    let taskResultHistoryLoading = false;
    let taskResultHistoryGeneration = 0;
    let correctionRequiresRefresh = false;
    let correctionPostInFlight = false;
    let correctionPostRequestId = null;
    let correctionGateTaskId = null;
    let taskResultReadGeneration = 0;
    let taskResultStatusMessage = '';
    const taskResultHistoryPageSize = 20;
    const resultOperatorStorage = 'bach_task_result_operator';
    function operatorKey() {
      try { return sessionStorage.getItem(resultOperatorStorage) || ''; } catch (_) { return ''; }
    }
    function resultKeyStatus() {
      document.getElementById('task-result-key-status').textContent = operatorKey()
        ? 'Persönliche Freigabe für diesen Tab hinterlegt.' : 'Keine persönliche Freigabe hinterlegt.';
    }
    function correctionGateActive(taskId) {
      return correctionGateTaskId === taskId && correctionRequiresRefresh;
    }
    function isCurrentTaskResultRead(requestGeneration, id, revision, key) {
      return requestGeneration === taskResultReadGeneration
        && revision === taskDetailRevision
        && selectedTask?.id === id
        && operatorKey() === key;
    }
    function renderTaskResultCorrectionAvailability({resetNote = false} = {}) {
      const correction = document.getElementById('task-result-correction');
      const submit = correction.querySelector('button[type="submit"]');
      const task = selectedTask;
      const readback = taskResultReadback;
      const status = document.getElementById('task-result-status');
      const eligible = Boolean(task && readback && task.id === readback.task_id
        && taskResultCapabilities.valid && taskResultCapabilities.request_correction === true
        && isCurrentCorrectionTarget(readback, task.id));
      if (!eligible) {
