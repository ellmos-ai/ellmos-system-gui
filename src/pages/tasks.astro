    function renderTaskResultHistoryEvent(event) {
      const item = document.createElement('li');
      const heading = document.createElement('strong');
      const time = document.createElement('time');
      time.dateTime = event.occurred_at;
      time.textContent = new Date(event.occurred_at).toLocaleString();
      if (event.type === 'result_submitted') {
        heading.textContent = `Ergebnis #${event.result.result_id} abgegeben`;
        item.append(heading, document.createTextNode(' · '), time);
        const meta = document.createElement('p');
        meta.className = 'muted';
        meta.textContent = `SHA-256 ${event.result.result_sha256} · Generation ${event.result.generation} · Fence ${event.result.fence}`;
        const details = document.createElement('details');
        const summary = document.createElement('summary'); summary.textContent = 'Originalergebnis anzeigen';
        const content = document.createElement('p'); content.className = 'task-description'; content.textContent = event.result.text;
        details.append(summary, content); item.append(meta, details);
      } else if (event.type === 'result_accepted') {
        heading.textContent = `Ergebnis #${event.result.result_id} abgenommen`;
        item.append(heading, document.createTextNode(' · '), time);
        const meta = document.createElement('p'); meta.className = 'muted'; meta.textContent = `SHA-256 ${event.result.result_sha256}`;
        item.append(meta);
