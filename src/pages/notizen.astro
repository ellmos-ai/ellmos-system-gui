---
import BachLayout from '../layouts/BachLayout.astro';
const routePath = '/notizen';
---
<BachLayout title="Notizen · Gedanken & Logbuch" currentPath={routePath}>
  <div class="page-head" style="margin-bottom:1.25rem;display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;flex-wrap:wrap;">
    <div>
      <p class="eyebrow" style="margin:0 0 0.25rem;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.08em;color:var(--accent-text);">Notizen · Gedanken · Logbuch (#2455, #2480)</p>
      <h1 style="margin:0 0 0.35rem 0;font-size:1.65rem;">📝 Notizen (Gedanken &amp; Logbuch)</h1>
      <p style="margin:0;opacity:0.85;font-size:0.9rem;">
        Schnelle Gedankenablage (vormals Denkarium) und chronologisches Arbeits- &amp; Tageslogbuch, gespeichert in der Notiz-Engine llm-note.
      </p>
    </div>
    <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
      <a href="/memory" class="btn btn-secondary btn-sm">💾 Langzeitgedächtnis (bach.db)</a>
      <a href="/life" class="btn btn-secondary btn-sm">🌱 Life-Zentrale</a>
    </div>
  </div>

  <!-- Filter-Balken: Alle / Gedanken / Logbuch + Suche -->
  <section class="card" style="padding:1rem 1.25rem;margin-bottom:1.25rem;border:1px solid var(--border);background:var(--bg-card);border-radius:var(--radius-md);display:flex;justify-content:space-between;align-items:center;gap:0.75rem;flex-wrap:wrap;">
    <div style="display:flex;gap:0.45rem;flex-wrap:wrap;" role="tablist" aria-label="Notizen-Filter">
      <button type="button" class="btn btn-primary btn-sm note-filter-btn" data-note-kind="all">📚 Alle Notizen</button>
      <button type="button" class="btn btn-secondary btn-sm note-filter-btn" data-note-kind="gedanken">💭 Gedanken (Impulse &amp; Ideen)</button>
      <button type="button" class="btn btn-secondary btn-sm note-filter-btn" data-note-kind="logbuch">📓 Logbuch (Chronik &amp; Entscheidungen)</button>
    </div>
    <div style="display:flex;gap:0.5rem;align-items:center;flex:1;min-width:220px;max-width:380px;">
      <input id="notes-search-input" type="search" placeholder="Notizen nach Stichwort filtern …" style="width:100%;padding:0.45rem 0.7rem;border-radius:8px;border:1px solid var(--border);background:var(--bg-panel);color:var(--text);font-size:0.85rem;" />
    </div>
    <label style="display:flex;gap:0.4rem;align-items:center;font-size:0.8rem;color:var(--text-muted);">
      <input id="notes-archive-toggle" type="checkbox" /> Archiv einblenden
    </label>
  </section>

  <p id="notes-status" role="status" hidden style="margin:0 0 1rem 0;padding:0.6rem 0.9rem;border:1px solid var(--border);border-radius:8px;font-size:0.85rem;"></p>

  <!-- Neue Notiz anlegen + Notizen-Liste -->
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:1.25rem;align-items:start;">
    <section class="card" style="padding:1.25rem;border:1px solid var(--border);background:var(--bg-card);border-radius:var(--radius-md);">
      <h2 style="margin:0 0 0.75rem 0;font-size:1.05rem;">➕ Neue Notiz erfassen</h2>
      <form id="note-create-form" style="display:grid;gap:0.75rem;">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.65rem;">
          <label style="font-size:0.8rem;color:var(--text-muted);display:grid;gap:0.25rem;">
            Bereich
            <select id="note-kind-select" style="padding:0.45rem;border-radius:6px;border:1px solid var(--border);background:var(--bg-panel);color:var(--text);">
              <option value="gedanken">💭 Gedanken (Impuls / Idee)</option>
              <option value="logbuch">📓 Logbuch (Eintrag / Chronik)</option>
            </select>
          </label>
          <label style="font-size:0.8rem;color:var(--text-muted);display:grid;gap:0.25rem;">
            Stichwort / Tag
            <input id="note-tag-input" type="text" placeholder="z. B. Fokus, Architektur, Alltag" style="padding:0.45rem;border-radius:6px;border:1px solid var(--border);background:var(--bg-panel);color:var(--text);" />
          </label>
        </div>
        <label style="font-size:0.8rem;color:var(--text-muted);display:grid;gap:0.25rem;">
          Titel
          <input id="note-title-input" type="text" required placeholder="Kurzer Titel des Gedankens oder Logbucheintrags …" style="padding:0.45rem;border-radius:6px;border:1px solid var(--border);background:var(--bg-panel);color:var(--text);" />
        </label>
        <label style="font-size:0.8rem;color:var(--text-muted);display:grid;gap:0.25rem;">
          Inhalt
          <textarea id="note-body-input" rows="4" required placeholder="Spontanen Gedanken, Notiz oder Tagesprotokoll festhalten …" style="padding:0.5rem;border-radius:6px;border:1px solid var(--border);background:var(--bg-panel);color:var(--text);"></textarea>
        </label>
        <div style="display:flex;justify-content:space-between;align-items:center;gap:0.5rem;">
          <button type="submit" class="btn btn-primary btn-sm">💾 Notiz sichern</button>
          <span id="note-save-status" style="font-size:0.8rem;color:var(--text-muted);">Wird in der Notiz-Engine llm-note gespeichert</span>
        </div>
      </form>
    </section>

    <section class="card" style="padding:1.25rem;border:1px solid var(--border);background:var(--bg-card);border-radius:var(--radius-md);">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem;">
        <h2 style="margin:0;font-size:1.05rem;">📋 Gespeicherte Notizen</h2>
        <span class="badge" id="notes-count-badge">0 Einträge</span>
      </div>
      <div id="notes-list-container" style="display:grid;gap:0.65rem;"></div>
    </section>
  </div>

  <script>import '../scripts/notizen-page.mjs';</script>
</BachLayout>
